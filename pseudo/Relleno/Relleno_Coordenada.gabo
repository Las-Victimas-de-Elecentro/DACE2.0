Procedimiento Relleno_Coordenada(E/S: Tarjeta[I].ID, Tarjeta_A[I].ID, Tarjeta_P[I].ID: Entero);
Inicio
    Var I, K, J: Entero;
    Para (I = 1 Hasta I = 5000) Hacer;
        Para (J = 1 Hasta J = 5) Hacer;
            K = (I - 1) * 5 + J;
            Tarjeta[K].ID = I;
            Tarjeta_A[K].ID = I;
            Tarjeta_P[K].ID = I;
        Fin_Para
    Fin_Para
Fin_Procedimiento