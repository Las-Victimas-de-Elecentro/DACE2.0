Procedimiento Inicializar_Bloques_Base(E/S: Bloque[I].Hora_Inicio, Bloque[I].Hora_Fin, Bloque[I].Dia, Bloque[I].Aula, Bloque[I].Codigo_Materia, Bloque[I].Estado: Cadena, Bloque[I].ID_Bloque: Entero);
Inicio
    Base.Cant = 48;
    // Carga de catálogo (ejemplo: 8 bloques por día de Lunes a Sábado)
    Var dias[6]: Cadena;
    Var dias[1] = "Lunes"; dias[2] = "Martes"; dias[3] = "Miércoles";
    Var dias[4] = "Jueves"; dias[5] = "Viernes"; dias[6] = "Sábado";
    Var idx: Entero, d: Entero, b: Entero, global_id: Entero;
    global_id = 0;
    Para (d = 1 Hasta d = 6) Hacer;
        Para (b = 1 Hasta b = 8) Hacer;
            global_id = global_id + 1;
            Bloque[global_id].ID_Bloque = global_id;
            Bloque[global_id].Dia = dias[d];
            En_Caso (b > 0) Sea;
                Caso(b = 1);
                    Bloque[global_id].Hora_Inicio = "07:00"; 
                    Bloque[global_id].Hora_Fin = "08:30";
                Caso(b = 2);
                    Bloque[global_id].Hora_Inicio = "08:30";
                    Bloque[global_id].Hora_Fin = "10:00";
                Caso(b = 3);
                    Bloque[global_id].Hora_Inicio = "10:00";
                    Bloque[global_id].Hora_Fin = "11:30";
                Caso(b = 4);
                    Bloque[global_id].Hora_Inicio = "11:30";
                    Bloque[global_id].Hora_Fin = "13:00";
                Caso(b = 5);
                    Bloque[global_id].Hora_Inicio = "13:00";
                    Bloque[global_id].Hora_Fin = "14:30";
                Caso(b = 6);
                    Bloque[global_id].Hora_Inicio = "14:30";
                    Bloque[global_id].Hora_Fin = "16:00";
                Caso(b = 7);
                    Bloque[global_id].Hora_Inicio = "16:00";
                    Bloque[global_id].Hora_Fin = "17:30";
                Otro_Caso
                    Bloque[global_id].Hora_Inicio = "17:30";
                    Bloque[global_id].Hora_Fin = "19:00";
            Fin_Caso
            Bloque[global_id].Aula = "Por asignar";
            Bloque[global_id].Estado = "Libre";
        Fin_Para
    Fin_Para
Fin_Procedimiento