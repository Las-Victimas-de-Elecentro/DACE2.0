    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Minera > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 2;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Ambiente > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 2;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    //Séptimo Semestre
    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_III > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 4;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Econometria > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 5;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Teoria_Politica_Monetaria > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 5;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Planificacion > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 5;
        Materias_Aprobadas = Materias_Aprobadas + 1;
        Datos[pos_usuario].Pasantias = 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Internacional > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 5s;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    //Electiva II
    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Formulacion_Evaluacion_Agricola > 5.5) Entonces;
        Materias_Aprobadas = Materias_Aprobadas + 1;
        UC_Aprobadas = UC_Aprobadas + 2;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Gestion_Comunitaria > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 2;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_Costos > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 2;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Presupuesto > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 2;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    //Octavo Semestre
    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Trabajo_Final_Grado > 5.5) Entonces;
        MUC_Aprobadas = UC_Aprobadas + 7;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    //Electiva III
    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Finanzas_Internacionales > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 2;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Estructura_Economica_Mundial > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 2;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Gestion_Riesgo > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 2;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Crisis > 5.5) Entonces;
        UC_Aprobadas = UC_Aprobadas + 2;
        Materias_Aprobadas = Materias_Aprobadas + 1;
    Fin_Si

    Datos[pos_usuario].UC_Aprobadas = UC_Aprobadas;
    Datos[pos_usuario].Materias_Aprobadas = Materias_Aprobadas;
Fin_Procedimiento