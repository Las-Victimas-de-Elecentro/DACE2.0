Procedimiento Validar_Coordenada(E/S: I, J: Entero, Acceso: Booleano);
Inicio
	Var Coordenada, Fila, Columna: Entero;
	Minimo = 1;
	Maximo = 5;
	Fila = Aleatorio(Minimo, Maximo);
	Maximo = 10;
	Columna = Aleatorio(Minimo, Maximo);
    Mostrar << "Introduzca la coordenada ubicada en la fila: ", Fila, " y columna: ", Columna, " de su tarjeta de coordenadas.";
	Leer >> Coordenada;
	Si (Coordenada = Tarjeta[Fila, Columna]) Entonces;
		Mostrar << "Coordenada válida, acceso permitido";
		Acceso = 1;
	Sino
		Mostrar << "Coordenada incorrecta. Acceso denegado";
		Acceso = 0;
	Fin_Si
Fin_Procedimiento