Procedimiento Iniciar_Sesion(E/S: Datos[I].Gmail, Admin[I].Gmail, Datos[I].Usuario, Admin[I].Usuario, Datos[I].Password, Admin[I].Password: Cadena, Datos[I].CI, Admin[I].CI, I, J, Tarjeta[I, J]: Entero);
Inicio
    Var gmail_ingresado, password_ingresado: Cadena;
    Var encontrado, encontradoAdmin: Booleano;
    Var I, pos_usuario, pos_admin, Intentos_Fallidos: Entero;
    Var Acceso: Booleano;
    
    Intentos_Fallidos = 0;
    encontrado = 0;
    encontradoAdmin = 0;
    Acceso = 0;
    
    Repetir
        // Solicitar credenciales
        Mostrar << "INICIO DE SESIÓN";
        Mostrar << "Ingrese su gmail:";
        Leer >> gmail_ingresado;
        Mostrar << "Ingrese su contraseña:";
        Leer >> password_ingresado;
        
        // Buscar en arreglo de Estudiantes y docentes
        encontrado = 0;
        Para (I = 1 hasta I = Lim) Hacer;
            Si (Datos[I].Gmail = gmail_ingresado and Datos[I].Password = password_ingresado) Entonces;
                encontrado = 1;
                pos_usuario = I;
            Fin_Si
            Si (Admin[I].Gmail = gmail_ingresado and Admin[I].Password = password_ingresado) Entonces;
                encontradoAdmin = 1;
                pos_admin = I;
            Fin_Si
        Fin_Para
        
        Si (encontrado = 1) or (encontradoAdmin = 1) Entonces;
            Si (Intentos_Fallidos >= 0) Entonces;
                Validar_Coordenada(I, Acceso);
                Mostrar << Validar_Coordenada;
            Sino
                Acceso = 1;
            Fin_Si
            
            Si (Acceso = 1) and (encontrado = 1) Entonces;
                Mostrar << "¡Bienvenido ", Datos.Nombre[pos_usuario], "!";
                Mostrar << "Cédula: ", Datos.CI[pos_usuario];
                Intentos_Fallidos = 0;
                Rol = "Estudiante";
            Fin_Si
            Si (Acceso = 1) and (encontradoAdmin = 1) Entonces;
                Mostrar << "¡Bienvenido ", Admin.Nombre[pos_admin], "!";
                Mostrar << "Cédula: ", Admin.CI[pos_admin];
                Intentos_Fallidos = 0;
                Si (pos_admin = 35 or pos_admin = 23 or pos_admin = 22) Entonces;
                    Rol = "Administrativo";
                Sino
                    Rol = "Docente";
                Fin_Si

        Sino
            Intentos_Fallidos = Intentos_Fallidos + 1;
            Mostrar << "Credenciales incorrectas. Intento: ", Intentos_Fallidos;
            
            Si (Intentos_Fallidos >= 3) Entonces;
                Mostrar << "Demasiados intentos fallidos.";
                Recuperar_Password(I, Intentos_Fallidos, Acceso);
                Mostrar << Recuperar_Password;
            Fin_Si
        Fin_Si
        
        Hasta (encontrado = 1 AND Acceso = 1) OR (Intentos_Fallidos >= 3 AND Acceso = 0);
    Fin_Repetir
    Si (Intentos_Fallidos >= 3 AND Acceso = 0) Entonces;
        Mostrar<<"No se pudo iniciar sesión. Contacte soporte.";
    Fin_Si
Fin_Procedimiento