Procedimiento Generar_Tarjeta_Coordenadas(E/S: ID, Minimo, Maximo, Tarjeta[I].ID, Tarjeta[I].Fila, Tarjeta[I].Columna, Tarjeta_A[I].ID, Tarjeta_A[I].Fila, Tarjeta_A[I].Columna, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna: Entero, encontrado, encontradoProf, encontradoAdmin: Booleano, [Funcion Aleatorio(Minimo, Maximo)]);
Inicio
	Var I, coordenada_fila, coordenada_columna: Entero;
	Minimo = 1;
	Maximo = 99;
	Si (encontrado = 1) Entonces;
		Para (I = 1 Hasta I = 400000) Hacer;
			Si (ID = Tarjeta[I].ID) Entonces;
				coordenada_fila = Aleatorio(Minimo, Maximo);
				Tarjeta[I].Fila = coordenada_fila;
				coordenada_columna = Aleatorio(Minimo, Maximo);
				Tarjeta[I].Columna = coordenada_columna;
			Fin_Si
		Fin_Para
	Fin_Si
	Si (encontradoAdmin = 1) Entonces;
		Para (I = 1 Hasta I = 25000) Hacer;
			Si (ID = Tarjeta_A[I].ID) Entonces;
				coordenada_fila = Aleatorio(Minimo, Maximo);
				Tarjeta_A[I].Fila = coordenada_fila;
				coordenada_columna = Aleatorio(Minimo, Maximo);
				Tarjeta_A[I].Columna = coordenada_columna;
			Fin_Si
		Fin_Para
	Fin_Si
	Si (encontradoProf = 1) Entonces;
		Para (I = 1 Hasta I = 25000) Hacer;
			Si (ID = Tarjeta_P[I].ID) Entonces;
				coordenada_fila = Aleatorio(Minimo, Maximo);
				Tarjeta_P[I].Fila = coordenada_fila;
				coordenada_columna = Aleatorio(Minimo, Maximo);
				Tarjeta_P[I].Columna = coordenada_columna;
			Fin_Si
		Fin_Para
	Fin_Si
Fin_Procedimiento