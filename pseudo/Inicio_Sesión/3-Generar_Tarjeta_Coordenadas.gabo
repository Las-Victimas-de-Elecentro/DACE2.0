Procedimiento Generar_Tarjeta_Coordenadas(E/S: ID, Tarjeta[I].ID, Minimo, Maximo, Tarjeta[I].Fila, Tarjeta[I].Columna: Entero);
Inicio
	Var I, coordenada_fila, coordenada_columna: Entero;
	Minimo = 1;
	Maximo = 99;
	Para (I = 1 Hasta I = 25000) Hacer;
		Si (ID = Tarjeta[I].ID) Entonces;
			coordenada_fila = Aleatorio(Minimo, Maximo);
			Tarjeta[I].Fila = coordenada_fila;
			coordenada_columna = Aleatorio(Minimo, Maximo);
			Tarjeta[I].Columna = coordenada_columna;
		Fin_Si
	Fin_Para
Fin_Procedimiento