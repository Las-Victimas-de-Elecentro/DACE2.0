Algoritmo U-nergízate

Registro: Solicitud_Empleo;
	Usuario: Cadena;
	CI: Entero;
	Gmail: Cadena;
	Password: Cadena;
	Edad: Entero;
	Experiencia: Cadena;
	Titulo: Cadena;
	Descripcion: Cadena;
	Estado: Booleano;
Fin_Registro

Registro: Administrativos;
	Usuario: Cadena;
	CI: Entero;
	Cargo: Cadena;
	Gmail: Cadena;
	Password: Cadena;
	Tarjeta: Entero;
Fin_Registro

Registro: Estudiantes;
	Nombre: Cadena;
	CI: Entero;
	Gmail: Cadena;
	Password: Cadena;
	Carrera: Cadena;
	Year;
	Tarjeta: Entero;
Fin_Registro

Registro: Tiempo;
	Semestre: Entero;
Fin_Registro
Inicio
    Var Solicitud_Empleo: Empleo[500];
    Var Administrativos: Admin[500];
    Var Estudiantes: Datos[500];
    Var Tiempo: Sem[500];
    Var Year: Yea[500];
    Var K = 1, I, Opcion, Minimo, Maximo: Entero;
    Var Rol: Cadena;
    Var R, Acceso: Booleano;
    Repetir
        Menu_Registro_Login(Opcion);
        Mostrar << Menu_Registro_Login;
        Si (Rol = "Administrativo") Entonces;
            Menu_Administrativo(I, K, Empleo[I].Usuario, Empleo.CI[I], Empleo[I].Gmail, Empleo[I].Password, Empleo[I].Edad, Empleo[I].Experiencia, Empleo[I].Titulo, Empleo[I].Descripcion, Admin[I].Usuario, Admin.CI[I], Admin[I].Gmail, Admin[I].Password, C, Datos[I].Usuario,  Datos.CI[I],  Datos[I].Password, Datos[I].Edad, Datos[I].Carrera, Datos.Yea.Semestre[I], Gestion[I].Usuario: Cadena , Gestion[I].CI, Gestion[I].Password, Gestion[I].Carrera, Gestion.Yea.Semestre);
            Mostrar << Menu_Administrativo;
        Sino
            Si (Rol = "Docente") Entonces;
                Menu_Docente();
                Mostrar << Menu_Docente;
            Sino
                Si (Rol = "Estudiante") Entonces;
                    Menu_Estudiante();
                    Mostrar << Menu_Estudiante;
                Fin_Si
            Fin_Si
        Fin_Si
        Mostrar << "¿Desea salir de la página? 1: Sí, 0: No";
        Leer >> R;
        Hasta (R = 0);
    Fin_Repetir
Fin