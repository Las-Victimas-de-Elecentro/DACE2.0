Procedimiento Registro(E/S: indice, ID, v, C, Minimo, Maximo, Tarjeta[I].ID, Tarjeta[J].Fila, Tarjeta[J].Columna, Gestion[I].CI, Gestion[I].Semestre, Gestion[I].Year, Datos[v].CI, Datos[v].Semestre, Datos[v].Year: Entero, Gestion[I].Nombre, Gestion[I].Gmail, Gestion[I].Password, Gestion[I].Carrera, Gestion[C].Telefono, Datos[v].Nombre, Datos[v].Gmail, Datos[v].Password, Datos[v].Carrera, Datos[v].Telefono, pass: Cadena, Gestion[I].Verificado: Booleano);
Inicio
    Var Nombre, Gmail, Password: Cadena;
    Var CI: Entero;
    Var R, encontrado = 0: Booleano;
    Mostrar << "Ingrese su Nombre";
    Leer >> Nombre;
    Mostrar << "Ingrese su Dirección de Correo Electrónico";
    Leer >> Gmail;
    Mostrar << "Ingrese su Cédula de identidad";
    Leer >> CI;
    Mientras (CI < 1000000 or CI > 50000000) Hacer;
        Mostrar << "Es invalido, solo positivos o que existan";
        Leer >> CI;
    Fin_Mientras
    Para (I = 1 Hasta I = C) Hacer;
        Si (CI = Gestion[I].CI) Entonces;  
            Mostrar << "Solicitud de Inscripción encontrada";
            Repetir
                Mostrar << "Ingrese una contraseña para su cuenta para continuar.";
                Leer >> Password;
                Mostrar << "Confirme la contraseña";
                Leer >> Password2;
                Mostrar << "¿Está seguro que quiere que esa sea su contraseña? 1: Sí, 0: No";
                Leer >> R;
                Hasta(R = 1);
            Fin_Repetir
            indice = v;
            pass = Password;
            Encriptacion(indice, pass);
            Datos[v].Nombre = Gestion[I].Nombre;
            Datos[v].CI = Gestion[I].CI;
            Datos[v].Gmail = Gestion[I].Gmail;
            Datos[v].Password = pass;
            Datos[v].Carrera = Gestion[I].Carrera;
            Datos[v].Year = Gestion[I].Year;
            Datos[v].Semestre = Gestion[I].Semestre;
            Datos[v].Telefono = Gestion[I].Telefono;
            ID = v;
            Gestion[I].Verificado = 1;
            v = v + 1;
            encontrado = 1;
        Fin_Si
    Fin_Para
    Si (encontrado = 0) Entonces;
        Mostrar << "No se encontró tu solicitud de inscripción en el sistema. Ve a una de las sedes para verificar que tus datos estén ingresados correctamente en la universidad o intente nuevamente ingresando bien sus datos";
    Fin_Si
    Generar_Tarjeta_Coordenadas(ID, Tarjeta[I].ID, Minimo, Maximo, Tarjeta[J].Fila, Tarjeta[J].Columna);
    Mostrar_Tarjeta_Coordenadas(ID, Tarjeta[I].ID, Tarjeta[J].Fila, Tarjeta[J].Columna);
    Mostrar << Mostrar_Tarjeta_Coordenadas;

Fin_Procedimiento