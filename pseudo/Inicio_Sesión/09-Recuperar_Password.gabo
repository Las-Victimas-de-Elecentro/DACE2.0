Procedimiento Recuperar_Password(E/S: Acceso, encontrado, encontradoAdmin, encontradoProf: Booleano, [Procedimiento Validar_Coordenada(pos_usuario, Tarjeta[I].ID, Tarjeta[I].Fila, Tarjeta[I].Columna, pos_admin, Tarjeta_A[I].ID, Tarjeta_A[I].Fila, Tarjeta_A[I].Columna, pos, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna, Minimo, Maximo, Acceso, encontrado, encontradoProf, encontradoAdmin, [Funcion Aleatorio(Minimo, Maximo)])], [Procedimiento Validar_Pregunta(Preg[I].ID, Preg_P[I].ID, Preg_A[I].ID, Minimo, Maximo, pos_usuario, pos, pos_admin, Preg[I].Pregunta, Preg_P[I].Pregunta, Preg_A[I].Pregunta, encontrado, encontradoAdmin, encontradoProf, Acceso, [Funcion Aleatorio(Minimo, Maximo)])]);
Inicio
	Var Aciertos = 0, K, Intentos_Fallidos = 0: Entero;
    Var Re: Booleano;
    Repetir
        Si (Intentos_Fallidos > 0 and Intentos_Fallidos < 3) Entonces;
            Mostrar << "¿Cómo desea recuperar su contraseña? 1: Por Tarjeta de Coordenadas, 0: Por Preguntas de Seguridad";
            Leer >> Re;
            Si (Re = 1) Entonces;
                Mostrar << "Por seguridad, para poder recuperar su contraseña debe ingresar 2 coordenadas correctamente.";
                Para (K = 1 hasta K = 2) Hacer;
                    Mostrar << "Validacion número: ", K;
                    Si (encontrado = 1) or (encontradoAdmin = 1) or (encontradoProf = 1) Entonces;
                        Validar_Coordenada(pos_usuario, Tarjeta[I].ID, Tarjeta[I].Fila, Tarjeta[I].Columna, pos_admin, Tarjeta_A[I].ID, Tarjeta_A[I].Fila, Tarjeta_A[I].Columna, pos, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna, Minimo, Maximo, Acceso, encontrado, encontradoProf, encontradoAdmin, [Funcion Aleatorio(Minimo, Maximo)]);
                        Mostrar << Validar_Coordenada;
                    Fin_Si
                    Si (Acceso = 1) Entonces;
                        Aciertos = Aciertos + 1;
                    Fin_Si
                Fin_Para
            Sino
                Mostrar << "Por seguridad, deberá responder las preguntas de seguridad dos veces correctamente para poder recuperar su contraseña.";
                Para (K = 1 Hasta K = 2) Hacer;
                    Si (encontrado = 1) or (encontradoAdmin = 1) or (encontradoProf = 1) Entonces;
                        Validar_Pregunta(Preg[I].ID, Preg_P[I].ID, Preg_A[I].ID, Minimo, Maximo, pos_usuario, pos, pos_admin, Preg[I].Pregunta, Preg_P[I].Pregunta, Preg_A[I].Pregunta, encontrado, encontradoAdmin, encontradoProf, Acceso, [Funcion Aleatorio(Minimo, Maximo)]);
                        Mostrar << Validar_Pregunta;
                    Fin_Si
                    Si (Acceso = 1) Entonces;
                        Aciertos = Aciertos + 1;
                    Fin_Si
                Fin_Para
            Fin_Si

            Si (Aciertos = 2) Entonces;
                Mostrar << "Verificación exitosa. Acceso permitido.";
                Mostrar << "Se le enviará su contraseña actual a su correo electrónico";
                Intentos_Fallidos = 0;
            Sino
                Intentos_Fallidos = Intentos_Fallidos + 1;
                Mostrar << "Error de validación. Las coordenadas no coinciden.";
                Mostrar << "Por favor inténtelo nuevamente.";
                Si (Intentos_Fallidos = 2) Entonces;
                    Mostrar << "Atención: solo le queda 1 intento antes de que su cuenta sea bloqueada.";
                Fin_Si
            Fin_Si
        Sino
            Mostrar << "Su cuenta ha sido temporalmente bloqueada por motivos de seguridad.";
            Mostrar << "Por favor contacte con el soporte del sistema o espere 24 horas para poder reintentar.";
            Mostrar << "Esta medida protege su información y evita accesos no autorizados.";
        Fin_Si
        Hasta(Intentos_Fallidos >= 3) or (Aciertos >= 2);
    Fin_Repetir
Fin_Procedimiento