Procedimiento Mostrar_Tarjeta_Coordenadas_Prof(E/S: ID, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna: Entero);
Inicio
	Var I: Entero;
	Mostrar<"A continuación le mostraremos su tarjeta de coordenadas:";
    Mostrar << "------------------------------------------";
    Para (I = 1 Hasta I = 25000) Hacer;
		Si (ID = Tarjeta_P[I].ID) Entonces;
			Mostrar << Tarjeta_P[I].Fila;
			Mostrar << Tarjeta_P[I].Columna;
		Fin_Si
	Fin_Para
	Mostrar << "------------------------------------------";
Fin_Procedimiento