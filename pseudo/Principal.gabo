    //Variables Maestras
    //Admin
    Var Administrativos: Admin[5000];
    Var Salud_Administrativo: Salud_Admin[5000];
    Var Materia: Materias[522];
    Var Solicitud_Inscripcion: Gestion[5000];
    Var Solicitud_Empleo: Empleo[5000];

    //Docente
    Var Docente: Prof[5000];
    Var Bloque_Horario: Lista[48];
    Var Lista: Lista[5000];
    Var Clase: Clase[5000];
    Var Lista_Magistral: Lista_M[5000];
    Var Clase_Magistral: Mag[5000];
    Var Plan_Evaluacion: Plan[5000];
    Var Asignacion: Asig[5000];
    Var Grupos: Gru[5000];
    Var Enfermedad_Docente: Salud[5000];

    //Estudiante
    Var Estudiantes: Datos[5000], Enfermedad_Estudiante: Salud[5000];
    Var Notas: Materias,
    Var Informatica: Info[5000], Civil: Civ[5000], Hidrocarburos: Hid[5000];
    Var Medicina: Med[5000], Odontologia: Odo[5000], Veterinaria: Vet[5000];
    Var Derecho: Der[5000], Comunicacion: Soc[5000];
    Var Contaduria: Con[5000], Economia: Eco[5000];
    Var Carnet: Car[5000];
    Var Pasantias: Pas[P];
    Var Servicio_Comunitario: SerC[N];
    Var Market_Place: MP[M];
    Var Comida_MP: C_MP[M];
    Var Articulos_MP: A_MP[M];
    Var Servicios_MP: S_MP[M];
    Var Publicaciones: Publi[5000];
    Var Comentarios: Com[5000];
    Var Respuestas: Res[5000];
    Var Reacciones: Rea[5000];
    
    //General
    Var Solicitudes: Soli[5000];
    Var Reportes: Rep[5000];
    Var Clubes: Club[5000];
    Var Celebraciones: Cel[5000];
    Var Carnetizacion: Carn[5000];
    Var Amigos: Amig[5000];
    Var Novedades: Nov[5000];
