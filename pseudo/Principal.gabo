    Var Tarjeta_Coordenadas_Profe: Tarjeta_P[25000];
    
    //Variables Globales
    //Iteradores
    Var I, J, club = 6, carnet = 0, Nov = 0, Re = 0, S = 0, v = 0, C = 0, Lim = 16, K = 0, w = 0, re = 0, M = 0, P = 0, L = 0, Am = 0, N = 2, Aux = 0, Ver = 0, react = 0, com = 0, eve = 0, cel = 0: Entero;
