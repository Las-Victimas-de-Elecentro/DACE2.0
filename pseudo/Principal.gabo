    //Generales
    Var Opcion, Minimo, Maximo: Entero;
    Var Rol, cod, Avatares[11]: Cadena;
    Var R, R2, Acceso: Booleano;
    Var Tema = 0, validacion_pago, Inscripciones, encontrado, encontradoProf, encontradoAdmin: Booleano;
    Var Suma, monto_pago, Ingresos, Egresos: Real;

    Relleno_Coordenada(Tarjeta[I].ID, Tarjeta_A[I].ID, Tarjeta_P[I].ID);
    Relleno_Admin(Admin[I].CI, Admin[I].Edad, Admin[I].Avatar, Admin[I].Usuario, Admin[I].Gmail, Admin[I].Password, Admin[I].Cargo);
    Relleno_Prof(Prof[I].CI, Prof[I].Edad, Prof[I].Cant_Clases, Prof[I].Cant_Materias, Prof[I].Avatar, Prof[I].Nombre, Prof[I].Gmail. Prof[I].Password, Prof[I].Materias, Prof[I].Club, Prof[I].Enfermedad, Prof[I].Esta_en_Club);
