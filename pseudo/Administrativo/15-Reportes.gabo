Procedimiento Reportes(E/S: Re: Entero, Rep[I].Titulo, Rep[I].Descripcion, Rep[I].Titular, Rep[I].Problema: Cadena, Rep[I].Recibido: Booleano);
Inicio
    Var opc, I: Entero, R: Booleano;
    Var ele, elec: Entero;
    Mostrar << "¡Bienvenido a la sección de Repcitudes!";
    Mostrar << "¿Qué desea hacer?";
    Mostrar << "1: Ver los reportes actuales";
    Mostrar << "2: Borrar reporte en específico";
    Mostrar << "3: Aprobar reporte como recibido";
    Leer >> opc;
    Mientras (opc < 1 or opc > 3) Hacer;
        Mostrar << "Elija una de las opciones disponibles.";
        Leer >> opc;
    Fin_Mientras
    En_Caso (opc > 0) Sea;
        Caso(opc = 1);
            Para (I = 1 Hasta I = Re) Hacer;
                Mostrar << Rep[I].Titulo;
                Mostrar << Rep[I].Descripcion;
                Mostrar << Rep[I].Titular;
                Mostrar << Rep[I].Problema;
                Mostrar << Rep[I].Fecha;
            Fin_Para
            Mostrar << "Esas fueron todos los reportes.";
        Caso(opc = 2);
            Para (I = 1 Hasta I = Re) Hacer;
                Mostrar << I, Rep[I].Titulo;
                Mostrar << Rep[I].Descripcion;
                Mostrar << Rep[I].Titular;
                Mostrar << Rep[I].Problema;
                Mostrar << Rep[I].Fecha;
            Fin_Para
            Mostrar << "Ingrese el número del reporte que desea borrar";
            Leer >> ele;
            Mientras (ele < 1 or ele > Re) Hacer;
                Mostrar << "Elija un reporte válido";
                Leer >> ele;
            Fin_Mientras
            Rep[ele].Titulo = Rep[Re - 1].Titulo;
            Rep[ele].Descripcion = Rep[Re - 1].Descripcion;
            Rep[ele].Titular = Rep[Re - 1].Titular;
            Rep[ele].Problema = Rep[Re - 1].Problema;
            Rep[ele].Fecha = Rep[Re - 1].Fecha;

            Rep[Re - 1].Titulo = null;
            Rep[Re - 1].Descripcion = null;
            Rep[Re - 1].Titular = null;
            Rep[Re - 1].Problema = null;
            Rep[Re - 1].Fecha = null;
            Re = Re - 1;
        Otro_Caso
            Para (I = 1 Hasta I = Re) Hacer;
                Mostrar << I, Rep[I].Titulo;
                Mostrar << Rep[I].Descripcion;
                Mostrar << Rep[I].Titular;
                Mostrar << Rep[I].Problema;
                Mostrar << Rep[I].Fecha;
            Fin_Para
            Mostrar << "Ingrese el reporte que desea aprobar como recibido";
            Leer >> elec;
            Mientras (elec < 1 or elec > S) Hacer;
                Mostrar << "Debe elegir una reporte válida";
                Leer >> elec;
            Fin_Mientras
            Rep[elec].Recibido = 1;
    Fin_Caso
Fin_Procedimiento