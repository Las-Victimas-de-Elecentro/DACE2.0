Procedimiento Eliminar_Estudiante(E/S: v, Datos[I].CI, Datos[I].Year, Datos[I].Semestre: Entero, Datos[I].Usuario, Datos[I].Gmail, Datos[I].Password: Cadena);
Inicio
	Var R: Booleano;
    Var Eliminar: Entero;
    Repetir
        Mostrar << "Bienvenido a la eliminación de información de la base de Datos";
		Mostrar << "A continuación se le mostrará la base de Datos para que pueda seleccionar la posición del estudiante que desea eliminar";
        Para (I = 1 hasta I = v) hacer;
            Mostrar << I, Datos[I].Usuario;
			Mostrar << Datos[I].CI;
			Mostrar << Datos[I].Gmail;
			Mostrar << Datos[I].Password;
			Mostrar << Datos[I].Carrera;
			Mostrar << Datos[I].Year;
			Mostrar << Datos[I].Semestre;
        Fin_Para
		Mostrar << "Ingrese la posición del estudiante que usted desea borrar de la base de Datos";
		Leer >> Eliminar;
		Mientras (Eliminar < 1 or Eliminar > v) hacer;
			Mostrar << "Posición ingresada errónea, intente nuevamente";
			Leer >> Eliminar;
		Fin_Mientras
		Para (I = 1 Hasta I = v) Hacer;
			Si (Eliminar = I) Entonces;
				Datos[I].Usuario = " " ;
				Datos[I].CI = null;
				Datos[I].Gmail = " ";
				Datos[I].Password = " ";
				Datos[I].Carrera= " ";
				Datos[I].Year = null;
				Datos[I].Semestre = null;
			Fin_Si
		Fin_Para
		Mostrar << "¿Desea eliminar algún otro estudiante?, 1: Sí, 0: No";
		Leer >> R;
		Hasta (R = 0);
	Fin_Repetir
Fin_Procedimiento