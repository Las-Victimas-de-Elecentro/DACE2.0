Procedimiento Clases_Magistrales_Admin(E/S: magis, Mag[I].ID_Clase, Mag[I].CI_Profesor, Mag[I].Cant_Estudiantes: Entero, Mag[I].Nombre_Materia, Mag[I].Codigo_Materia, Mag[I].Nombre_Profesor, Mag[I].Fecha, Mag[I].Aula: Cadena, Mag[I].Horas, Mag[I].Precio: Real, Mag[I].Autorizacion: Booleano);
Inicio
    Var R, R2: Booleano;
    Var I, ID: Entero;
    Repetir
        Mostrar << "¡Bienvenido a la sección de Clases Magistrales!";
        Mostrar << "¿Desea ver las clases magistrales o borrar alguna? 1: Ver, 0: Borrar";
        Leer >> R;
        Si (R = 1) Entonces;
            Para (I = 1 Hasta I = magis) Hacer;
                Mostrar << I, Mag[I].ID_Clase;
                Mostrar << Mag[I].Nombre_Materia;
                Mostrar << Mag[I].Codigo_Materia;
                Mostrar << Mag[I].Nombre_Profesor;
                Mostrar << Mag[I].CI_Profesor;
                Mostrar << Mag[I].Autorizacion;
            Fin_Para
            Mostrar << "Ingrese la ID de la clase magistral que desea aprobar";
            Leer >> ID;
            Mientras (ID < 1) or (Mag[ID].Autorizacion = 1) Hacer;
                Mostrar << "Es invalido, solo positivos, y no puede aprobar una clase que ya está aprobada";
                Leer >> ID;
            Fin_Mientras
            Mag[ID].Autorizacion = 1;
        Sino
            Para (I = 1 Hasta I = magis) Hacer;
                Mostrar << I;
                Mostrar << Mag[I].ID_Clase;
                Mostrar << Mag[I].Nombre_Materia;
                Mostrar << Mag[I].Codigo_Materia;
                Mostrar << Mag[I].Nombre_Profesor;
                Mostrar << Mag[I].CI_Profesor;
                Mostrar << Mag[I].Autorizacion;
            Fin_Para
            Mostrar << "Ingrese la posición de la clase magistral que desea borrar";
            Leer >> Elim;
            Mientras (Elim < 1 or Elim > magis) Hacer;
                Mostrar << "Es invalido";
                Leer >> Elim;
            Fin_Mientras
            Mag[Elim].ID_Clase = Mag[magis - 1].ID_Clase;
            Mag[Elim].Nombre_Materia = Mag[magis - 1].Nombre_Materia;
            Mag[Elim].Codigo_Materia = Mag[magis - 1].Codigo_Materia;
            Mag[Elim].Nombre_Profesor = Mag[magis - 1].Nombre_Profesor;
            Mag[Elim].CI_Profesor = Mag[magis - 1].CI_Profesor;
            Mag[Elim].Autorizacion = Mag[magis - 1].Autorizacion;
            Mag[Elim].Fecha = Mag[magis - 1].Fecha;
            Mag[Elim].Horas = Mag[magis - 1].Horas;
            Mag[Elim].Aula = Mag[magis - 1].Aula;
            Mag[Elim].Cant_Estudiantes = Mag[magis - 1].Cant_Estudiantes;
            Mag[Elim].Precio = Mag[magis - 1].Precio;


            Mag[magis - 1].ID_Clase = 0;
            Mag[magis - 1].Nombre_Materia = null;
            Mag[magis - 1].Codigo_Materia = null;
            Mag[magis - 1].Nombre_Profesor = null;
            Mag[magis - 1].CI_Profesor = 0;
            Mag[magis - 1].Autorizacion = null;
            Mag[magis - 1].Fecha = null;
            Mag[magis - 1].Horas = 0;
            Mag[magis - 1].Aula = null;
            Mag[magis - 1].Cant_Estudiantes = 0;
            Mag[magis - 1].Precio = 0;
            magis = magis - 1;
        Fin_Si
        Mostrar << "¿Desea aprobar otra Clase Magistral? 1: Sí, 0: No";
        Leer >> R2;
        Hasta(R2 = 0);
    Fin_Repetir
Fin_Procedimiento