Procedimiento Novedades(E/S: Nov: Entero, Nov[I].Hecho, Nov[I].Fecha, Nov[I].Responsables, Nov[I].Contexto, Nov[I].Lugar: Cadena);
Inicio
    Var opc: Entero, R: Booleano;
    Repetir
        Mostrar << "¡Bienvenido a la sección de Novedades!";
        Mostrar << "¿Qué desea hacer?";
        Mostrar << "1: Ver las novedades actuales";
        Mostrar << "2: Ingresar novedades de la universidad";
        Leer >> opc;
        Mientras (opc < 1 or opc > 2) Hacer;
            Mostrar << "Es invalido, solo entre el rango de 1-2";
            Leer >> opc;
        Fin_Mientras
        Si (opc = 1) Entonces;
            Para (I = 1 Hasta I = 500) Hacer;
                Mostrar << Nov[I].Hecho;            
                Mostrar << Nov[I].Fecha;            
                Mostrar << Nov[I].Responsables;
                Mostrar << Nov[I].Contexto;
                Mostrar << Nov[I].Lugar;           
            Fin_Para
            Mostrar << "Esas fueron todas las novedades.";
        Sino
            //Nov debe ser agregada al principal que es la que controla las novedades
            Nov = Nov + 1;
            Mostrar << "Ingrese de qué hecho trata esta nueva novedad:";
            Leer >> Nov[Nov].Hecho;
            Mostrar << "¿En qué fecha sucedió? (DD/MM/YYYY)";
            Leer >> Nov[Nov].Fecha;
            Mostrar << "¿Quiénes fueron los responsables?";
            Leer >> Nov[Nov].Responsables;
            Mostrar << "¿Cuál fue el contexto?";
            Leer >> Nov[Nov].Contexto;
            Mostrar << "¿Cuál fue el lugar?";
            Leer >> Nov[Nov].Lugar;
            Mostrar << "Novedad insertada correctamente.";
        Fin_Si
        Mostrar << "¿Desea ver todas las novedades o ingresar otra nuevamente? 1: Sí, 0: No";
        Leer >> R;
        Hasta(R = 0);
    Fin_Repetir
Fin_Procedimiento