Procedimiento Informacion_Personal_Admin(E/S: Admin[pos_admin].Usuario: Cadena, Admin[pos_admin].CI: Entero, Admin[pos_admin].Gmail, Admin[pos_admin].Cargo: Cadena);
Inicio
    Mostrar << "A continuación sus datos personales";
    Mostrar << "Usuario: ", Admin[pos_admin].Usuario;
    Mostrar << "Cédula de Identidad: ", Admin[pos_admin].CI;
    Mostrar << "Correo Electrónico: ", Admin[pos_admin].Gmail;
    Mostrar << "Cargo: ", Admin[pos_admin].Cargo;
Fin_Procedimiento