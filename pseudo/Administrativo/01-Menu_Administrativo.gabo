Procedimiento Menu_Administrativo([Procedimiento Informacion_Personal_Admin(pos_admin, Admin[pos_admin].CI, Admin[pos_admin].Edad, Admin[pos_admin].Usuario, Admin[pos_admin].Gmail, Admin[pos_admin].Cargo)], [Procedimiento Seguridad(pos_admin, Admin[pos_admin].Password, Admin[pos_admin].Usuario, Admin[pos_admin].Gmail, encontradoAdmin, [Procedimiento Validar_Coordenada(pos_usuario, Tarjeta[I].ID, Tarjeta[I].Fila, Tarjeta[I].Columna, pos_admin, Tarjeta_A[I].ID, Tarjeta_A[I].Fila, Tarjeta_A[I].Columna, pos, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna, Minimo, Maximo, Acceso, encontrado, encontradoProf, encontradoAdmin, [Funcion Aleatorio(Minimo, Maximo)])], [Procedimiento Encriptacion(indice, pass)])], [Procedimiento Historial_Labor_Docente(Clase[I].Nombre_Profesor, Clase[I].Codigo_Materia, Clase[I].Periodo, class, Clase[I].CI_Profesor, Clase[I].Cant_Estudiantes)], [Procedimiento Modo_Oscuro(Tema)], [Procedimiento Avatar_Admin(pos_admin, Avatares[I], Admin[pos_admin].Avatar)], [Procedimiento Salud_Admin(pos_admin, Salud_Admin[pos_admin].Enfermedad_Cronica, Cronica[I], Salud_Admin[pos_admin].Discapacidad, Discapacidad[I], Salud_Admin[pos_admin].Corazon, Corazon[I], Salud_Admin[pos_admin].Cancer, Cancer[I], Salud_Admin[pos_admin].Asma)], [Procedimiento Estadisticas(Admin[I].Usuario, Admin[I].Cargo, Admin[I].Gmail, Prof[I].Nombre, Prof[I].Gmail, Prof[I].Materias, Datos[I].Nombre, Datos[I].Gmail, Datos[I].Carrera, Admin[I].CI, Prof[I].CI, Prof[I].Cant_Materias, Prof[I].Cant_Clases, Datos[I].CI, Datos[I].Year, Datos[I].Semestre, Datos[I].Edad, Admin[I].Edad, Prof[I].Edad, v, Lim, prof)], [Procedimiento Solicitud_Empleo(K, Empleo[K].Edad, Empleo[K].CI, Empleo[K].Usuario, Empleo[K].Gmail, Empleo[K].Experiencia, Empleo[K].Titulo, Empleo[K].Descripcion, Empleo[K].Estado)], [Procedimiento Agregar_Empleados(indice, ID, Lim, prof, Admin[Lim].Edad, Empleo[I].Edad, Prof[prof].CI, Admin[Lim].CI, Empleo[I].CI, Admin[Lim].Usuario, Admin[Lim].Cargo, Admin[Lim].Gmail, Admin[Lim].Password, Prof[prof].Nombre, Prof[prof].Gmail, Prof[prof].Password, Empleo[I].Usuario, Empleo[I].Gmail, pass, encontradoAdmin, encontradoProf, [Procedimiento Encriptacion(indice, pass)], [Procedimiento Generar_Tarjeta_Coordenadas(ID, Minimo, Maximo, Tarjeta[I].ID, Tarjeta[I].Fila, Tarjeta[I].Columna, Tarjeta_A[I].ID, Tarjeta_A[I].Fila, Tarjeta_A[I].Columna, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna, encontrado, encontradoProf, encontradoAdmin, [Funcion Aleatorio(Minimo, Maximo)])], [Procedimiento Mostrar_Tarjeta_Coordenadas(ID, Tarjeta[I].ID, Tarjeta[I].Fila, Tarjeta[I].Columna, Tarjeta_A[I].ID, Tarjeta_A[I].Fila, Tarjeta_A[I].Columna, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna, encontrado, encontradoAdmin, encontradoProf)], [Procedimiento Preguntas(ID, Preg[I].ID, Preg_A[I].ID, Preg_P[I].ID, Preg[J].Pregunta, Preg[J].Respuesta, Preg_A[J].Pregunta, Preg_A[J].Respuesta, Preg_P[J].Pregunta, Preg_P[J].Respuesta, encontrado, encontradoAdmin, encontradoProf)])], [Procedimiento Eliminar_Empleado(Lim, prof, Admin[I].Edad, Prof[I].Edad, Admin[I].CI, Prof[I].CI, Prof[I].Cant_Clases, Prof[I].Cant_Materias, Admin[I].Avatar, Admin[I].Usuario, Admin[I].Cargo, Admin[I].Gmail, Admin[I].Password, Prof[I].Avatar, Prof[I].Nombre, Prof[I].Gmail, Prof[I].Password, Prof[I].Materias, Prof[I].Club, Prof[I].Enfermedad, Prof[I].Esta_en_Club)], [Procedimiento Estudiantes_Datos(C, Gestion[C].CI, Gestion[C].Edad, Gestion[C].Year, Gestion[C].Semestre, Gestion[C].Usuario, Gestion[C].Carrera, Gestion[C].Telefono)], [Procedimiento Agregar_Estudiantes(v, Datos[I].CI, Datos[I].Year, Datos[I].Semestre, Datos[I].Nombre, Datos[I].Gmail, Datos[I].Password, Datos[I].Carrera, [Procedimiento Encriptacion(indice, pass)])], [Procedimiento Eliminar_Estudiante(v, Datos[I].Edad, Datos[I].CI, Datos[I].Year, Datos[I].Semestre, Datos[I].Nombre, Datos[I].Gmail, Datos[I].Password)], [Procedimiento Solicitudes_Admin(S, Soli[I].Titulo, Soli[I].Descripcion, Soli[I].Titular, Soli[I].Destinatario, Soli[I].Estado)], [Procedimiento Reportes_Admin(Re, Rep[I].Titulo, Rep[I].Descripcion, Rep[I].Titular, Rep[I].Problema, Rep[I].Recibido)], [Procedimiento Novedades(Nov, Nov[I].Hecho, Nov[I].Fecha, Nov[I].Responsables, Nov[I].Contexto, Nov[I].Lugar)], [Procedimiento Inscripciones_Admin(Ad.Servicio_Comunitario, Inscripciones)], [Procedimiento Pasantias_Admin(Pas[I].Edad, Pas[I].Cedula, Pas[I].Semestre, Pas[I].Year, Pas[I].Estado_Solicitud, Pas[I].Nombre, Pas[I].Password, Pas[I].Carrera, Pas[I].Empresa, Pas[I].Solicitud, Pas[I].Horas)], [Procedimiento Carnetizacion_Admin(carnet, Carn[carnet].Carrera, Carn[carnet].Lugar, Carn[carnet].Fecha, Carn[carnet].Precio, Carn[carnet].Activo)], [Procedimiento Clases_Magistrales_Admin(magis, Mag[I].ID_Clase, Mag[I].CI_Profesor, Mag[I].Cant_Estudiantes, Mag[I].Nombre_Materia, Mag[I].Codigo_Materia, Mag[I].Nombre_Profesor, Mag[I].Fecha, Mag[I].Aula, Mag[I].Horas, Mag[I].Precio, Mag[I].Autorizacion)], [Procedimiento Planes_Evaluacion(plan, Plan[I].ID_Plan, Plan[I].Ponderacion, Plan[I].Nombre_Profesor, Plan[I].Codigo_Materia, Plan[I].Nombre_Materia, Plan[I].Fecha, Plan[I].Tema, Plan[I].Estrategia, Plan[I].Firmado)], [Procedimiento Adicionar_Clubes(Club[I].Nombre, Club[I].Descripcion, Club[I].Horarios_Disponibles, club, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima, Club[I].Activo)], [Procedimiento Agregar_Celebraciones(cel, Cel[I].Nombre, Cel[I].Fecha, Cel[I].Tipo, Cel[I].Descripcion)], [Procedimiento Agregar_Eventos(eve, Even[I].Nombre, Even[I].Fecha, Even[I].Tipo, Even[I].Descripcion)]);
Inicio
	Var Opcion, opc, opc2: Entero;
	Var R: Booleano;
	Repetir
		Mostrar << "Bienvenido Administrador, ¿Qué desea hacer?";
		Mostrar << "1: Ver las opciones de su perfil";
		Mostrar << "2: Ver las opciones de administrativo";
		Leer >> opc;
		Mientras (opc < 1 or opc > 2) Hacer;
			Mostrar << "Elija una opción válida";
			Leer >> opc;
		Fin_Mientras
		Si (opc = 1) Entonces;
			Mostrar << "Opciones de su perfil";
			Mostrar << "1: Información Personal";
			Mostrar << "2: Seguridad";
			Mostrar << "3: Historial Labor Docente";
			Mostrar << "4: Modo Oscuro";
			Mostrar << "5: Avatar";
			Mostrar << "6: Salud";
			Mostrar << "7: Estadísticas";
			Leer >> opc2;
			Mientras (opc2 < 1 or opc2 > 6) Hacer;
				Mostrar << "Elija una opción entre 1-6";
				Leer >> opc2;
			Fin_Mientras
			En_Caso (opc2 > 0) Sea;
				Caso(opc2 = 1);
					Informacion_Personal_Admin(pos_admin, Admin[pos_admin].CI, Admin[pos_admin].Edad, Admin[pos_admin].Usuario, Admin[pos_admin].Gmail, Admin[pos_admin].Cargo);
					Mostrar << Informacion_Personal_Admin;
				Caso(opc2 = 2);
					Seguridad(pos_admin, Admin[pos_admin].Password, Admin[pos_admin].Usuario, Admin[pos_admin].Gmail, encontradoAdmin, [Procedimiento Validar_Coordenada(pos_usuario, Tarjeta[I].ID, Tarjeta[I].Fila, Tarjeta[I].Columna, pos_admin, Tarjeta_A[I].ID, Tarjeta_A[I].Fila, Tarjeta_A[I].Columna, pos, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna, Minimo, Maximo, Acceso, encontrado, encontradoProf, encontradoAdmin, [Funcion Aleatorio(Minimo, Maximo)])], [Procedimiento Encriptacion(indice, pass)]);
					Mostrar << Seguridad;
				Caso(opc2 = 3);
					Historial_Labor_Docente(Clase[I].Nombre_Profesor, Clase[I].Codigo_Materia, Clase[I].Periodo, class, Clase[I].CI_Profesor, Clase[I].Cant_Estudiantes);
					Mostrar << Historial_Labor_Docente;
				Caso(opc2 = 4);
					Modo_Oscuro(Tema);
					Mostrar << Modo_Oscuro;
				Caso(opc2 = 5);
					Avatar_Admin(pos_admin, Avatares[I], Admin[pos_admin].Avatar);
					Mostrar << Avatar_Admin;
				Caso(opc2 = 6);
					Salud_Admin(pos_admin, Salud_Admin[pos_admin].Enfermedad_Cronica, Cronica[I], Salud_Admin[pos_admin].Discapacidad, Discapacidad[I], Salud_Admin[pos_admin].Corazon, Corazon[I], Salud_Admin[pos_admin].Cancer, Cancer[I], Salud_Admin[pos_admin].Asma);
					Mostrar << Salud;
				Otro_Caso
					Estadisticas(Admin[I].Usuario, Admin[I].Cargo, Admin[I].Gmail, Prof[I].Nombre, Prof[I].Gmail, Prof[I].Materias, Datos[I].Nombre, Datos[I].Gmail, Datos[I].Carrera, Admin[I].CI, Prof[I].CI, Prof[I].Cant_Materias, Prof[I].Cant_Clases, Datos[I].CI, Datos[I].Year, Datos[I].Semestre, Datos[I].Edad, Admin[I].Edad, Prof[I].Edad, v, Lim, prof);
					Mostrar << Estadisticas;
			Fin_Caso
			
		Sino
			Mostrar << "Opciones de administrador";
			Mostrar << "1: Ingresar solicitudes de empleo";
			Mostrar << "2: Agregar empleados";
			Mostrar << "3: Eliminar empleados";
			Mostrar << "4: Solicitud de inscripción de Estudiantes";
			Mostrar << "5: Agregar estudiantes";
			Mostrar << "6: Eliminar estudiantes";
			Mostrar << "7: Solicitudes";
			Mostrar << "8: Reportes";
			Mostrar << "9: Agregar novedades";
			Mostrar << "10: Inscripciones Admin";
			Mostrar << "11: Pasantías";
			Mostrar << "12: Clases Magistrales";
			Mostrar << "13: Planes de Evaluación";
			Mostrar << "14: Carnetización";
			Mostrar << "15: Añadir Clubes";
			Mostrar << "16: Agregar Celebraciones";
			Mostrar << "17: Agregar Eventos";
			Leer >> Opcion;
			Mientras (Opcion < 1 or Opcion > 17) Hacer;
				Mostrar << "Error en dato";
				Leer >> Opcion;
			Fin_Mientras
			En_Caso (Opcion > 0) Sea;
				Caso (Opcion = 1);
					Solicitud_Empleo(K, Empleo[K].Edad, Empleo[K].CI, Empleo[K].Usuario, Empleo[K].Gmail, Empleo[K].Experiencia, Empleo[K].Titulo, Empleo[K].Descripcion, Empleo[K].Estado);
					Mostrar << Solicitud_Empleo;
				Caso (Opcion = 2);
					Agregar_Empleados(indice, ID, Lim, prof, Admin[Lim].Edad, Empleo[I].Edad, Prof[prof].CI, Admin[Lim].CI, Empleo[I].CI, Admin[Lim].Usuario, Admin[Lim].Cargo, Admin[Lim].Gmail, Admin[Lim].Password, Prof[prof].Nombre, Prof[prof].Gmail, Prof[prof].Password, Empleo[I].Usuario, Empleo[I].Gmail, pass, encontradoAdmin, encontradoProf, [Procedimiento Encriptacion(indice, pass)], [Procedimiento Generar_Tarjeta_Coordenadas(ID, Minimo, Maximo, Tarjeta[I].ID, Tarjeta[I].Fila, Tarjeta[I].Columna, Tarjeta_A[I].ID, Tarjeta_A[I].Fila, Tarjeta_A[I].Columna, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna, encontrado, encontradoProf, encontradoAdmin, [Funcion Aleatorio(Minimo, Maximo)])], [Procedimiento Mostrar_Tarjeta_Coordenadas(ID, Tarjeta[I].ID, Tarjeta[I].Fila, Tarjeta[I].Columna, Tarjeta_A[I].ID, Tarjeta_A[I].Fila, Tarjeta_A[I].Columna, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna, encontrado, encontradoAdmin, encontradoProf)], [Procedimiento Preguntas(ID, Preg[I].ID, Preg_A[I].ID, Preg_P[I].ID, Preg[J].Pregunta, Preg[J].Respuesta, Preg_A[J].Pregunta, Preg_A[J].Respuesta, Preg_P[J].Pregunta, Preg_P[J].Respuesta, encontrado, encontradoAdmin, encontradoProf)]);
					Mostrar << Agregar_Empleados;
				Caso (Opcion = 3);
					Eliminar_Empleado(Lim, prof, Admin[I].Edad, Prof[I].Edad, Admin[I].CI, Prof[I].CI, Prof[I].Cant_Clases, Prof[I].Cant_Materias, Admin[I].Avatar, Admin[I].Usuario, Admin[I].Cargo, Admin[I].Gmail, Admin[I].Password, Prof[I].Avatar, Prof[I].Nombre, Prof[I].Gmail, Prof[I].Password, Prof[I].Materias, Prof[I].Club, Prof[I].Enfermedad, Prof[I].Esta_en_Club);
					Mostrar << Eliminar_Empleado;
				Caso (Opcion = 4);
					Estudiantes_Datos(C, Gestion[C].CI, Gestion[C].Edad, Gestion[C].Year, Gestion[C].Semestre, Gestion[C].Usuario, Gestion[C].Password, Gestion[C].Carrera, Gestion[C].Telefono);
					Mostrar << Estudiantes_Datos;
				Caso (Opcion = 5);
					Agregar_Estudiantes(v, Datos[I].CI, Datos[I].Year, Datos[I].Semestre, Datos[I].Nombre, Datos[I].Gmail, Datos[I].Password, Datos[I].Carrera, [Procedimiento Encriptacion(indice, pass)]);
					Mostrar << Agregar_Estudiantes;
				Caso (Opcion = 6);
					Eliminar_Estudiante(v, Datos[I].Edad, Datos[I].CI, Datos[I].Year, Datos[I].Semestre, Datos[I].Nombre, Datos[I].Gmail, Datos[I].Password);
					Mostrar << Eliminar_Estudiante;
				Caso(Opcion = 7);
					Solicitudes_Admin(S, Soli[I].Titulo, Soli[I].Descripcion, Soli[I].Titular, Soli[I].Destinatario, Soli[I].Estado);
					Mostrar << Solicitudes_Admin;
				Caso(Opcion = 8);
					Reportes_Admin(Re, Rep[I].Titulo, Rep[I].Descripcion, Rep[I].Titular, Rep[I].Problema, Rep[I].Recibido);
					Mostrar << Reportes_Admin;
				Caso(Opcion = 9);
					Novedades(Nov, Nov[I].Hecho, Nov[I].Fecha, Nov[I].Responsables, Nov[I].Contexto, Nov[I].Lugar);
					Mostrar << Novedades;
				Caso(Opcion = 10);
					Inscripciones_Admin(Ad.Servicio_Comunitario, Inscripciones);
					Mostrar << Inscripciones_Admin;
				Caso(Opcion = 11);
					Pasantias_Admin(Pas[I].Edad, Pas[I].Cedula, Pas[I].Semestre, Pas[I].Year, Pas[I].Estado_Solicitud, Pas[I].Nombre, Pas[I].Password, Pas[I].Carrera, Pas[I].Empresa, Pas[I].Solicitud, Pas[I].Horas);
					Mostrar << Pasantias_Admin;
				Caso(Opcion = 12);
					Carnetizacion_Admin(carnet, Carn[carnet].Carrera, Carn[carnet].Lugar, Carn[carnet].Fecha, Carn[carnet].Precio, Carn[carnet].Activo);
					Mostrar << Carnetizacion_Admin;
				Caso(Opcion = 13);
					Clases_Magistrales_Admin(magis, Mag[I].ID_Clase, Mag[I].CI_Profesor, Mag[I].Cant_Estudiantes, Mag[I].Nombre_Materia, Mag[I].Codigo_Materia, Mag[I].Nombre_Profesor, Mag[I].Fecha, Mag[I].Aula, Mag[I].Horas, Mag[I].Precio, Mag[I].Autorizacion);
					Mostrar << Clases_Magistrales_Admin;
				Caso(Opcion = 14);
					Planes_Evaluacion(plan, Plan[I].ID_Plan, Plan[I].Ponderacion, Plan[I].Nombre_Profesor, Plan[I].Codigo_Materia, Plan[I].Nombre_Materia, Plan[I].Fecha, Plan[I].Tema, Plan[I].Estrategia, Plan[I].Firmado);
					Mostrar << Planes_Evaluacion;
				Caso(Opcion = 15);
					Adicionar_Clubes(Club[I].Nombre, Club[I].Descripcion, Club[I].Horarios_Disponibles, club, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima, Club[I].Activo);
					Mostrar << Adicionar_Clubes;
				Caso(Opcion = 16);
					Agregar_Celebraciones(cel, Cel[I].Nombre, Cel[I].Fecha, Cel[I].Tipo, Cel[I].Descripcion);
				Otro_Caso
					Agregar_Eventos(eve, Even[I].Nombre, Even[I].Fecha, Even[I].Tipo, Even[I].Descripcion);
			Fin_Caso
		Fin_Si
		Mostrar << "¿Desea salir del sistema? 1: Sí, 0: No";
		Leer >> R;
		Hasta(R = 1);
	Fin_Repetir
Fin_Procedimiento