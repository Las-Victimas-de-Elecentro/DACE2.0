Procedimiento Estadisticas(E/S: Admin[I].Usuario, Admin[I].Cargo, Admin[I].Gmail, Prof[I].Nombre, Prof[I].Gmail, Prof[I].Materias, Datos[I].Nombre, Datos[I].Gmail, Datos[I].Carrera: Cadena, Admin[I].CI, Prof[I].CI, Prof[I].Cant_Materias, Prof[I].Cant_Clases, Datos[I].CI, Datos[I].Year, Datos[I].Semestre, Datos[I].Edad, Admin[I].Edad, Prof[I].Edad, v, Lim, prof: Entero);
Inicio
    Var I: Entero;
    Mostrar << "A continuación las estadísticas del sistema: ";
    Mostrar << "Administrativos: ";
    Para (I = 1 Hasta I = Lim) Hacer;
        Mostrar << "Nombre: ", Admin[I].Usuario;
        Mostrar << "Cédula: ", Admin[I].CI;
        Mostrar << "Edad: ", Admin[I].Edad;
        Mostrar << "Cargo: ", Admin[I].Cargo;
        Mostrar << "Correo Electrónico: ", Admin[I].Gmail;
    Fin_Para
    Mostrar << "Docentes:";
    Para (I = 1 Hasta I = prof) Hacer;
        Mostrar << "Nombre: ", Prof[I].Nombre;
        Mostrar << "Cédula: ", Prof[I].CI;
        Mostrar << "Edad: ", Prof[I].Edad;
        Mostrar << "Correo Electrónico: ", Prof[I].Gmail;
        Mostrar << "Materias: ", Prof[I].Materias;
        Mostrar << "Cantidad de Materias: ", Prof[I].Cant_Materias;
        Mostrar << "Cantidad de clases: ", Prof[I].Cant_Clases;
    Fin_Para
    Mostrar << "Estudiantes: ";
    Para (I = 1 Hasta I = v) Hacer;
        Mostrar << "Nombre: ", Datos[I].Nombre;
        Mostrar << "Cédula: ", Datos[I].CI;
        Mostrar << "Edad: ", Datos[I].Edad;
        Mostrar << "Correo Electrónico: ", Datos[I].Gmail;
        Mostrar << "Carrera: ", Datos[I].Carrera;
        Mostrar << "Año: ", Datos[I].Year;
        Mostrar << "Semestre: ", Datos[I].Semestre;
    Fin_Para
    
Fin_Procedimiento