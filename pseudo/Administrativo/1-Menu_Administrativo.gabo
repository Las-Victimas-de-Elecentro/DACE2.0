Procedimiento Menu_Administrativo(E/S: club, carnet, Nov, Re, S, v, C, Lim, K, Empleo[K].Edad, Empleo[K].CI, Admin[I].CI, Gestion[C].CI, Gestion[C].Edad, Gestion[C].Year, Gestion[C].Semestre, Datos[I].CI, Datos[I].Year, Datos[I].Semestre, Pas[I].Edad, Pas[I].Cedula, Pas[I].Semestre, Pas[I].Year, Pas[I].Estado_Solicitud, Plan[I].ID_Plan, Plan[I].Ponderacion, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima, Clase[I].CI_Profesor, Clase[I].Cant_Estudiantes, Prof[I].CI, Prof[I].Cant_Materias, Prof[I].Cant_Clases: Entero, Empleo[K].Usuario, Empleo[K].Gmail, Empleo[K].Password, Empleo[K].Experiencia, Empleo[K].Titulo, Empleo[K].Descripcion, Lim, Admin[I].Usuario, Admin[I].Cargo, Admin[I].Gmail, Admin[I].Password, Gestion[C].Usuario, Gestion[C].Password, Gestion[C].Carrera, Datos[I].Usuario, Datos[I].Gmail, Datos[I].Password, Datos[I].Carrera, Soli[I].Titulo, Soli[I].Descripcion, Soli[I].Titular, Soli[I].Destinatario, Rep[I].Titulo, Rep[I].Descripcion, Rep[I].Titular, Rep[I].Problema, Nov[I].Hecho, Nov[I].Fecha, Nov[I].Responsables, Nov[I].Contexto, Nov[I].Lugar, Pas[I].Nombre, Pas[I].Password, Pas[I].Carrera, Pas[I].Empresa, Carn[carnet].Carrera, Carn[carnet].Lugar, Carn[carnet].Fecha, Plan[I].Nombre_Profesor, Plan[I].Codigo_Materia, Plan[I].Nombre_Materia, Plan[I].Fecha, Plan[I].Tema, Plan[I].Estrategia, Club[I].Nombre, Club[I].Descripcion, Club[I].Horarios_Disponibles, Avatares[I], Admin[pos_admin].Avatar, Clase[I].Nombre_Profesor, Clase[I].Codigo_Materia, Clase[I].Periodo, Salud_Admin[pos_admin].Enfermedad_Cronica, Cronica[I], Salud_Admin[pos_admin].Discapacidad, Discapacidad[I], Salud_Admin[pos_admin].Corazon, Corazon[I], Salud_Admin[pos_admin].Cancer, Cancer[I], Prof[I].Nombre, Prof[I].Gmail. Prof[I].Materias: Cadena, Pas[I].Horas, Carn[carnet].Precio: Real, Empleo[K].Estado, Gestion[I].Estado, Soli[I].Estado, Rep[I].Recibido, Ad.Servicio_Comunitario, Inscripciones, Carn[carnet].Activo, Plan[I].Firmado, Club[I].Activo, Tema, Salud_Admin[pos_admin].Asma: Booleano);
Inicio
	Var Opcion, opc, opc2: Entero;
	Var R Booleano;
	Repetir
		Mostrar << "Bienvenido Administrador, ¿Qué desea hacer?";
		Mostrar << "1: Ver las opciones de su perfil";
		Mostrar << "2: Ver las opciones de administrativo";
		Leer >> opc;
		Mientras (opc < 1 or opc > 2) Hacer;
			Mostrar << "Elija una opción válida";
			Leer >> opc;
		Fin_Mientras
		Si (opc = 1) Entonces;
			Mostrar << "Opciones de su perfil";
			Mostrar << "1 Información Personal";
			Mostrar << "2 Seguridad";
			Mostrar << "3 Historial Labor Docente";
			Mostrar << "4 Modo Oscuro";
			Mostrar << "5 Avatar";
			Mostrar << "6 Salud";
			Mostrar << "7 Estadísticas";
			Leer >> opc2;
			Mientras (opc2 < 1 or opc2 > 6) Hacer;
				Mostrar << "Elija una opción entre 1-6";
				Leer >> opc2;
			Fin_Mientras
			En_Caso (opc2 > 0) Sea;
				Caso(opc2 = 1);
					Informacion_Personal_Admin(Admin[pos_admin].Usuario, Admin[pos_admin].CI, Admin[pos_admin].Gmail, Admin[pos_admin].Cargo);
					Mostrar << Informacion_Personal_Admin;
				Caso(opc2 = 2);
					Seguridad(Admin[pos_admin].Password, Admin[pos_admin].Usuario, Admin[pos_admin].Gmail);
					Mostrar << Seguridad;
				Caso(opc2 = 3);
					Historial_Labor_Docente(Clase[I].Nombre_Profesor, Clase[I].Codigo_Materia, Clase[I].Periodo, Clase[I].CI_Profesor, Clase[I].Cant_Estudiantes);
					Mostrar << Historial_Labor_Docente;
				Caso(opc2 = 4);
					Modo_Oscuro(Tema);
					Mostrar << Modo_Oscuro;
				Caso(opc2 = 5);
					Avatar_Admin(Avatares[I], Admin[pos_admin].Avatar);
					Mostrar << Avatar_Admin;
				Caso(opc2 = 6);
					Salud_Admin(Salud_Admin[pos_admin].Enfermedad_Cronica, Cronica[I], Salud_Admin[pos_admin].Discapacidad, Discapacidad[I], Salud_Admin[pos_admin].Corazon, Corazon[I], Salud_Admin[pos_admin].Cancer, Cancer[I], Salud_Admin[pos_admin].Asma);
					Mostrar << Salud;
				Otro_Caso
					Estadisticas(Admin[I].Usuario, Admin[I].Cargo, Admin[I].Gmail, Prof[I].Nombre, Prof[I].Gmail. Prof[I].Materias, Datos[I].Nombre, Datos[I].Gmail, Datos[I].Carrera, Admin[I].CI, Prof[I].CI, Prof[I].Cant_Materias, Prof[I].Cant_Clases, Datos[I].CI, Datos[I].Year, Datos[I].Semestre);
					Mostrar << Estadisticas;
			Fin_Caso
			
		Sino
			Mostrar << "Opciones de administrador";
			Mostrar << "1: Ingresar solicitudes de empleo";
			Mostrar << "2: Agregar empleados";
			Mostrar << "3: Eliminar empleados";
			Mostrar << "4: Solicitud de inscripción de Estudiantes";
			Mostrar << "5: Agregar estudiantes";
			Mostrar << "6: Eliminar estudiantes";
			Mostrar << "7: Solicitudes";
			Mostrar << "8: Reportes";
			Mostrar << "9: Agregar novedades";
			Mostrar << "10: Servicio Comunitario";
			Mostrar << "11: Pasantías";
			Mostrar << "12: Clases Magistrales";
			Mostrar << "13: Planes de Evaluación";
			Mostrar << "14: Carnetización";
			Mostrar << "15: Añadir Clubes";
			Leer >> Opcion;
			Mientras (Opcion < 1 or Opcion > 15) Hacer;
				Mostrar << "Error en dato";
				Leer >> Opcion;
			Fin_Mientras
			En_Caso (Opcion > 0) Sea;
				Caso (Opcion = 1);
					Solicitud_Empleo(K, Empleo[K].Edad, Empleo[K].CI, Empleo[K].Usuario, Empleo[K].Gmail, Empleo[K].Password, Empleo[K].Experiencia, Empleo[K].Titulo, Empleo[K].Descripcion, Empleo[K].Estado);
					Mostrar << Solicitud_Empleo;
				Caso (Opcion = 2);
					Agregar_Empleados(Lim, Admin[I].Usuario, Admin[I].Cargo, Admin[I].Gmail, Admin[I].Password, Empleo[I].Usuario, Empleo[I].Gmail, Empleo[I].Password);
					Mostrar << Agregar_Empleados;
				Caso (Opcion = 3);
					Eliminar_Empleado(Lim, Admin[I].CI, Admin[I].Usuario, Admin[I].Cargo, Admin[I].Gmail, Admin[I].Password);
					Mostrar << Eliminar_Empleado;
				Caso (Opcion = 4);
					Estudiantes_Datos(C, Gestion[C].CI, Gestion[C].Edad, Gestion[C].Year, Gestion[C].Semestre, Gestion[C].Usuario, Gestion[C].Password, Gestion[C].Carrera);
					Mostrar << Estudiantes_Datos;
				Caso (Opcion = 5);
					Agregar_Estudiantes(v, Datos[I].CI, Datos[I].Year, Datos[I].Semestre, Gestion[I].CI, Gestion[I].Year, Gestion[I].Semestre, Datos[I].Usuario, Datos[I].Gmail, Datos[I].Password, Datos[I].Carrera, Gestion[I].Usuario, Gestion[I].Gmail, Gestion[I].Password, Gestion[I].Carrera, Gestion[I].Estado);
					Mostrar << Agregar_Estudiantes;
				Caso (Opcion = 6);
					Eliminar_Estudiante(v, Datos[I].CI, Datos[I].Year, Datos[I].Semestre, Datos[I].Usuario, Datos[I].Gmail, Datos[I].Password);
					Mostrar << Eliminar_Estudiante;
				Caso(Opcion = 7);
					Solicitudes(S, Soli[I].Titulo, Soli[I].Descripcion, Soli[I].Titular, Soli[I].Destinatario, Soli[I].Estado);
					Mostrar << Solicitudes;
				Caso(Opcion = 8);
					Reportes(Re, Rep[I].Titulo, Rep[I].Descripcion, Rep[I].Titular, Rep[I].Problema, Rep[I].Recibido);
					Mostrar << Reportes;
				Caso(Opcion = 9);
					Novedades(Nov, Nov[I].Hecho, Nov[I].Fecha, Nov[I].Responsables, Nov[I].Contexto, Nov[I].Lugar);
					Mostrar << Novedades;
				Caso(Opcion = 10);
					Servicio_Comunitario(Ad.Servicio_Comunitario, Inscripciones);
					Mostrar << Servicio_Comunitario;
				Caso(Opcion = 11);
					Pasantias(Pas[I].Edad, Pas[I].Cedula, Pas[I].Semestre, Pas[I].Year, Pas[I].Estado_Solicitud, Pas[I].Nombre, Pas[I].Password, Pas[I].Carrera, Pas[I].Empresa, Pas[I].Horas);
					Mostrar << Pasantias;
				Caso(Opcion = 12);
					Carnetizacion_Admin(carnet, Carn[carnet].Carrera, Carn[carnet].Lugar, Carn[carnet].Fecha, Carn[carnet].Precio, Carn[carnet].Activo);
					Mostrar << Carnetizacion_Admin;
				Caso(Opcion = 13);
					Clases_Magistrales_Admin(Mag[I].ID_Clase, Mag[I].CI_Profesor, Mag[I].Nombre_Materia, Mag[I].Codigo_Materia, Mag[I].Nombre_Profesor, Mag[I].Autorizacion);
					Mostrar << Clases_Magistrales_Admin;
				Caso(Opcion = 14);
					Planes_Evaluacion(Plan[I].ID_Plan, Plan[I].Ponderacion, Plan[I].Nombre_Profesor, Plan[I].Codigo_Materia, Plan[I].Nombre_Materia, Plan[I].Fecha, Plan[I].Tema, Plan[I].Estrategia, Plan[I].Firmado);
					Mostrar << Planes_Evaluacion;
				Otro_Caso
					Adicionar_Clubes(Club[I].Nombre, Club[I].Descripcion, Club[I].Horarios_Disponibles, club, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima, Club[I].Activo);
					Mostrar << Adicionar_Clubes;
			Fin_Caso
		Fin_Si
		Mostrar << "¿Desea salir del sistema? 1 Sí, 0 No";
		Leer >> R;
		Hasta(R = 1);
	Fin_Repetir
Fin_Procedimiento