Procedimiento Informacion_Personal_Admin(E/S: pos_admin, Admin[pos_admin].CI, Admin[pos_admin].Edad: Entero, Admin[pos_admin].Usuario, Admin[pos_admin].Gmail, Admin[pos_admin].Cargo: Cadena);
Inicio
    Mostrar << "A continuación sus datos personales";
    Mostrar << "Avatar: ", Admin[pos_admin].Avatar;
    Mostrar << "Usuario: ", Admin[pos_admin].Usuario;
    Mostrar << "Edad: ", Admin[pos_admin].Edad;
    Mostrar << "Cédula de Identidad: ", Admin[pos_admin].CI;
    Mostrar << "Correo Electrónico: ", Admin[pos_admin].Gmail;
    Mostrar << "Cargo: ", Admin[pos_admin].Cargo;
Fin_Procedimiento