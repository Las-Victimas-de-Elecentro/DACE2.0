Procedimiento Estudiantes_Datos(E/S: C, Gestion[C].CI, Gestion[C].Edad, Gestion[C].Year, Gestion[C].Semestre: Entero, Gestion[C].Usuario, Gestion[C].Password, Gestion[C].Carrera, Gestion[C].Telefono: Cadena);
Inicio
	Var op: Entero;
	Var Z: Booleano;
    Repetir
        Mostrar << "Ingrese el nombre del estudiante";
        Leer >> Gestion[C].Usuario;
        Mostrar << "Ingrese la cédula del estudiante";
        Leer >> Gestion[C].CI;
        Mostrar << "Ingrese la edad";
        Leer >> Gestion[C].Edad;
        Mientras (Gestion[C].Edad < 15 or Gestion[C].Edad > 100) Hacer;
            Mostrar << "Solo positivos";
            Leer >> Gestion[C].Edad;
        Fin_Mientras
        Mostrar << "Ingrese el número de teléfono";
        Leer >> Gestion[C].Telefono;
        Mostrar << "Ingrese la carrera del estudiante";
        Mostrar << "1: Ingeniería en Informática";
        Mostrar << "2: Ingeniería Civil";
        Mostrar << "3: Ingeniería en Hidrocarburos";
        Mostrar << "4: Medicina";
        Mostrar << "5: Odontología";
        Mostrar << "6: Veterinaria";
        Mostrar << "7: Derecho";
        Mostrar << "8: Comunicación Social";
        Mostrar << "9: Contaduría";
        Mostrar << "10: Economía";
        Leer >> op;
        Mientras (op < 1 or op > 10) Hacer;
            Mostrar << "Es invalido, solo rango entre 1-10";
            Leer >> op;
        Fin_Mientras
        En_Caso (op > 0) Sea;
            Caso(op = 1);
                Gestion[C].Carrera = "Informática";
            Caso(op = 2);
                Gestion[C].Carrera = "Civil";
            Caso(op = 3);
                Gestion[C].Carrera = "Hidrocarburos";
            Caso(op = 4);
                Gestion[C].Carrera = "Medicina";
            Caso(op = 5);
                Gestion[C].Carrera = "Odontología";
            Caso(op = 6);
                Gestion[C].Carrera = "Veterinaria";
            Caso(op = 7);
                Gestion[C].Carrera = "Derecho";
            Caso(op = 8);
                Gestion[C].Carrera = "Comunicación";
            Caso(op = 9);
                Gestion[C].Carrera = "Contaduría";
            Otro_Caso
                Gestion[C].Carrera = "Economía";
        Fin_Caso
        Si (Gestion[C].Carrera = "Informática") or (Gestion[C].Carrera = "Civil") or (Gestion[C].Carrera = "Hidrocarburos") or (Gestion[C].Carrera = "Comunicación") or (Gestion[C].Carrera = "Contaduría") or (Gestion[C].Carrera = "Economía") Entonces;
            Gestion[C].Year = 0;
            Mostrar << "Ingrese el semestre del estudiante";
            Leer >> Gestion[C].Semestre;
            Mientras (Gestion[C].Semestre < 1 or Gestion[C].Semestre > 10) Hacer;
                Mostrar << "Es invalido";
                Leer >> Gestion[C].Semestre;
            Fin_Mientras
        Sino
            Gestion[C].Semestre = 0;
            Mostrar << "Ingrese el año del estudiante";
            Leer >> Gestion[C].Year;
            Mientras (Gestion[C].Year < 1 or Gestion[C].Year > 6) Hacer;
                Mostrar << "Es invalido";
                Leer >> Gestion[C].Year;
            Fin_Mientras
        Fin_Si
        Mostrar << "¿Desea anotar otra inscripción estudiantil? 1: Sí, 0: No";
        Leer >> Z;
        C = C + 1;
        Hasta(Z = 0 or C = 5000);
    Fin_Repetir

    Para (I = 1 Hasta I = C) Hacer;
        Si (Gestion[I].Verificado = 1) Entonces;
            Gestion[I].Usuario = = Gestion[C - 1].Usuario;
            Gestion[I].CI = Gestion[C - 1].CI;
            Gestion[I].Edad = Gestion[C - 1].Edad;
            Gestion[I].Carrera= Gestion[C - 1].Carrera;
            Gestion[I].Year = Gestion[C - 1].Year;
            Gestion[I].Semestre = Gestion[C - 1].Semestre;
            
            Gestion[C - 1].Usuario = null;
            Gestion[C - 1].CI = 0;
            Gestion[C - 1].Edad = 0;
            Gestion[C - 1].Carrera = null;
            Gestion[C - 1].Year = 0;
            Gestion[C - 1].Semestre = 0;
            C = C - 1;
        Fin_Si
    Fin_Para
Fin_Procedimiento