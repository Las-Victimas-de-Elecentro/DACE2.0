        Suma = Suma + Datos[pos_usuario].Materias.Hid[pos_usuario].Ing_Produccion_II;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Matematica_III >= 5.5) Entonces
        Mostrar << "Simulación Yacimientos: ", Datos[pos_usuario].Materias.Hid[pos_usuario].Simulacion_Yacimientos;
        Suma = Suma + Datos[pos_usuario].Materias.Hid[pos_usuario].Simulacion_Yacimientos;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_VIII >= 5.5) Entonces
        Mostrar << "Trabajo Especial de Grado: ", Datos[pos_usuario].Materias.Hid[pos_usuario].TEG;
        Suma = Suma + Datos[pos_usuario].Materias.Hid[pos_usuario].TEG;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Recuperacion_Secundaria >= 5.5) Entonces
        Mostrar << "Recuperación Mejorada: ", Datos[pos_usuario].Materias.Hid[pos_usuario].Recuperacion_Mejorada;
        Suma = Suma + Datos[pos_usuario].Materias.Hid[pos_usuario].Recuperacion_Mejorada;
        Contador = Contador + 1;
    Fin_Si

Fin_Procedimiento