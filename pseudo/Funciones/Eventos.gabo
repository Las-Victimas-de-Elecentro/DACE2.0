Procedimiento Eventos(E/S: Even[I].Nombre, Even[I].Fecha, Even[I].Descripcion: Cadena);
Inicio
    Mostrar << "A continuación los Even actuales";
    Para (I = 1 Hasta I = eve) Hacer;
        Mostrar << I;
        Mostrar << Even[I].Nombre;
        Mostrar << Even[I].Fecha;
        Mostrar << Even[I].Tipo;
        Mostrar << Even[I].Descripcion;
    Fin_Para
Fin_Procedimiento