Procedimiento Historial_Economia (E/S: Suma, Contador, Datos[pos_usuario]: Reg_Estudiante)
Inicio
    Si (Datos[pos_usuario].UC_Aprobadas >= 0) Entonces
        Mostrar << "Introduccion a la Economia: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Introduccion_Economia;
        Mostrar << "Analisis Matematico I: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Matematico_I;
        Mostrar << "Lenguaje y Comunicacion: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Lenguaje_Comunicacion;
        Mostrar << "Fundamentos del Derecho: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Fundamentos_Derecho;
        Mostrar << "Metodologia de la Investigacion: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Metodologia_Investigacion;
        Mostrar << "Deporte y Recreacion: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Deporte_Recreacion;
        Mostrar << "Ingles Instrumental: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Ingles_Instrumental;
        
        Suma = Suma + (Datos[pos_usuario].Materias.Eco[pos_usuario].Introduccion_Economia + Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Matematico_I + Datos[pos_usuario].Materias.Eco[pos_usuario].Lenguaje_Comunicacion + Datos[pos_usuario].Materias.Eco[pos_usuario].Fundamentos_Derecho + Datos[pos_usuario].Materias.Eco[pos_usuario].Metodologia_Investigacion + Datos[pos_usuario].Materias.Eco[pos_usuario].Deporte_Recreacion + Datos[pos_usuario].Materias.Eco[pos_usuario].Ingles_Instrumental);
        Contador = Contador + 7;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Introduccion_Economia >= 5.5) Entonces
        Mostrar << "Economia I: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_I;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_I; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Matematico_I >= 5.5) Entonces
        Mostrar << "Analisis Matematico II: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Matematico_II;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Matematico_II; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 21) Entonces
        Mostrar << "Sociologia: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Sociologia;
        Mostrar << "Contabilidad General I: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_General_I;
        Mostrar << "Informatica: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Informatica;
        Mostrar << "Arte y Cultura: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Arte_Cultura;
        Mostrar << "Estadistica I: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_I;
        Suma = Suma + (Datos[pos_usuario].Materias.Eco[pos_usuario].Sociologia + Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_General_I + Datos[pos_usuario].Materias.Eco[pos_usuario].Informatica + Datos[pos_usuario].Materias.Eco[pos_usuario].Arte_Cultura + Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_I);
        Contador = Contador + 5;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_I >= 5.5) Entonces
        Mostrar << "Economia II: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_II;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_II; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_I >= 5.5) Entonces
        Mostrar << "Estadistica II: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_II;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_II; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_General_I >= 5.5) Entonces
        Mostrar << "Contabilidad General II: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_General_II;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_General_II; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Informatica >= 5.5) Entonces
        Mostrar << "Informatica Aplicada: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Informatica_Aplicada;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Informatica_Aplicada; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 40) Entonces
        Mostrar << "Sociopolitica Productiva: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Sociopolitica_Productiva;
        Mostrar << "Introduccion a la Administracion: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Introduccion_Administracion;
        Mostrar << "Historia y Doctrina Economica: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Historia_Doctrina_Economica;
        Suma = Suma + (Datos[pos_usuario].Materias.Eco[pos_usuario].Sociopolitica_Productiva + Datos[pos_usuario].Materias.Eco[pos_usuario].Introduccion_Administracion + Datos[pos_usuario].Materias.Eco[pos_usuario].Historia_Doctrina_Economica);
        Contador = Contador + 3;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_II >= 5.5) Entonces
        Mostrar << "Macroeconomia I: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Macroeconomia_I;
        Mostrar << "Microeconomia I: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Microeconomia_I;
        Suma = Suma + (Datos[pos_usuario].Materias.Eco[pos_usuario].Macroeconomia_I + Datos[pos_usuario].Materias.Eco[pos_usuario].Microeconomia_I);
        Contador = Contador + 2;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Matematico_II >= 5.5) Entonces
        Mostrar << "Matematica III: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Matematica_III;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Matematica_III; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_II >= 5.5) Entonces
        Mostrar << "Estadistica Aplicada: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_Aplicada;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_Aplicada; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 65) Entonces
        Mostrar << "Analisis Financiero: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Financiero;
        Mostrar << "Teoria e Investigacion de Mercado: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Teoria_Investigacion_Mercado;
        Mostrar << "Seminario I: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_I;
        Suma = Suma + (Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Financiero + Datos[pos_usuario].Materias.Eco[pos_usuario].Teoria_Investigacion_Mercado + Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_I);
        Contador = Contador + 3;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Macroeconomia_I >= 5.5) Entonces
        Mostrar << "Macroeconomia II: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Macroeconomia_II;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Macroeconomia_II; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Microeconomia_I >= 5.5) Entonces
        Mostrar << "Microeconomia II: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Microeconomia_II;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Microeconomia_II; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Matematica_III >= 5.5) Entonces
        Mostrar << "Matematica Financiera: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Matematica_Financiera;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Matematica_Financiera; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 90) Entonces
        Mostrar << "Contabilidad Social: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_Social;
        Mostrar << "Desarrollo Economico: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Desarrollo_Economico;
        Mostrar << "Analisis Economico Regional: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Economico_Regional;
        Suma = Suma + (Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_Social + Datos[pos_usuario].Materias.Eco[pos_usuario].Desarrollo_Economico + Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Economico_Regional);
        Contador = Contador + 3;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 110) Entonces
        Mostrar << "Economia Politica: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Politica;
        Mostrar << "Formulacion y Evaluacion de Proyectos: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Formulacion_Evaluacion_Proyectos;
        Mostrar << "Investigacion de Operaciones: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Investigacion_Operaciones;
        Mostrar << "Teoria y Politica Fiscal: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Teoria_Politica_Fiscal;
        Suma = Suma + (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Politica + Datos[pos_usuario].Materias.Eco[pos_usuario].Formulacion_Evaluacion_Proyectos + Datos[pos_usuario].Materias.Eco[pos_usuario].Investigacion_Operaciones + Datos[pos_usuario].Materias.Eco[pos_usuario].Teoria_Politica_Fiscal);
        Contador = Contador + 4;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_I >= 5.5) Entonces
        Mostrar << "Seminario II: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_II;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_II; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 120) y (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Politica_Agricola >= 0) Entonces
        Mostrar << "Economia Politica Agricola: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Politica_Agricola;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Politica_Agricola; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 120) y (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Industrial >= 0) Entonces
        Mostrar << "Economia Industrial: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Industrial;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Industrial; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 120) y (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Minera >= 0) Entonces
        Mostrar << "Economia Minera: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Minera;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Minera; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 120) y (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Ambiente >= 0) Entonces
        Mostrar << "Economia Ambiente: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Ambiente;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Ambiente; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 140) Entonces
        Mostrar << "Econometria: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Econometria;
        Mostrar << "Teoria y Politica Monetaria: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Teoria_Politica_Monetaria;
        Mostrar << "Planificacion: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Planificacion;
        Mostrar << "Economia Internacional: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Internacional;
        Suma = Suma + (Datos[pos_usuario].Materias.Eco[pos_usuario].Econometria + Datos[pos_usuario].Materias.Eco[pos_usuario].Teoria_Politica_Monetaria + Datos[pos_usuario].Materias.Eco[pos_usuario].Planificacion + Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Internacional);
        Contador = Contador + 4;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_II >= 5.5) Entonces
        Mostrar << "Seminario III: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_III;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_III; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 155) y (Datos[pos_usuario].Materias.Eco[pos_usuario].Formulacion_Evaluacion_Agricola >= 0) Entonces
        Mostrar << "Formulacion Evaluacion Agricola: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Formulacion_Evaluacion_Agricola;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Formulacion_Evaluacion_Agricola; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 155) y (Datos[pos_usuario].Materias.Eco[pos_usuario].Gestion_Comunitaria >= 0) Entonces
        Mostrar << "Gestion Comunitaria: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Gestion_Comunitaria;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Gestion_Comunitaria; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 155) y (Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_Costos >= 0) Entonces
        Mostrar << "Contabilidad Costos: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_Costos;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_Costos; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 155) y (Datos[pos_usuario].Materias.Eco[pos_usuario].Presupuesto >= 0) Entonces
        Mostrar << "Presupuesto: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Presupuesto;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Presupuesto; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 170) Entonces
        Mostrar << "Estructura Economica Mundial: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Estructura_Economica_Mundial;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Estructura_Economica_Mundial; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_III >= 5.5) Entonces
        Mostrar << "Trabajo Final de Grado: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Trabajo_Final_Grado;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Trabajo_Final_Grado; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 185) y (Datos[pos_usuario].Materias.Eco[pos_usuario].Finanzas_Internacionales >= 0) Entonces
        Mostrar << "Finanzas Internacionales: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Finanzas_Internacionales;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Finanzas_Internacionales; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 185) y (Datos[pos_usuario].Materias.Eco[pos_usuario].Gestion_Riesgo >= 0) Entonces
        Mostrar << "Gestion de Riesgo: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Gestion_Riesgo;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Gestion_Riesgo; Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 185) y (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Crisis >= 0) Entonces
        Mostrar << "Economia y Crisis: ", Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Crisis;
        Suma = Suma + Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Crisis; Contador = Contador + 1;
    Fin_Si

Fin_Procedimiento