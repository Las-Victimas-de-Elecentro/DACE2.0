        Suma = Suma + Datos[pos_usuario].Materias.Civ[pos_usuario].Trabajo_Grado_II;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Concreto_Pretenzado >= 5.5) Entonces
        Mostrar << "Puentes: ", Datos[pos_usuario].Materias.Civ[pos_usuario].Puentes;
        Mostrar << "Proyectos Estructurales de Concreto: ", Datos[pos_usuario].Materias.Civ[pos_usuario].Proyectos_Estructurales_Concreto;
        Suma = Suma + (Datos[pos_usuario].Materias.Civ[pos_usuario].Puentes + Datos[pos_usuario].Materias.Civ[pos_usuario].Proyectos_Estructurales_Concreto);
        Contador = Contador + 2;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Vias_De_Comunicacion_II >= 5.5) Entonces
        Mostrar << "Pavimentos: ", Datos[pos_usuario].Materias.Civ[pos_usuario].Pavimentos;
        Suma = Suma + Datos[pos_usuario].Materias.Civ[pos_usuario].Pavimentos;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 171) Entonces
        Mostrar << "Administración de Obras: ", Datos[pos_usuario].Materias.Civ[pos_usuario].Administracion_De_Obras;
        Suma = Suma + Datos[pos_usuario].Materias.Civ[pos_usuario].Administracion_De_Obras;
        Contador = Contador + 1;
    Fin_Si

Fin_Procedimiento