Procedimiento Historial_Comunicacion(E/S: Suma, Contador, Datos[pos_usuario].UC_Aprobadas: Entero, {Variables de las 58 materias}: Real)
Inicio

    Si (Datos[pos_usuario].UC_Aprobadas >= 0) Entonces
        Mostrar << "Morfosintaxis del castellano: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Morfosintaxis;
        Mostrar << "Comunicación Social en el periodismo: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Periodismo;
        Mostrar << "Psicología de la Comunicación: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Psicologia_Com;
        Mostrar << "Estadística: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Estadistica;
        Mostrar << "Deporte, Arte y cultura: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Deporte_Arte_Cultura;
        Mostrar << "Pensamiento Bolivariano: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Pensamiento_Bolivariano;
        
        Suma = Suma + (Datos[pos_usuario].Materias.Soc[pos_usuario].Morfosintaxis + Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Periodismo + Datos[pos_usuario].Materias.Soc[pos_usuario].Psicologia_Com + Datos[pos_usuario].Materias.Soc[pos_usuario].Estadistica + Datos[pos_usuario].Materias.Soc[pos_usuario].Deporte_Arte_Cultura + Datos[pos_usuario].Materias.Soc[pos_usuario].Pensamiento_Bolivariano);
        Contador = Contador + 6;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 2) Entonces
        Mostrar << "Periodismo Informativo: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Informativo;
        Mostrar << "Comunicación Social en la Radio: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Radio;
        Mostrar << "Comunicación Social en el Cine: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Cine;
        Mostrar << "Comunicación Social en la Televisión: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_TV;
        Mostrar << "Comunicación Social en la Fotografía: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Foto;
        Suma = Suma + (Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Informativo + Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Radio + Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Cine + Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_TV + Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Foto);
        Contador = Contador + 5;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Morfosintaxis >= 5.5) Entonces
        Mostrar << "Taller de Redacción y Estilo I: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Taller_Redaccion_I;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Taller_Redaccion_I;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 3) Entonces
        Mostrar << "Proyecto Comunitario Socio Comunicacional I: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_I;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_I;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Taller_Redaccion_I >= 5.5) Entonces
        Mostrar << "Taller de Redacción y Estilo II: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Taller_Redaccion_II;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Taller_Redaccion_II;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Foto >= 5.5) Entonces
        Mostrar << "Comunicación Gráfica: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Grafica;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Grafica;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Radio >= 5.5) Entonces
        Mostrar << "Periodismo Radiofónico: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Radiofonico;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Radiofonico;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Cine >= 5.5) Entonces
        Mostrar << "Lenguaje y Planificación Cinematográfica: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Lenguaje_Cine;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Lenguaje_Cine;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_TV >= 5.5) Entonces
        Mostrar << "Periodismo Televisivo: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_TV;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_TV;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Grafica >= 5.5) Entonces
        Mostrar << "Estética de la Imagen y el Sonido: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Estetica_Imagen_Sonido;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Estetica_Imagen_Sonido;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 4) Entonces
        Mostrar << "Teoría de la Comunicación: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Teoria_Comunicacion;
        Mostrar << "Opinión Pública: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Opinion_Publica;
        Mostrar << "Formación Sociopolítica: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Formacion_Sociopolitica;
        Mostrar << "Ética y Legislación: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Etica_Legislacion;
        Suma = Suma + (Datos[pos_usuario].Materias.Soc[pos_usuario].Teoria_Comunicacion + Datos[pos_usuario].Materias.Soc[pos_usuario].Opinion_Publica + Datos[pos_usuario].Materias.Soc[pos_usuario].Formacion_Sociopolitica + Datos[pos_usuario].Materias.Soc[pos_usuario].Etica_Legislacion);
        Contador = Contador + 4;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_I >= 5.5) Entonces
        Mostrar << "Proyecto Comunitario Socio Comunicacional II: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_II;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_II;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_II >= 5.5) Entonces
        Mostrar << "Proyecto Comunitario Socio Comunicacional III: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_III;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_III;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Teoria_Comunicacion >= 5.5) Entonces
        Mostrar << "Sociología de la Comunicación: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Sociologia_Comunicacion;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Sociologia_Comunicacion;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 5) Entonces
        Mostrar << "Investigación de la Comunicación: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Investigacion_Comunicacion;
        Mostrar << "Periodismo Interpretativo: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Interpretativo;
        Mostrar << "Economía Política: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Economia_Politica;
        Suma = Suma + (Datos[pos_usuario].Materias.Soc[pos_usuario].Investigacion_Comunicacion + Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Interpretativo + Datos[pos_usuario].Materias.Soc[pos_usuario].Economia_Politica);
        Contador = Contador + 3;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Opinion_Publica >= 5.5) Entonces
        Mostrar << "Periodismo de Opinión: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Opinion;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Opinion;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Estetica_Imagen_Sonido >= 5.5) Entonces
        Mostrar << "Producción de Televisión: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_TV;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_TV;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 6) Entonces
        Mostrar << "Producción de Radio: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_Radio;
        Mostrar << "Producción de Cine: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_Cine;
        Mostrar << "Seminario de Formación Socio Crítica I: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_I;
        Suma = Suma + (Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_Radio + Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_Cine + Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_I);
        Contador = Contador + 3;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_III >= 5.5) Entonces
        Mostrar << "Proyecto Comunitario Socio Comunicacional IV: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_IV;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_IV;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Sociologia_Comunicacion >= 5.5) Entonces
        Mostrar << "Semiología: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Semiologia;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Semiologia;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 82) Entonces
        Mostrar << "Fotoperiodismo: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Fotoperiodismo;
        Mostrar << "Periodismo Científico: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Cientifico;
        Mostrar << "Relaciones Públicas: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Relaciones_Publicas;
        Mostrar << "Tecnología de la Información: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Tecnologia_Informacion;
        Suma = Suma + (Datos[pos_usuario].Materias.Soc[pos_usuario].Fotoperiodismo + Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Cientifico + Datos[pos_usuario].Materias.Soc[pos_usuario].Relaciones_Publicas + Datos[pos_usuario].Materias.Soc[pos_usuario].Tecnologia_Informacion);
        Contador = Contador + 4;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_I >= 5.5) Entonces
        Mostrar << "Seminario de Formación Socio Crítica II: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_II;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_II;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_Cine >= 5.5) y (Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_TV >= 5.5) Entonces
        Mostrar << "Montajes Audiovisuales: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Montajes_Audiovisuales;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Montajes_Audiovisuales;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_IV >= 5.5) Entonces
        Mostrar << "Proyecto Comunitario Socio Comunicacional V: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_V;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_V;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 98) Entonces
        Mostrar << "Locución Básica: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Locucion_Basica;
        Mostrar << "Idioma Moderno: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Idioma_Moderno;
        Mostrar << "Periodismo Económico: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Economico;
        Mostrar << "Orientación Profesional I: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Orientacion_Profesional_I;
        Suma = Suma + (Datos[pos_usuario].Materias.Soc[pos_usuario].Locucion_Basica + Datos[pos_usuario].Materias.Soc[pos_usuario].Idioma_Moderno + Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Economico + Datos[pos_usuario].Materias.Soc[pos_usuario].Orientacion_Profesional_I);
        Contador = Contador + 4;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Relaciones_Publicas >= 5.5) Entonces
        Mostrar << "Publicidad: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Publicidad;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Publicidad;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_II >= 5.5) Entonces
        Mostrar << "Seminario de Formación Socio Crítica III: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_III;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_III;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_V >= 5.5) Entonces
        Mostrar << "Proyecto Comunitario Socio Comunicacional VI: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_VI;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_VI;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 115) Entonces
        Mostrar << "Gerencia Corporativa: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Gerencia_Corporativa;
        Mostrar << "Periodismo Político: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Politico;
        Mostrar << "Vinculación Profesional: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Vinculacion_Profesional;
        Suma = Suma + (Datos[pos_usuario].Materias.Soc[pos_usuario].Gerencia_Corporativa + Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Politico + Datos[pos_usuario].Materias.Soc[pos_usuario].Vinculacion_Profesional);
        Contador = Contador + 3;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Publicidad >= 5.5) Entonces
        Mostrar << "Mercadeo: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Mercadeo;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Mercadeo;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Locucion_Basica >= 5.5) Entonces
        Mostrar << "Locución Profesional: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Locucion_Profesional;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Locucion_Profesional;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_VI >= 5.5) Entonces
        Mostrar << "Proyecto Comunitario Socio Comunicacional VII: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_VII;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_VII;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Orientacion_Profesional_I >= 5.5) Entonces
        Mostrar << "Orientación Profesional II: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Orientacion_Profesional_II;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Orientacion_Profesional_II;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 132) Entonces
        Mostrar << "Trabajo Especial de Grado: ", Datos[pos_usuario].Materias.Soc[pos_usuario].Trabajo_Grado;
        Suma = Suma + Datos[pos_usuario].Materias.Soc[pos_usuario].Trabajo_Grado;
        Contador = Contador + 1;
    Fin_Si
Fin_Procedimiento