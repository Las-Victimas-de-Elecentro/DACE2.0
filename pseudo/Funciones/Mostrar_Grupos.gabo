Procedimiento Mostrar_Grupos(E/S: Gru[I].Nombre_Profesor, Gru[I].Codigo_Materia: Cadena, Gru[I].Miembros, Gru[I].Seccion: Entero);
Inicio
    Var R: Booleano;
    Var I: Entero;
    Mostrar << "¡Bienvenido a la sección de Grupos!";
    Mostrar << "¿Desea ver los grupos disponibles? 1: Sí, 0: No";
    Leer >> R;
    Si (R = 1) Entonces;
        Para (I = 1 Hasta I = 500) Hacer;
            Mostrar << Gru[I].Nombre_Profesor;
            Mostrar << Gru[I].Codigo_Materia;
            Mostrar << Gru[I].Miembros;
            Mostrar << Gru[I].Seccion;
        Fin_Para
    Sino
        Mostrar << "Vuelva pronto.";
    Fin_Si
Fin_Procedimiento