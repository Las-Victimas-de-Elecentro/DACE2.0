        Mostrar << "Electiva Libre II: ", Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Libre_II;
        Suma = Suma + Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Libre_II;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Pasantias >= 5.5) Entonces
        Mostrar << "Gerencia de Proyectos: ", Datos[pos_usuario].Materias.Info[pos_usuario].Gerencia_Proyectos;
        Suma = Suma + Datos[pos_usuario].Materias.Info[pos_usuario].Gerencia_Proyectos;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Proyecto_Grado_I >= 5.5) Entonces
        Mostrar << "Proyecto de Grado II: ", Datos[pos_usuario].Materias.Info[pos_usuario].Proyecto_Grado_II;
        Suma = Suma + Datos[pos_usuario].Materias.Info[pos_usuario].Proyecto_Grado_II;
        Contador = Contador + 1;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Area_II >= 5.5) Entonces
        Mostrar << "Electiva de Area III: ", Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Area_III;
        Suma = Suma + Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Area_III;
        Contador = Contador + 1;
    Fin_Si

Fin_Procedimiento