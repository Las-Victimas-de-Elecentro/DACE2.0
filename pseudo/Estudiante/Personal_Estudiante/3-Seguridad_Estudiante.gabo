Procedimiento Seguridad_Estudiante(E/S: indice, pos_usuario: Entero, Datos[pos_usuario].Password, Datos[pos_usuario].Gmail, pass: Cadena, [Procedimiento Validar_Coordenada(pos_usuario, Tarjeta[I].ID, Tarjeta[I].Fila, Tarjeta[I].Columna, pos_admin, Tarjeta_A[I].ID, Tarjeta_A[I].Fila, Tarjeta_A[I].Columna, pos, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna, Minimo, Maximo, Acceso, encontrado, encontradoProf, encontradoAdmin, [Funcion Aleatorio(Minimo, Maximo)])], [Procedimiento Encriptacion(indice, pass)]);
Inicio
    Var Opc, Intentos_Fallidos = 3: Entero; 
    Var contra, contraNueva, NewG: Cadena;
    Var S = 0, R, Re: Booleano;
    
    Repetir
        Mostrar << "Gestión de seguridad";
        Mostrar << "Aquí puedes cambiar tu contraseña o actualizar tu correo de contacto";
        Mostrar << "Seleccione una opción de seguridad";
        Mostrar << "1: Cambiar Contraseña";
        Mostrar << "2: Actualizar Correo";
        Leer >> Opc;
        Mientras (Opc < 1 Or Opc > 2) Hacer;
            Mostrar << "Ingrese solo opciones entre 1-2";
            Leer >> Opc;
        Fin_Mientras

        En_Caso (Opc > 0) Sea;
            Caso(Opc = 1);
                Validar_Coordenada(pos_usuario, Tarjeta[I].ID, Tarjeta[I].Fila, Tarjeta[I].Columna, pos_admin, Tarjeta_A[I].ID, Tarjeta_A[I].Fila, Tarjeta_A[I].Columna, pos, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna, Minimo, Maximo, Acceso, encontrado, encontradoProf, encontradoAdmin, [Funcion Aleatorio(Minimo, Maximo)]);
                Mostrar << Validar_Coordenada;
                Si (Acceso = 1) Entonces;
                    Mostrar << "Ingrese su contraseña actual: ";
                    Leer >> contra;
                    Si (contra = Datos[pos_usuario].Password) Entonces;
                        Repetir
                            Mostrar << "Perfecto, ahora ingrese su nueva contraseña: ";
                            Leer >> contraNueva;
                            Mostrar << "¿Está seguro de que quiere que esa sea su nueva contraseña? 1: Sí, 0: No";
                            Leer >> Re;
                            Hasta(Re = 1);
                        Fin_Repetir
                        indice = pos_usuario;
                        pass = contraNueva;
                        Encriptacion(indice, pass);
                        Datos[pos_usuario].Password = pass;
                    Fin_Si
                Sino
                    Si (Intentos_Fallidos = 0) Entonces;
                        Mostrar << "Te quedaste sin intentos, intenta más tarde";
                    Sino
                        Intentos_Fallidos = Intentos_Fallidos - 1;
                        Mostrar << "Intento Fallido, te quedan ", Intentos_Fallidos;
                    Fin_Si
                Fin_Si
            Otro_Caso
                Mostrar << "Ingrese el nuevo correo electrónico";
                Leer >> NewG;
                Mostrar << "¿Estás seguro de que quieres usar este correo? Ingrese 1:Sí / 0:No";
                Leer >> S;
                Mientras (S < 0 Or S > 1) Hacer;
                    Mostrar << "Ingrese solo opciones entre 0-1";
                    Leer >> S;
                Fin_Mientras
            Fin_Caso

        En_Caso (S > 0) Sea;
            Caso(Opc = 1);
                Mostrar << "Contraseña actualizada con éxito";
                Datos[pos_usuario].Password = NewC;
            Otro_Caso
                Mostrar << "Correo actualizado con éxito";
                Datos[pos_usuario].Gmail = NewG;
        Fin_Caso

        Si (S = 0) Entonces;
            Mostrar << "Cambios de seguridad cancelados";
        Fin_Si

        Mostrar << "¿Desea cambiar otro dato de seguridad? Ingrese 1:Sí, 0:No";
        Leer >> R;
        Hasta(R = 0);
    Fin_Repetir
Fin_Procedimiento