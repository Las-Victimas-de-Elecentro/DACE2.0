Procedimiento Ranking(E/S: Ver, pub, Publi[I].ID_Publicacion, Publi[I].Comentarios, Publi[I].Cant_Reacciones: Entero, Publi[I].Texto, Publi[I].Autor, Publi[I].Tema, Publi[I].Fecha, Publi[I].Tipo_Reaccion1, Publi[I].Tipo_Reaccion2, Publi[I].Tipo_Reaccion3, Publi[I].Etiqueta: Cadena, [Procedimiento Opciones_Publicacion(Aux, Ver, react, pub, Datos[pos_usuario].Vistos, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Cant_Reacciones, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, R3, [Procedimiento Agregar_Reaccion(Aux, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta)], [Procedimiento Comentar(com, Com[com].ID_Publicacion, Com[com].ID_Comentario, Com[com].Comentario, Com[com].Fecha, Com[com].Autor)], [Procedimiento Comentarios(Ver, re, react, Publi[Ver].ID_Publicacion, Publi[Ver].Comentarios, Com[J].ID_Publicacion, Com[J].ID_Comentario, Com[J].Cant_Reacciones, Res[K].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Rea[react].ID_Publicacion, Rea[react].ID_Comentario, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Com[J].Respuestas, Com[J].Autor, Com[J].Fecha, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Com[J].Comentario, Res[re].Comentario, Res[re].Autor, Res[re].Fecha, [Procedimiento Agregar_Reaccion(Aux, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta)])])]);
Inicio
    Var I, J, J2, aux, Jose_Lozano[pub], Jose_Lozano2[pub]: Entero;
    Para (I = 1 Hasta I = pub) Hacer;
        Jose_Lozano[I] = Publi[I].Cant_Reacciones;
        Jose_Lozano2[I] = Publi[I].ID_Publicacion;
    Fin_Para
    Para (I = 1 Hasta I = pub) Hacer;
        Para (J2 = 1 Hasta J2 = pub) Hacer;
            Si (Jose_Lozano [I] < Jose_Lozano[I + 1]);
                aux = Jose_Lozano[I];
                Jose_Lozano[I] = Jose_Lozano[I + 1];
                Jose_Lozano[I + 1] = aux;
                aux = Jose_Lozano2[I];
                Jose_Lozano2[I] = Jose_Lozano2[I + 1];
                Jose_Lozano2[I + 1] = aux;
            Fin_Si
        Fin_Para
    Fin_Para
    Para (I = 1 Hasta I = pub) Hacer;
        Para(J = 10 Hasta J = 1) Hacer;
            Si (Jose_Lozano2[J] = Publi[I].ID_Publicacion) Entonces;
                Mostrar << "Top ", J, " Publicacion: ";
                Mostrar << Publi[I].Texto;    
                Mostrar << Publi[I].Autor;                       
                Mostrar << Publi[I].Tema;          
                Mostrar << Publi[I].Fecha;           
                Mostrar << Publi[I].Comentarios;      
                Mostrar << Publi[I].Cant_Reacciones;   
                Mostrar << Publi[I].Tipo_Reaccion1;     
                Mostrar << Publi[I].Tipo_Reaccion2;   
                Mostrar << Publi[I].Tipo_Reaccion3;  
                Mostrar << Publi[I].Etiqueta;
                Ver = I;
                Opciones_Publicacion(Aux, Ver, react, pub, Datos[pos_usuario].Vistos, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Cant_Reacciones, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, R3, [Procedimiento Agregar_Reaccion(Aux, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta)], [Procedimiento Comentar(com, Com[com].ID_Publicacion, Com[com].ID_Comentario, Com[com].Comentario, Com[com].Fecha, Com[com].Autor)], [Procedimiento Comentarios(Ver, re, react, Publi[Ver].ID_Publicacion, Publi[Ver].Comentarios, Com[J].ID_Publicacion, Com[J].ID_Comentario, Com[J].Cant_Reacciones, Res[K].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Rea[react].ID_Publicacion, Rea[react].ID_Comentario, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Com[J].Respuestas, Com[J].Autor, Com[J].Fecha, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Com[J].Comentario, Res[re].Comentario, Res[re].Autor, Res[re].Fecha, [Procedimiento Agregar_Reaccion(Aux, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta)])]);
                Mostrar << Opciones_Publicacion;
            Fin_Si
        Fin_Para         
    Fin_Para
Fin_Procedimiento