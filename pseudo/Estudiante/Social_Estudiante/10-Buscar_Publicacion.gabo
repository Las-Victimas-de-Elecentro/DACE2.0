Procedimiento Buscar_Publicacion(E/S: Aux, Ver, react, com, re, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[I].Cant_Reacciones, Com[J].Cant_Reacciones, Res[K].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Com[com].ID_Publicacion, Com[com].ID_Comentario, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta: Entero, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta, Com[com].Comentario, Com[com].Fecha, Com[com].Autor, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Res[re].Comentario, Res[re].Autor, Res[re].Fecha, Publi[I].Autor, Publi[I].Tema, Publi[I].Normas, Publi[I].Texto, Publi[I].Tipo_Reaccion1, Publi[I].Tipo_Reaccion2, Publi[I].Tipo_Reaccion3: Cadena, Publi[I].Activo: Booleano);
Inicio
    Var R, R2, R3, R4, R5: Booleano;
    Var opc, I: Entero;
    Var Autor, Tema, Etiqueta: Cadena;
    Repetir
        Mostrar << "¿De qué forma desea buscar una publicación?";
        Mostrar << "1: Por Autor";
        Mostrar << "2: Por Tema";
        Mostrar << "3: Por Etiqueta";
        Leer >> opc;
        Mientras (opc < 1 or opc > 3) Hacer;
            Mostrar << "Es invalido";
            Leer >> opc;
        Fin_Mientras
        En_Caso (opc > 0) Sea;
            Caso(opc = 1);
                Repetir
                    Mostrar << "Ingrese el autor que desea buscar";
                    Leer >> Autor;
                    Mostrar << Autor;
                    Mostrar << "¿Es correcto? 1: Sí, 0: No";
                    Leer >> R;
                    Hasta(R = 1);
                Fin_Repetir
                Para (I = 1 Hasta I = pub) Hacer;
                    Si (Autor = Publi[I].Autor) and (Publi[I].Activo = 1) Entonces;
                        Mostrar << Publi[I].Autor;
                        Mostrar << Publi[I].Tema;
                        Mostrar << Publi[I].Normas;
                        Mostrar << Publi[I].Texto;
                        Mostrar << Publi[I].Comentarios;
                        Mostrar << Publi[I].Cant_Reacciones;
                        Mostrar << Publi[I].Tipo_Reaccion1;
                        Mostrar << Publi[I].Tipo_Reaccion2;
                        Mostrar << Publi[I].Tipo_Reaccion3;
                        Mostrar << Publi[I].Etiqueta;
                        Opciones_Publicacion(Aux, Ver, react, com, re, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Cant_Reacciones, Com[J].Cant_Reacciones, Res[K].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Com[com].ID_Publicacion, Com[com].ID_Comentario, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta, Com[com].Comentario, Com[com].Fecha, Com[com].Autor, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Res[re].Comentario, Res[re].Autor, Res[re].Fecha);
                        Mostrar << Opciones_Publicacion;
                    Fin_Si
                Fin_Para
            Caso(opc = 2);
                Repetir
                    Mostrar << "Ingrese el tema que desea buscar:";
                    Leer >> Tema;
                    Mostrar << "¿Está seguro de que sea correcto? 1: Sí, 0: No";
                    Leer >> R2;
                    Hasta(R2 = 0);
                Fin_Repetir
                Para (I = 1 Hasta I = pub) Hacer;
                    Si (Tema = Publi[I].Tema) and (Publi[I].Activo = 1) Entonces;
                        Mostrar << Publi[I].Autor;
                        Mostrar << Publi[I].Tema;
                        Mostrar << Publi[I].Normas;
                        Mostrar << Publi[I].Texto;
                        Mostrar << Publi[I].Comentarios;
                        Mostrar << Publi[I].Reacciones;
                        Mostrar << Publi[I].Tipo_Reaccion1;
                        Mostrar << Publi[I].Tipo_Reaccion2;
                        Mostrar << Publi[I].Tipo_Reaccion3;
                        Mostrar << Publi[I].Etiqueta;
                        Opciones_Publicacion(Aux, Ver, react, com, re, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Cant_Reacciones, Com[J].Cant_Reacciones, Res[K].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Com[com].ID_Publicacion, Com[com].ID_Comentario, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta, Com[com].Comentario, Com[com].Fecha, Com[com].Autor, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Res[re].Comentario, Res[re].Autor, Res[re].Fecha);
                        Mostrar << Opciones_Publicacion;
                    Fin_Si
                Fin_Para
            Otro_Caso
                Repetir
                    Repetir
                        Mostrar << "Ingrese la etiqueta que desea buscar";
                        Leer >> Etiqueta;
                        Mostrar << Etiqueta;
                        Mostrar << "¿Es correcto? 1: Sí, 0: No";
                        Leer >> R3;
                        Hasta(R3 = 1);
                    Fin_Repetir
                    Para (I = 1 Hasta I = pub) Hacer;
                        Si (Etiqueta = Publi[I].Etiqueta) and (Publi[I].Activo = 1) Entonces;
                            Mostrar << Publi[I].Autor;
                            Mostrar << Publi[I].Tema;
                            Mostrar << Publi[I].Normas;
                            Mostrar << Publi[I].Texto;
                            Mostrar << Publi[I].Comentarios;
                            Mostrar << Publi[I].Reacciones;
                            Mostrar << Publi[I].Tipo_Reaccion1;
                            Mostrar << Publi[I].Tipo_Reaccion2;
                            Mostrar << Publi[I].Tipo_Reaccion3;
                            Mostrar << Publi[I].Etiqueta;
                            Opciones_Publicacion(Aux, Ver, react, com, re, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Cant_Reacciones, Com[J].Cant_Reacciones, Res[K].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Com[com].ID_Publicacion, Com[com].ID_Comentario, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta, Com[com].Comentario, Com[com].Fecha, Com[com].Autor, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Res[re].Comentario, Res[re].Autor, Res[re].Fecha);
                            Mostrar << Opciones_Publicacion;
                        Fin_Si
                    Fin_Para
                    Mostrar << "¿Desea buscar otro tema? 1: Sí, 0: No";
                    Leer >> R4;
                    Hasta(R4 = 0);
                Fin_Repetir
        Fin_Caso
        Mostrar << "¿Desea buscar otra publicación por distinto método? 1: Sí, 0: No";
        Leer >> R5;
        Hasta(R5 = 0);
    Fin_Repetir
Fin_Procedimiento