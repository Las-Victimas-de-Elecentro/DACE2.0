Inicio
    Var opc: Entero;
    Var R: Booleano;
    Repetir
        Mostrar << "¡Bienvenido a la sección Social Docente!";
        Mostrar << "¿Qué desea hacer?";
        Mostrar << "1: Mostrar Novedades";
        Mostrar << "2: Mostrar Grupos";
        Mostrar << "3: Sección de Amigos";
        Mostrar << "4: Marketplace";
        Mostrar << "5: Foro de Estudiantes";
        Mostrar << "6: Ayudas Sociales y de Animales";
        Leer >> opc;
        Mientras (opc < 1 or opc > 6) Hacer;
            Mostrar << "Es invalido";
            Leer >> opc;
        Fin_Mientras
        En_Caso (opc > 0) Sea;
            Caso(opc = 1);
                Mostrar_Novedades(Nov[I].Hecho, Nov[I].Fecha, Nov[I].Responsables, Nov[I].Contexto, Nov[I].Lugar);
                Mostrar << Mostrar_Novedades;
            Caso(opc = 2);
