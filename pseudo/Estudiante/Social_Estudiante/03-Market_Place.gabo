Procedimiento Market_Place (E/S: pos_usuario, M, Datos[pos_usuario].CI, MP[I].Cedula: Entero, Precio, Ingresos, Egresos, MP[I].Boveda, MP[I].Ingresos, MP[I].Egresos: Real, DTB, Datos[pos_usuario].Nombre, Datos[pos_usuario].Carrera, Datos[pos_usuario].Gmail, MP[I].Usuario, MP[I].Contacto, MP[I].Area, MP[I].Bitacora, MP[I].Datos_Bancarios, MP[I].Password: Booleano, [Procedimiento Ingresar_Producto(M, J2, MP[J2].Cedula, C_MP[I].Cedula, A_MP[I].Cedula, S_MP[I].Cedula, C_MP[I].Stock, A_MP[I].Stock, C_MP[I].Precio, A_MP[I].Precio, S_MP[I].Precio, MP[J2].Usuario, MP[J2].Contacto, MP[J2].Datos_Bancarios, C_MP[I].Vendedor, C_MP[I].Contacto, C_MP[I].Datos_Bancarios, C_MP[I].Producto, A_MP[I].Vendedor, A_MP[I].Contacto, A_MP[I].Datos_Bancarios, A_MP[I].Producto, S_MP[I].Vendedor, S_MP[I].Contacto, S_MP[I].Datos_Bancarios, S_MP[I].Producto, S_MP[I].Disp)], [Procedimiento Comprar_Producto(M, C_MP[I].Stock, A_MP[I].Stock, MP[I].Boveda, MP[I].Egresos, C_MP[I].Precio, C_MP[I].Ingresos, C_MP[I].Boveda, A_MP[I].Precio, A_MP[I].Ingresos, A_MP[I].Boveda, S_MP[I].Precio, S_MP[I].Ingresos, S_MP[I].Boveda, Precio, Egresos, Ingresos, MP[I].Bitacora, MP[I].Usuario, C_MP[I].Vendedor, C_MP[I].Contacto, C_MP[I].Producto, C_MP[I].Datos_Bancarios, C_MP[I].Bitacora, A_MP[I].Vendedor, A_MP[I].Contacto, A_MP[I].Producto, A_MP[I].Datos_Bancarios, A_MP[I].Bitacora, S_MP[I].Vendedor, S_MP[I].Contacto, S_MP[I].Producto, S_MP[I].Datos_Bancarios, S_MP[I].Bitacora, DTB, S_MP[I].Disp, validacion_pago, [Procedimiento metodo_pago(Egresos, Ingresos, Precio, DTB, validacion_pago)])], [Procedimiento Editar_Producto(M, Cedula, C_MP[I].Cedula, C_MP[I].Stock, A_MP[I].Cedula, A_MP[I].Stock, S_MP[I].Cedula, C_MP[I].Precio, A_MP[I].Precio, S_MP[I].Precio, C_MP[I].Producto, C_MP[I].Vendedor, C_MP[I].Contacto, C_MP[I].Datos_Bancarios, A_MP[I].Producto, A_MP[I].Vendedor, A_MP[I].Contacto, A_MP[I].Datos_Bancarios, S_MP[I].Disp)]);
Inicio
    Var Cedula, J3 = 3, Opc, I: Entero;
    Var Numero, Cedula2, Banco, Password1, Password2: Cadena;
    Var C_true, R1: Booleano;
    Mostrar << "Bienvenido al Market Place";
    Mostrar << "Siga las instrucciones a continuacion";
    Mostrar << "Por favor, ingrese su cedula";
    Leer >> Cedula;
    Mientras (Cedula != Datos[pos_usuario].CI) Hacer;
        Mostrar << "Su cedula no se encuentra en la base de datos de la universidad, por favor ingresela nuevamente";
        Leer >> Cedula;
    Fin_Mientras
    Repetir 
        Si (Cedula = MP[I].Cedula) Entonces;
            C_true = 1;
        Fin_Si
        Si (C_true = 0) Entonces;
            Mostrar << "Para poder entrar al Market Place amerita tener una cuenta registrada, por favor, cree su cuenta";
            Mostrar << "Solo ingrese si desea crear su cuenta para poder realizar automaticamente esta accion";
            Mostrar << "1: Si, 0: No";
            Leer >> R1;
            Si (R1 = 1) Entonces;
                Si (MP[I].Cedula = 0) Entonces;
                    MP[I].Usuario =               Datos[pos_usuario].Nombre;
                    MP[I].Cedula =                Datos[pos_usuario].CI;
                    MP[I].Contacto =              Datos[pos_usuario].Gmail;
                    MP[I].Area =                  Datos[pos_usuario].Carrera;
                    MP[I].Boveda =                0;
                    MP[I].Ingresos =              0;
                    MP[I].Egresos =               0;
                    MP[I].Bitacora =              null;
                    Mostrar << "Ingrese sus datos bancarios";
                    Mostrar << "Numero de telefono";
                    Leer >> Numero;
                    Mostrar << "Banco";
                    Leer >> Banco;
                    Mostrar << "Cedula";
                    Leer >> Cedula2;
                    MP[I].Datos_Bancarios = Numero + Banco + Cedula2;
                    Mostrar << "Usted ya se encuentra en la base de datos";
                    Mostrar << "Ingrese su contraseña";
                    Leer >> Password1;
                    Mostrar << "Confirme su contraseña";
                    Leer >> Password2;
                    Mientras (Password1 != Password2) Hacer;
                        Mostrar << "Error, vuelva a intentar";
                        Mostrar << "Ingrese su contraseña";
                        Leer >> Password1;
                        Mostrar << "Confirme su contraseña";
                        Leer >> Password2;
                    Fin_Mientras
                    MP[I].Password = Password1;
                Sino
                    M = M + 1;
                    MP[M].Usuario =               Datos[pos_usuario].Nombre;
                    MP[M].Cedula =                Datos[pos_usuario].CI;
                    MP[M].Contacto =              Datos[pos_usuario].Gmail;
                    MP[M].Area =                  Datos[pos_usuario].Carrera;
                    MP[M].Boveda =                0;
                    MP[M].Ingresos =              0;
                    MP[M].Egresos =               0;
                    MP[M].Bitacora =              null;
                    Mostrar << "Ingrese sus datos bancarios";
                    Mostrar << "Numero de telefono";
                    Leer >> Numero;
                    Mostrar << "Banco";
                    Leer >> Banco;
                    Mostrar << "Cedula";
                    Leer >> Cedula2;
                    MP[M].Datos_Bancarios = Numero + Banco + Cedula2;
                    Mostrar << "Usted ya se encuentra en la base de datos";
                    Mostrar << "Ingrese su contraseña";
                    Leer >> Password1;
                    Mostrar << "Confirme su contraseña";
                    Leer >> Password2;
                    Mientras (Password1 != Password2) Hacer;
                        Mostrar << "Error, vuelva a intentar";
                        Mostrar << "Ingrese su contraseña";
                        Leer >> Password1;
                        Mostrar << "Confirme su contraseña";
                        Leer >> Password2;
                    Fin_Mientras
                    MP[M].Password = Password1;
                Fin_Si
            Sino
                Mostrar << "Gracias por entrar al Market Place, nos vemos";
            Fin_Si
        Sino
            Mostrar << "Ingrese su contraseña: ";
            Leer >> Password2;
            Mientras (Password2 != MP[J2].Password) Hacer;
                Mostrar << "Error en la contraseña le quedan: ", J3, " Intentos";
                Leer >> Password2;
                J3 = J3 - 1;
                Si (J3 = 0) Entonces;
                    Password2 = MP[J2].Password;
                    R6 = 0;
                Fin_Si
            Fin_Mientras     
            Si (R6 = 1) Entonces;
                Mostrar << "Seleccione por favor alguna de las siguientes opciones";
                Mostrar << "--------------------------------------";
                Mostrar << "1-) Ingresar un prodcuto en el sistema";
                Mostrar << "2-) Comprar un producto";
                Mostrar << "3-) Editar un producto que ya posee";
                Mostrar << "--------------------------------------";
                Leer >> Opc;
                Mientras (Opc < 1 or Opc > 3) Hacer;
                    Mostrar << "La opcion selecionada no se encuentra dentro de los valores señalados previamente, por favor, intentelo nuevamente";
                    Leer >> Opc;
                Fin_Mientras
                Para (I = 1 Hasta I = M) Hacer;
                    Si (MP[I].Cedula = Cedula) Entonces;
                        J2 = I;
                    Fin_Si
                Fin_Para     
                En_Caso (Opc > 0) Sea;
                    Caso (Opc = 1);
                        Ingresar_Producto(M, J2, MP[J2].Cedula, C_MP[I].Cedula, A_MP[I].Cedula, S_MP[I].Cedula, C_MP[I].Stock, A_MP[I].Stock, C_MP[I].Precio, A_MP[I].Precio, S_MP[I].Precio, MP[J2].Usuario, MP[J2].Contacto, MP[J2].Datos_Bancarios, C_MP[I].Vendedor, C_MP[I].Contacto, C_MP[I].Datos_Bancarios, C_MP[I].Producto, A_MP[I].Vendedor, A_MP[I].Contacto, A_MP[I].Datos_Bancarios, A_MP[I].Producto, S_MP[I].Vendedor, S_MP[I].Contacto, S_MP[I].Datos_Bancarios, S_MP[I].Producto, S_MP[I].Disp);
                        Mostrar << Ingresar_Producto;
                    Caso (Opc = 2);
                        Comprar_Producto(M, C_MP[I].Stock, A_MP[I].Stock, MP[I].Boveda, MP[I].Egresos, C_MP[I].Precio, C_MP[I].Ingresos, C_MP[I].Boveda, A_MP[I].Precio, A_MP[I].Ingresos, A_MP[I].Boveda, S_MP[I].Precio, S_MP[I].Ingresos, S_MP[I].Boveda, Precio, Egresos, Ingresos, MP[I].Bitacora, MP[I].Usuario, C_MP[I].Vendedor, C_MP[I].Contacto, C_MP[I].Producto, C_MP[I].Datos_Bancarios, C_MP[I].Bitacora, A_MP[I].Vendedor, A_MP[I].Contacto, A_MP[I].Producto, A_MP[I].Datos_Bancarios, A_MP[I].Bitacora, S_MP[I].Vendedor, S_MP[I].Contacto, S_MP[I].Producto, S_MP[I].Datos_Bancarios, S_MP[I].Bitacora, DTB, S_MP[I].Disp, validacion_pago);
                        Mostrar << Comprar_Producto;
                    Otro_Caso
                        Editar_Producto(M, Cedula, C_MP[I].Cedula, C_MP[I].Stock, A_MP[I].Cedula, A_MP[I].Stock, S_MP[I].Cedula, C_MP[I].Precio, A_MP[I].Precio, S_MP[I].Precio, C_MP[I].Producto, C_MP[I].Vendedor, C_MP[I].Contacto, C_MP[I].Datos_Bancarios, A_MP[I].Producto, A_MP[I].Vendedor, A_MP[I].Contacto, A_MP[I].Datos_Bancarios, S_MP[I].Disp);
                        Mostrar << Editar_Producto;
                Fin_Caso
            Sino
                Mostrar << "Demasiados intentos fallidos";
            Fin_Si
        Fin_Si
        I = I + 1;
        Hasta(I = M);
    Fin_Repetir
Fin_Procedimiento