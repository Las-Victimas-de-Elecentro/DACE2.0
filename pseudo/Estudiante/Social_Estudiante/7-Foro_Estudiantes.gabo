    Tipo_Reaccion2: Cadena;
    Tipo_Reaccion3: Cadena;
Fin_Registro

Registro: Reacciones;           //Rea[]
    ID_Publicacion: Entero;
    ID_Comentario: Entero;
    ID_Respuesta: Entero;
    ID_Reacciones: Entero;
    Me_Gusta: Cadena;
    Cant_Gusta: Entero;
    Me_Encanta: Cadena;
    Cant_Encanta: Entero;
    Me_Importa: Cadena;
    Cant_Importa: Entero;
    Me_Divierte: Cadena;
    Cant_Divierte: Entero;
