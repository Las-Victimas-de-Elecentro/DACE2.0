Registro: Publicaciones;        //Publi[]
    ID_Publicacion: Entero;
    Autor: Cadena;
    Normas: Cadena;
    Tema: Cadena;
    Texto: Cadena;
    Fecha: Cadena;
    Comentarios: Entero;
    Cant_Reacciones: Entero;
    Tipo_Reaccion1: Cadena;
    Tipo_Reaccion2: Cadena;
    Tipo_Reaccion3: Cadena;
    Etiqueta: Cadena;
    Activo: Booleano;
Fin_Registro


Registro: Comentarios;          //Com[]
    ID_Publicacion: Entero;
    ID_Comentario: Entero;
    Autor: Cadena;
    Comentario: Cadena;
    Fecha: Cadena;
    Cant_Reacciones: Entero;
    Tipo_Reaccion1: Cadena;
    Tipo_Reaccion2: Cadena;
    Tipo_Reaccion3: Cadena;
Fin_Registro

Registro: Respuesta;        //Res[]
    ID_Comentario: Entero;
    ID_Respuesta: Entero;
    Autor: Cadena;
    Respuesta: Cadena;
    Fecha: Cadena;
