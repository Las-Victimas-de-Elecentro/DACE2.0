    Para (I = 1 Hasta I = react) Hacer;
        Para (J = 1 Hasta J = pub) Hacer;
            Si (Rea[I].ID_Publicacion = Publi[J].ID_Publicacion) Entonces;
                Si (Rea[I].Cant_Encanta > M1[I]) Entonces;
                    M1[I] = Rea[I].Cant_Encanta;
