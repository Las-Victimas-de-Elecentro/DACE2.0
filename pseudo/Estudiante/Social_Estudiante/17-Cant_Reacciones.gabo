Procedimiento Cant_Reacciones(E/S: react, pub, com, re, Rea[I].ID_Publicacion, Rea[I].ID_Comentario, Rea[I].ID_Respuesta, Publi[J].ID_Publicacion, Com[J].ID_Comentario, Res[J].ID_Respuesta, Rea[I].Cant_Gusta, Rea[I].Cant_Encanta, Rea[I].Cant_Importa, Rea[I].Cant_Divierte, Rea[I].Cant_Asombra, Rea[I].Cant_Entristece, Rea[I].Cant_Molesta: Entero, Rea[I].Me_Gusta, Rea[I].Me_Encanta, Rea[I].Me_Importa, Rea[I].Me_Divierte, Rea[I].Me_Asombra, Rea[I].Me_Entristece, Rea[I].Me_Molesta: Cadena);
Inicio
    Var I, J: Entero;
    Var M1[react]: Entero;
    Var M2[react]: Entero;
    Var M3[react]: Entero;
    Var G1[react]: Cadena;
    Var G2[react]: Cadena;
    Var G3[react]: Cadena;
    Para (I = 1 Hasta I = react) Hacer;
        M1[I] = Rea[I].Cant_Gusta;
        M2[I] = Rea[I].Cant_Gusta;
        M3[I] = Rea[I].Cant_Gusta;
        G1[I] = Rea[I].Me_Gusta;
