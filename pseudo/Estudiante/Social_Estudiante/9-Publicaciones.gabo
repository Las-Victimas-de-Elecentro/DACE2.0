Procedimiento Publicaciones(E/S: Aux, Ver, react, com, re, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Comentarios, Publi[Ver].Cant_Reacciones, Com[J].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Com[com].ID_Publicacion, Com[com].ID_Comentario, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta: Entero, Publi[Ver].Autor, Publi[Ver].Tema, Publi[Ver].Normas, Publi[Ver].Texto, Publi[Ver].Tipo_Reaccion1, Publi[Ver].Tipo_Reaccion2, Publi[Ver].Tipo_Reaccion3, Publi[Ver].Etiqueta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta, Com[com].Comentario, Com[com].Fecha, Com[com].Autor, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Res[re].Comentario, Res[re].Autor, Res[re].Fecha: Cadena, Publi[Ver].Activo: Booleano);
Inicio
    Var R, R2, R3: Booleano;
    Var Ver = 1, opc = 0, J: Entero;
    Ver = 1;
    Mostrar << "¿Desea ver las publicaciones disponibles? 1: Sí, 0: No";
    Leer >> R;
    Si (R = 1) Entonces;
        Repetir
            Si (Ver > Datos[pos_usuario].Vistos) and (Publi[Ver].Activo = 1) Entonces;
                Mostrar << Publi[Ver].ID_Publicacion;
                Mostrar << Publi[Ver].Autor;
                Mostrar << Publi[Ver].Tema;
                Mostrar << Publi[Ver].Normas;
                Mostrar << PublI[Ver].Texto;
                Mostrar << Publi[Ver].Comentarios;
                Mostrar << Publi[Ver].Cant_Reacciones;
                Mostrar << Publi[Ver].Tipo_Reaccion1;
                Mostrar << Publi[Ver].Tipo_Reaccion2;
                Mostrar << Publi[Ver].Tipo_Reaccion3;
                Mostrar << Publi[Ver].Etiqueta;
                Opciones_Publicacion(Aux, Ver, react, com, re, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Cant_Reacciones, Com[J].Cant_Reacciones, Res[K].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Com[com].ID_Publicacion, Com[com].ID_Comentario, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta, Com[com].Comentario, Com[com].Fecha, Com[com].Autor, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Res[re].Comentario, Res[re].Autor, Res[re].Fecha);
                Mostrar << Opciones_Publicacion;
            Fin_Si
            Hasta(R3 = 0);
        Fin_Repetir
    Sino
        Mostrar << "Volviendo al menú principal";
    Fin_Si
Fin_Procedimiento