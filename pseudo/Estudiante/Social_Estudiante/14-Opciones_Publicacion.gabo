Procedimiento Opciones_Publicacion(E/S: Aux, Ver, react, pub, Datos[pos_usuario].Vistos, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Cant_Reacciones, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones: Entero, R3: Booleano, [Procedimiento Agregar_Reaccion(Aux, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta)], [Procedimiento Comentar(com, Com[com].ID_Publicacion, Com[com].ID_Comentario, Com[com].Comentario, Com[com].Fecha, Com[com].Autor)], [Procedimiento Comentarios(Ver, re, react, Publi[Ver].ID_Publicacion, Publi[Ver].Comentarios, Com[J].ID_Publicacion, Com[J].ID_Comentario, Com[J].Cant_Reacciones, Res[K].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Rea[react].ID_Publicacion, Rea[react].ID_Comentario, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Com[J].Respuestas, Com[J].Autor, Com[J].Fecha, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Com[J].Comentario, Res[re].Comentario, Res[re].Autor, Res[re].Fecha, [Procedimiento Agregar_Reaccion(Aux, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta)])]);
Inicio
    Var opc: Entero;
    Mostrar << "¿Qué desea hacer?";
    Mostrar << "1: Reaccionar a la publicación";
    Mostrar << "2: Comentar la publicación";
    Mostrar << "3: Ver los comentarios";
    Mostrar << "4: Pasar a la siguiente publicación";
    Mostrar << "5: Salir al menú principal";
    Leer >> opc;
    Mientras (opc < 1 or opc > 5) Hacer;
        Mostrar << "Es invalido";
        Leer >> opc;
    Fin_Mientras

    En_Caso (opc > 0) Sea;
        Caso(opc = 1);
            Aux = Publi[Ver].ID_Publicacion;
            Rea[react].ID_Comentario = -1;
            Rea[react].ID_Publicacion = Aux;
            Rea[react].ID_Respuesta = -1;
            Rea[react].ID_Reacciones = react;
            Agregar_Reaccion(Aux, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta);
            Mostrar << Agregar_Reaccion;
            Publi[Ver].Cant_Reacciones = Publi[Ver].Cant_Reacciones + 1;
            react = react + 1;
        Caso(opc = 2);
            Comentar(com, Com[com].ID_Publicacion, Com[com].ID_Comentario, Com[com].Comentario, Com[com].Fecha, Com[com].Autor, Com[com].Imagen);
            Mostrar << Comentar;
            Publi[Ver].Comentarios = Publi[Ver].Comentarios + 1;
        Caso(opc = 3);
            Si (Publi[Ver].Comentarios > 0) Entonces;
                Mostrar << "¿Desea ver los comentarios? 1: Sí, 0: No";
                Leer >> R2;
                Si (R2 = 1) Entonces;
                    Comentarios(Ver, re, react, Publi[Ver].ID_Publicacion, Publi[Ver].Comentarios, Com[J].ID_Publicacion, Com[J].ID_Comentario, Com[J].Cant_Reacciones, Res[K].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Rea[react].ID_Publicacion, Rea[react].ID_Comentario, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Com[J].Respuestas, Com[J].Autor, Com[J].Fecha, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Com[J].Comentario, Res[re].Comentario, Res[re].Autor, Res[re].Fecha, Com[J].Imagen, Res[re].Imagen, [Procedimiento Agregar_Reaccion(Aux, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta)]);
                    Mostrar << Comentarios;
                Fin_Si
            Sino
                Mostrar << "No hay comentarios disponibles.";
            Fin_Si
        Caso(opc = 4);
            Si (Ver = pub) Entonces;
                R3 = 0;
                Mostrar << "Ya vió todas las publicaciones, saliendo al menú principal";
            Sino
                Ver = Ver + 1;
            Fin_Si
            Datos[pos_usuario].Vistos = Datos[pos_usuario].Vistos + 1;
        Otro_Caso
            R3 = 0;
    Fin_Caso
Fin_Procedimiento