Registro: Market_Place;         // MP[N];
    Usuario: Cadena;
    Cedula: Entero;
    Contacto: Cadena;
    Password: Cadena;
    Datos_Bancarios: Cadena;
    Area: Cadena;
    Boveda: Real;
    Ingresos: Real;
    Egresos: Real;
    Bitacora: Cadena;
Fin_Registro

Registro: Comida_MP;            // C_MP[N];
    Vendedor: Cadena;
    Cedula: Entero;
    Contacto: Cadena;
    Datos_Bancarios: Cadena;
    Producto: Cadena;
    Stock: Entero;
    Precio: Real;
Fin_Registro

Registro: Articulos_MP;         //A_MP[N];
    Vendedor: Cadena;
    Cedula: Entero;
    Contacto: Cadena;
    Datos_Bancarios: Cadena;
    Producto: Cadena;
    Stock: Entero;
    Precio: Real;
Fin_Registro

Registro: Servicios_MP;         //S_MP[N];
    Vendedor: Cadena;
    Cedula: Entero;
    Disp: Booleano;
    Precio: Real;
    Contacto: Cadena;
    Datos_Bancarios: Cadena;
    Producto: Cadena;
Fin_Registro

Procedimiento Market_Place (E/S: N, Datos[pos_usuario].CI, MP[I].Cedula, C_MP[I].Cedula, C_MP[I].Stock, A_MP[I].Cedula, A_MP[I].Stock, S_MP[I].Cedula: Entero, Precio, Ingresos, Egresos, MP[I].Boveda, MP[I].Ingresos, MP[I].Egresos, C_MP[I].Precio, A_MP[I].Precio, S_MP[I].Precio: Real, DTB, Datos[pos_usuario].Nombre, Datos[pos_usuario].Carrera, Datos[pos_usuario].Gmail, MP[I].Usuario, MP[I].Contacto, MP[I].Area, MP[I].Bitacora, MP[I].Datos_Bancarios, MP[I].Password, C_MP[I].Vendedor, C_MP[I].Contacto, C_MP[I].Datos_Bancarios, C_MP[I].Producto, A_MP[I].Vendedor, A_MP[I].Contacto, A_MP[I].Contacto, A_MP[I].Datos_Bancarios, A_MP[I].Producto, S_MP[I].Vendedor, S_MP[I].Contacto, S_MP[I].Datos_Bancarios, S_MP[I].Producto: Cadena, validacion_pago, S_MP[I].Disp: Booleano);
Inicio
    Var Cedula, J2, J3 = 3, Opc, Opc2, Opc3, I, R3, Q1, Q5 = 1, Unidades, K = 2, K2, K3, Jose_Lozano[K]: Entero;
    Var Numero, Cedula2, Banco, Password1, Password2: Cadena;
    Var C_true, R1, R4, R6, R7, Q2, Q3, Q4, K4, K6 = 0: Booleano;
    Mostrar << "Bienvenido al Market Place";
    Mostrar << "Siga las instrucciones a continuacion";
    Mostrar << "Por favor, ingrese su cedula";
    Leer >> Cedula;
    Mientras (Cedula != Datos[pos_usuario].CI) Hacer;
        Mostrar << "Su cedula no se encuentra en la base de datos de la universidad, por favor ingresela nuevamente";
        Leer >> Cedula;
    Fin_Mientras
    Repetir 
        Si (Cedula = MP[I].Cedula) Entonces;
            C_true = 1;
        Fin_Si
        Si (C_true = 0) Entonces;
            Mostrar << "Para poder entrar al Market Place amerita tener una cuenta registrada, por favor, cree su cuenta";
            Mostrar << "Solo ingrese si desea crear su cuenta para poder realizar automaticamente esta accion";
            Mostrar << "1: Si, 0: No";
            Leer >> R1;
            Si (R1 = 1) Entonces;
                Si (MP[I].Cedula = 0) Entonces;
                    MP[I].Usuario =               Datos[pos_usuario].Nombre;
                    MP[I].Cedula =                Datos[pos_usuario].CI;
                    MP[I].Contacto =              Datos[pos_usuario].Gmail;
                    MP[I].Area =                  Datos[pos_usuario].Carrera;
                    MP[I].Boveda =                0;
                    MP[I].Ingresos =              0;
                    MP[I].Egresos =               0;
                    MP[I].Bitacora =              " ";
                    Mostrar << "Ingrese sus datos bancarios";
                    Mostrar << "Numero de telefono";
                    Leer >> Numero;
                    Mostrar << "Banco";
                    Leer >> Banco;
                    Mostrar << "Cedula";
                    Leer >> Cedula2;
                    MP[I].Datos_Bancarios = Numero + Banco + Cedula2;
                    Mostrar << "Usted ya se encuentra en la base de datos";
                    Mostrar << "Ingrese su contraseña";
                    Leer >> Password1;
                    Mostrar << "Confirme su contraseña";
                    Leer >> Password2;
                    Mientras (Password1 != Password2) Hacer;
                        Mostrar << "Error, vuelva a intentar";
                        Mostrar << "Ingrese su contraseña";
                        Leer >> Password1;
                        Mostrar << "Confirme su contraseña";
                        Leer >> Password2;
                    Fin_Mientras
                    MP[I].Password = Password1;
                Sino
                    N = N + 1;
                    MP[N].Usuario =               Datos[pos_usuario].Nombre;
                    MP[N].Cedula =                Datos[pos_usuario].CI;
                    MP[N].Contacto =              Datos[pos_usuario].Gmail;
                    MP[N].Area =                  Datos[pos_usuario].Carrera;
                    MP[N].Boveda =                0;
                    MP[N].Ingresos =              0;
                    MP[N].Egresos =               0;
                    MP[N].Bitacora =              " ";
                    Mostrar << "Ingrese sus datos bancarios";
                    Mostrar << "Numero de telefono";
                    Leer >> Numero;
                    Mostrar << "Banco";
                    Leer >> Banco;
                    Mostrar << "Cedula";
                    Leer >> Cedula2;
                    MP[N].Datos_Bancarios = Numero + Banco + Cedula2;
                    Mostrar << "Usted ya se encuentra en la base de datos";
                    Mostrar << "Ingrese su contraseña";
                    Leer >> Password1;
                    Mostrar << "Confirme su contraseña";
                    Leer >> Password2;
                    Mientras (Password1 != Password2) Hacer;
                        Mostrar << "Error, vuelva a intentar";
                        Mostrar << "Ingrese su contraseña";
                        Leer >> Password1;
                        Mostrar << "Confirme su contraseña";
                        Leer >> Password2;
                    Fin_Mientras
                    MP[N].Password = Password1;
                Fin_Si
            Sino
                Mostrar << "Gracias por entrar al Market Place, nos vemos";
            Fin_Si
        Sino
            Mostrar << "Ingrese su contraseña: ";
            Leer >> Password2;
            Mientras (Password2 != MP[J2].Password) Hacer;
                Mostrar << "Error en la contraseña le quedan: ", J3, " Intentos";
                Leer >> Password2;
                J3 = J3 - 1;
                Si (J3 = 0) Entonces;
                    Password2 = MP[J2].Password;
                    R6 = 0;
                Fin_Si
            Fin_Mientras     
            Si (R6 = 1) Entonces;
                Mostrar << "Seleccione por favor alguna de las siguientes opciones";
                Mostrar << "--------------------------------------";
                Mostrar << "1-) Ingresar un prodcuto en el sistema";
                Mostrar << "2-) Comprar un producto";
                Mostrar << "3-) Editar un producto que ya posee";
                Mostrar << "--------------------------------------";
                Leer >> Opc;
                Mientras (Opc < 1 or Opc > 3) Hacer;
                    Mostrar << "La opcion selecionada no se encuentra dentro de los valores señalados previamente, por favor, intentelo nuevamente";
                    Leer >> Opc;
                Fin_Mientras
                Para (I = 1 Hasta I = N) Hacer;
                    Si (MP[I].Cedula = Cedula) Entonces;
                        J2 = I;
                    Fin_Si
                Fin_Para     
                En_Caso (Opc > 0) Sea;
                    Caso (Opc = 1);
                        Mostrar << "Ingrese el tipo de producto que es de las siguientes 3 opciones";
                        Mostrar << "1-) Comida";
                        Mostrar << "2-) Articulos";
                        Mostrar << "3-) Servicios";
                        Leer >> R3;
                        Mientras (R3 < 1 or R3 > 3) Hacer;
                            Mostrar << "Opcion seleccionada erronea, vuelvalo a intentar";
                            Mostrar << "1-) Comida";
                            Mostrar << "2-) Articulos";
                            Mostrar << "3-) Servicios";
                            Leer >> R3;
                        Fin_Mientras
                        En_Caso (R3 > 0) Sea;
                            Caso (R3 = 1);
                                Para (I = 1 Hasta I = N) Hacer;
                                    Si (C_MP[I].Cedula = 0) Entonces;
                                        C_MP[I].Vendedor =            MP[J2].Usuario;
                                        C_MP[I].Cedula =              MP[J2].Cedula;
                                        C_MP[I].Contacto =            MP[J2].Contacto;
                                        C_MP[I].Datos_Bancarios =     MP[J2].Datos_Bancarios;
                                        Mostrar << "Ingrese el producto a vender (solo mayusculas)";
                                        Leer >> C_MP[I].Producto;
                                        Mostrar << "Ingrese el stock del producto (1-25)";
                                        Leer >> C_MP[I].Stock;
                                        Mientras (C_MP[I].Stock < 1 or C_MP[I].Stock > 25) Hacer;
                                            Mostrar << "Rango de sotck erroneo, intentelo neuvamente";
                                            Leer >> C_MP[I].Stock;
                                        Fin_Mientras
                                        Mostrar << "Ingrese el precio";
                                        Leer >> C_MP[I].Precio;
                                        Mientras (C_MP[I].Precio < 0) hacer;
                                            Mostrar << "Precio ingresado equivocado";
                                            Leer >> C_MP[I].Precio;
                                        Fin_Mientras
                                        Mostrar << "Ahora su producto se encuentra en la sección de comida del Market Place";
                                        R4 = 1;
                                    Fin_Si
                                    Si (C_MP[I].Cedula != 0) Entonces;
                                        R4 = 1;
                                    Fin_Si
                                Fin_Para
                                Si (R4 = 1) Entonces;
                                    N = N + 1;
                                    C_MP[N].Vendedor =            MP[J2].Usuario;
                                    C_MP[N].Cedula =              MP[J2].Cedula;
                                    C_MP[N].Contacto =            MP[J2].Contacto;
                                    C_MP[N].Datos_Bancarios =     MP[J2].Datos_Bancarios;
                                    Mostrar << "Ingrese el producto a vender (solo mayusculas)";
                                    Leer >> C_MP[N].Producto;
                                    Mostrar << "Ingrese el stock del producto (1-25)";
                                    Leer >> C_MP[N].Stock;
                                    Mientras (C_MP[N].Stock < 1 or C_MP[N].Stock > 25) Hacer;
                                        Mostrar << "Rango de sotck erroneo, intentelo neuvamente";
                                        Leer >> C_MP[N].Stock;
                                    Fin_Mientras
                                    Mostrar << "Ingrese el precio";
                                    Leer >> C_MP[N].Precio;
                                    Mientras (C_MP[N].Precio < 0) Hacer;
                                        Mostrar << "Precio ingresado equivocado";
                                        Leer >> C_MP[N].Precio;
                                    Fin_Mientras
                                    Mostrar << "Ahora su producto se encuentra en la seccion de comida del Market Place";
                                Fin_Si
                            Caso (R3 = 2);
                                Para (I = 1 Hasta I = N) Hacer;
                                    Si (A_MP[I].Cedula = 0) Entonces;
                                        A_MP[I].Vendedor =            MP[J2].Usuario;
                                        A_MP[I].Cedula =              MP[J2].Cedula;
                                        A_MP[I].Contacto =            MP[J2].Contacto;
                                        A_MP[I].Datos_Bancarios =     MP[J2].Datos_Bancarios;
                                        Mostrar << "Ingrese el producto a vender (solo mayusculas)";
                                        Leer >> A_MP[I].Producto;
                                        Mostrar << "Ingrese el stock del producto (1-25)";
                                        Leer >> A_MP[I].Stock;
                                        Mientras (A_MP[I].Stock < 1 or A_MP[I].Stock > 25) Hacer;
                                            Mostrar << "Rango de sotck erroneo, intentelo neuvamente";
                                            Leer >> A_MP[I].Stock;
                                        Fin_Mientras
                                        Mostrar << "Ingrese el precio";
                                        Leer >> A_MP[I].Precio;
                                        Mientras (A_MP[I].Precio < 0) hacer;
                                            Mostrar << "Precio ingresado equivocado";
                                            Leer >> A_MP[I].Precio;
                                        Fin_Mientras
                                        Mostrar << "Ahora su producto se encuentra en la seccion de articulos del Market Place";
                                        R4 = 1;
                                    Fin_Si
                                    Si (A_MP[I].Cedula != 0) Entonces;
                                        R4 = 1;
                                    Fin_Si
                                Fin_Para
                                Si (R4 = 1) Entonces;
                                    N = N + 1;
                                    A_MP[N].Vendedor =            MP[J2].Usuario;
                                    A_MP[N].Cedula =              MP[J2].Cedula;
                                    A_MP[N].Contacto =            MP[J2].Contacto;
                                    A_MP[N].Datos_Bancarios =     MP[J2].Datos_Bancarios;
                                    Mostrar << "Ingrese el producto a vender (solo mayusculas)";
                                    Leer >> A_MP[N].Producto;
                                    Mostrar << "Ingrese el stock del producto (1-25)";
                                    Leer >> A_MP[N].Stock;
                                    Mientras (A_MP[N].Stock < 1) or (A_MP[N].Stock > 25) Hacer;
                                        Mostrar << "Rango de sotck erroneo, intentelo neuvamente";
                                        Leer >> A_MP[N].Stock;
                                    Fin_Mientras
                                    Mostrar << "Ingrese el precio";
                                    Leer >> A_MP[N].Precio;
                                    Mientras (A_MP[N].Precio < 0) hacer;
                                        Mostrar << "Precio ingresado equivocado";
                                        Leer >> A_MP[N].Precio;
                                    Fin_Mientras
                                    Mostrar << "Ahora su producto se encuentra en la sección de articulos del Market Place";
                                Fin_Si
                            Otro_Caso
                                Para (I = 1 Hasta I = N) Hacer;
                                    Si (S_MP[I].Cedula = 0) Entonces;
                                        S_MP[I].Vendedor =            MP[J2].Usuario;
                                        S_MP[I].Cedula =              MP[J2].Cedula;
                                        S_MP[I].Contacto =            MP[J2].Contacto;
                                        S_MP[I].Datos_Bancarios =     MP[J2].Datos_Bancarios;
                                        Mostrar << "Ingrese del servicio a proporcionar (solo mayusculas)";
                                        Leer >> S_MP[I].Producto;
                                        Mostrar << "Ingrese su disponibilidad 1: Si hay, 0: No hay";
                                        Leer >> S_MP[I].Disp;
                                        Mostrar << "Ingrese el precio";
                                        Leer >> S_MP[I].Precio;
                                        Mientras (S_MP[I].Precio < 0) Hacer;
                                            Mostrar << "Precio ingresado equivocado";
                                            Leer >> S_MP[I].Precio;
                                        Fin_Mientras
                                        Mostrar << "Ahora su producto se encuentra en la sección de servicios del Market Place";
                                        R4 = 1;
                                    Fin_Si
                                    Si (S_MP[I].Cedula != 0) Entonces;
                                        R4 = 1;
                                    Fin_Si
                                Fin_Para
                                Si (R4 = 1) Entonces;
                                    N = N + 1;
                                    S_MP[N].Vendedor =            MP[J2].Usuario;
                                    S_MP[N].Cedula =              MP[J2].Cedula;
                                    S_MP[N].Contacto =            MP[J2].Contacto;
                                    S_MP[N].Datos_Bancarios =     MP[J2].Datos_Bancarios;
                                    Mostrar << "Ingrese del servicio a proporcionar (solo mayusculas)";
                                    Leer >> S_MP[N].Producto;
                                    Mostrar << "Ingrese su disponibilidad 1: Si hay, 0: No hay";
                                    Leer >> S_MP[N].Disp;
                                    Mostrar << "Ingrese el precio";
                                    Leer >> S_MP[N].Precio;
                                    Mientras (S_MP[N].Precio < 0) Hacer;
                                        Mostrar << "Precio ingresado equivocado";
                                        Leer >> S_MP[N].Precio;
                                    Fin_Mientras
                                    S_MP[N].Contacto = MP[J2].Contacto;
                                    Mostrar << "Ahora su producto se encuentra en la sección de servicios del Market Place";
                                    R4 = 1;
                                Fin_Si
                        Fin_Caso
                    Caso (Opc = 2);
                        Mostrar << "Bienvenido a la seccion de compra";
                        Mostrar << "Ingrese mediente numeros en cual de las siguientes 3 secciones está interesado";
                        Repetir
                            Mostrar << "1-) Comida";
                            Mostrar << "2-) Articulos";
                            Mostrar << "3-) Servicios";
                            Leer >> Opc3;
                            Mientras (Opc3 < 1 or Opc3 > 3) Hacer;
                                Mostrar << "Su opcion seleccioanda esta fuera del rango señalado, por favor, ingreselo nuevamente";
                                Leer >> Opc3;
                            Fin_Mientras
                            En_Caso (Opc3 > 0) Sea;
                                Caso (Opc3 = 1);
                                    Para (I = 1 Hasta I = N) Hacer;
                                        Si (C_MP[I].Stock > 0) Entonces;
                                            Mostrar << "Producto numero: ", I;
                                            Mostrar << "Vendedor: ", C_MP[I].Vendedor;
                                            Mostrar << "Contacto: ", C_MP[I].Contacto;
                                            Mostrar << "Producto: ", C_MP[I].Producto;
                                            Mostrar << "Stock: ", C_MP[I].Stock;
                                            Mostrar << "Precio: ", C_MP[I].Precio;
                                            Q5 = Q5 + 1;
                                        Fin_Si
                                    Fin_Para
                                    Mostrar << "Ingrese si le intereso algun producto 1: Si, 0: No";
                                    Leer >> Q2;
                                    Si (Q2 = 1) Entonces;
                                        Mostrar << "Ingrese el numero del producto que le intereso";
                                        Leer >> Q1;
                                        Mientras (Q1 < 0 or Q1 > Q5) Hacer;
                                            Mostrar << "El producto ingresado no se encuentra dentro de los rangos, por favor, ingreselo nuevamente";
                                            Leer >> Q1;
                                        Fin_Mientras
                                        Mostrar << "Ingrese cuantas Unidades desea";
                                        Leer >> Unidades;
                                        Mientras (Unidades < 1 or Unidades > C_MP[Q1].Stock) Hacer;
                                            Mostrar << "La cantidad ingresada es invalida, ingrese algo inferior o igual a Stock y que sea superior a 0";
                                            Leer >> Unidades;
                                        Fin_Mientras
                                        DTB = C_MP[Q1].Datos_Bancarios;
                                        Precio = C_MP[Q1].Precio;
                                        metodo_pago(Egresos, Ingresos, Precio, DTB, validacion_pago);
                                        Mostrar << metodo_pago;
                                        Si (Validacion_pago = 1) Entonces;
                                            C_MP[Q1].Ingresos = C_MP[Q1].Ingresos + Ingresos;
                                            C_MP[Q1].Boveda = C_MP[Q1].Boveda + Ingresos;
                                            MP[J2].Boveda = MP[J2].Boveda - Egresos;
                                            MP[J2].Egresos = MP[J2].Egresos + Egresos;
                                            C_MP[Q1].Stock = C_MP[Q1].Stock - Unidades;
                                            C_MP[Q1].Bitacora = C_MP[Q1].Bitacora + ("Usted gano: ", Precio, "dinero  con el producto ", C_MP[Q1].Producto, " atribuido por ", MP[J2].Usuario);
                                            MP[J2].Bitacora = MP[J2].Bitacora + ("Usted gasto: ", Precio, "dinero con el producto ", C_MP[Q1].Producto, "Del cual es dueño", C_MP[Q1].Vendedor);
                                            Mostrar << "Gracias por su compra";
                                        Sino
                                            Mostrar << "Mamaste no hay rial";
                                            Mostrar << "Posdata, si llegaste a leer este pedazo de codigo que sepas que Felipe lo esta haciendo un 26 de diciembre a las 12 de la noche mamado del codigo";
                                            Mostrar << "Gracias";
                                        Fin_Si
                                    Sino 
                                        Mostrar << "¿Desea finalizar la sesión? 1: Sí, 0: No";
                                        Leer >> Q3;
                                        Si (Q3 = 1) Entonces;
                                            Q4 = 1;
                                        Sino 
                                            Q4 = 0;
                                        Fin_Si
                                    Fin_Si
                                Caso (Opc3 = 2);
                                    Para (I = 1 Hasta I = N) Hacer;
                                        Si (A_MP[I].Stock > 0) Entonces;
                                            Mostrar << "Producto numero: ", I;
                                            Mostrar << "Vendedor: ", A_MP[I].Vendedor;
                                            Mostrar << "Contacto: ", A_MP[I].Contacto;
                                            Mostrar << "Producto: ", A_MP[I].Producto;
                                            Mostrar << "Stock: ", A_MP[I].Stock;
                                            Mostrar << "Precio: ", A_MP[I].Precio;
                                            Q5 = Q5 + 1;
                                        Fin_Si
                                    Fin_Para
                                    Mostrar << "Ingrese si le interesó algun producto 1: Sí, 0: No";
                                    Leer >> Q2;
                                    Si (Q2 = 1) Entonces;
                                        Mostrar << "Ingrese el numero del producto que le intereso";
                                        Leer >> Q1;
                                        Mientras (Q1 < 0 or Q1 > Q5) Hacer;
                                            Mostrar << "El producto ingresado no se encuentra dentro de los rangos, por favor, ingreselo nuevamente";
                                            Leer >> Q1;
                                        Fin_Mientras
                                        Mostrar << "Ingrese cuantas Unidades desea";
                                        Leer >> Unidades;
                                        Mientras (Unidades < 1) or (Unidades > A_MP[Q1].Stock) Hacer;
                                            Mostrar << "La cantidad ingresada es invalida, ingrese algo inferior o igual a Stock y que sea superior a 0";
                                            Leer >> Unidades;
                                        Fin_Mientras
                                        DTB = A_MP[Q1].Datos_Bancarios;
                                        Precio = A_MP[Q1].Precio;
                                        metodo_pago(Egresos, Ingresos, Precio, DTB, validacion_pago);
                                        Si (validacion_pago = 1) Entonces;
                                            Mostrar << metodo_pago;
                                            A_MP[Q1].Ingresos = A_MP[Q1].Ingresos + Ingresos;
                                            A_MP[Q1].Boveda = A_MP[Q1].Boveda + Ingresos;
                                            MP[J2].Boveda = MP[J2].Boveda - Egresos;
                                            MP[J2].Egresos = MP[J2].Egresos + Egresos;
                                            A_MP[Q1].Stock = A_MP[Q1].Stock - Unidades;
                                            A_MP[Q1].Bitacora = A_MP[Q1].Bitacora + ("Usted gano: ", Precio, "dinero  con el producto ", A_MP[Q1].Producto, " atribuido por ", MP[J2].Usuario);
                                            MP[J2].Bitacora = MP[J2].Bitacora + ("Usted gasto: ", Precio, "dinero con el producto ", A_MP[Q1].Producto, "Del cual es dueño", A_MP[Q1].Vendedor);
                                            Mostrar << "Gracias por su compra";
                                        Sino
                                            Mostrar << "El pago no puedo ser efectuado, la compra no fue realizada";
                                        Fin_Si
                                    Sino 
                                        Mostrar << "Desea finalizar la sesión 1: Sí, 0: No";
                                        Leer >> Q3;
                                        Si (Q3 = 1) Entonces;
                                            Q4 = 1;
                                        Sino 
                                            Q4 = 0;
                                        Fin_Si
                                    Fin_Si
                                Otro_Caso
                                    Para (I = 1 Hasta I = N) Hacer;
                                        Si (S_MP[I].Disp = 1) Entonces;
                                            Mostrar << "Producto numero: ", I;
                                            Mostrar << "Vendedor: ", S_MP[I].Vendedor;
                                            Mostrar << "Contacto: ", S_MP[I].Contacto;
                                            Mostrar << "Producto: ", S_MP[I].Producto;
                                            Mostrar << "Disponibilidad: ", S_MP[I].Disp;
                                            Mostrar << "Precio: ", S_MP[I].Precio;
                                            Q5 = Q5 + 1;
                                        Fin_Si
                                    Fin_Para
                                    Mostrar << "Ingrese si le interesó algun producto 1: Sí, 0: No";
                                    Leer >> Q2;
                                    Si (Q2 = 1) Entonces;
                                        Mostrar << "Ingrese el numero del producto que le intereso";
                                        Leer >> Q1;
                                        Mientras (Q1 < 0 or Q1 > Q5) Hacer;
                                            Mostrar << "El producto ingresado no se encuentra dentro de los rangos, por favor, ingreselo nuevamente";
                                            Leer >> Q1;
                                        Fin_Mientras
                                        Mostrar << "Utilice el contacto del Usuario para contactarse con el";
                                        DTB = S_MP[Q1].Datos_Bancarios;
                                        Precio = S_MP[Q1].Precio;
                                        metodo_pago(Egresos, Ingresos, Precio, DTB, validacion_pago);
                                        Mostrar << metodo_pago;
                                        Si (Validacion_Pago = 1) Entonces;
                                            S_MP[Q1].Ingresos = S_MP[Q1].Ingresos + Ingresos;
                                            S_MP[Q1].Boveda = S_MP[Q1].Boveda + Ingresos;
                                            MP[J2].Boveda = MP[J2].Boveda - Egresos;
