        Mostrar << "2: Ver publicaciones";
        Mostrar << "3: Buscar publicación por un tema en específico";
        Mostrar << "4: Ver tus publicaciones para decidir si editarla, borrarla u ocultarla";
        Mostrar << "5: Ranking de Publicaciones";
        Leer >> opc;
        Mientras (opc < 1 or opc > 5) Hacer;
