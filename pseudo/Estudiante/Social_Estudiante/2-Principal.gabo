Procedimiento Social_Estudiante(E/S: I, J, Am, N, Aux, Ver, react, com, re, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Comentarios, Publi[Ver].Cant_Reacciones, Com[J].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Com[com].ID_Publicacion, Com[com].ID_Comentario, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta: Entero, Nov[I].Hecho, Nov[I].Fecha, Nov[I].Responsables, Nov[I].Contexto, Nov[I].Lugar, Gru[I].Nombre_Profesor, Gru[I].Codigo_Materia, Prof[J].Nombre, Prof[J].Materias, Amig[Am].Nombre_Emisor, Amig[Am].Nombre_Receptor, Amig[Am].Avatar_Receptor, Admin[J].Usuario, Admin[J].Cargo, Datos[J].Nombre, Datos[J].Avatar, Datos[J].Carrera, DTB, Datos[pos_usuario].Gmail, MP[I].Usuario, MP[I].Contacto, MP[I].Area, MP[I].Bitacora, MP[I].Datos_Bancarios, MP[I].Password, C_MP[I].Vendedor, C_MP[I].Contacto, C_MP[I].Datos_Bancarios, C_MP[I].Producto, A_MP[I].Vendedor, A_MP[I].Contacto, A_MP[I].Contacto, A_MP[I].Datos_Bancarios, A_MP[I].Producto, S_MP[I].Vendedor, S_MP[I].Contacto, S_MP[I].Datos_Bancarios, S_MP[I].Producto, Publi[Ver].Autor, Publi[Ver].Tema, Publi[Ver].Normas, Publi[Ver].Texto, Publi[Ver].Tipo_Reaccion1, Publi[Ver].Tipo_Reaccion2, Publi[Ver].Tipo_Reaccion3, Publi[Ver].Etiqueta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta, Com[com].Comentario, Com[com].Fecha, Com[com].Autor, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Res[re].Comentario, Res[re].Autor, Res[re].Fecha: Cadena, Gru[I].Miembros, Gru[I].Seccion, Prof[pos].CI, Amig[Am].CI_Emisor, Amig[Am].CI_Receptor, Prof[pos].Amigos, Datos[J].Semestre, Datos[J].Year, Prof[J].Cant_Materias, Datos[J].CI, C_MP[I].Cedula, C_MP[I].Stock, A_MP[I].Cedula, A_MP[I].Stock, S_MP[I].Cedula: Entero, Precio, Ingresos, Egresos, MP[I].Ingresos, MP[I].Egresos, MP[I].Boveda, C_MP[I].Precio, A_MP[I].Precio, S_MP[I].Precio: Real, validacion_pago, S_MP[I].Disp, Publi[I].Activo: Booleano);
Inicio
    Var opc: Entero;
    Var R: Booleano;
    Repetir
        Mostrar << "¡Bienvenido a la sección Social Docente!";
        Mostrar << "¿Qué desea hacer?";
        Mostrar << "1: Mostrar Novedades";
        Mostrar << "2: Mostrar Grupos";
        Mostrar << "3: Sección de Amigos";
        Mostrar << "4: Marketplace";
        Leer >> opc;
        Mientras (opc < 1 or opc > 4) Hacer;
            Mostrar << "Es invalido";
            Leer >> opc;
        Fin_Mientras
        En_Caso (opc > 0) Sea;
            Caso(opc = 1);
                Mostrar_Novedades(Nov[I].Hecho, Nov[I].Fecha, Nov[I].Responsables, Nov[I].Contexto, Nov[I].Lugar);
                Mostrar << Mostrar_Novedades;
            Caso(opc = 2);
                Mostrar_Grupos(I, Gru[I].Nombre_Profesor, Gru[I].Codigo_Materia, Gru[I].Miembros, Gru[I].Seccion);
                Mostrar << Mostrar_Grupos;
            Caso(opc = 3);
                Amigos_Estudiante(Am, Prof[J].Nombre, Prof[J].Materias, Amig[Am].Nombre_Emisor, Amig[Am].Nombre_Receptor, Amig[Am].Avatar_Receptor, Admin[J].Usuario, Admin[J].Cargo, Datos[J].Nombre, Datos[J].Avatar, Datos[J].Carrera, Prof[pos].CI, Amig[Am].CI_Emisor, Amig[Am].CI_Receptor, Prof[pos].Amigos, Datos[J].Semestre, Datos[J].Year, Prof[J].Cant_Materias);
                Mostrar << Amigos_Estudiante;
            Caso(opc = 4);
                Market_Place(N, Datos[pos_usuario].CI, MP[I].Cedula, C_MP[I].Cedula, C_MP[I].Stock, A_MP[I].Cedula, A_MP[I].Stock, S_MP[I].Cedula, Precio, Ingresos, Egresos, MP[I].Boveda, MP[I].Ingresos, MP[I].Egresos, C_MP[I].Precio, A_MP[I].Precio, S_MP[I].Precio, DTB, Datos[pos_usuario].Nombre, Datos[pos_usuario].Carrera, Datos[pos_usuario].Gmail, MP[I].Usuario, MP[I].Contacto, MP[I].Area, MP[I].Bitacora, MP[I].Datos_Bancarios, MP[I].Password, C_MP[I].Vendedor, C_MP[I].Contacto, C_MP[I].Datos_Bancarios, C_MP[I].Producto, A_MP[I].Vendedor, A_MP[I].Contacto, A_MP[I].Contacto, A_MP[I].Datos_Bancarios, A_MP[I].Producto, S_MP[I].Vendedor, S_MP[I].Contacto, S_MP[I].Datos_Bancarios, S_MP[I].Producto, validacion_pago, S_MP[I].Disp);
                Mostrar << Market_Place;
            Otro_Caso
                Foro_Estudiantes(Aux, Ver, react, com, re, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Comentarios, Publi[Ver].Cant_Reacciones, Com[J].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Com[com].ID_Publicacion, Com[com].ID_Comentario, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Publi[Ver].Autor, Publi[Ver].Tema, Publi[Ver].Normas, Publi[Ver].Texto, Publi[Ver].Tipo_Reaccion1, Publi[Ver].Tipo_Reaccion2, Publi[Ver].Tipo_Reaccion3, Publi[Ver].Etiqueta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta, Com[com].Comentario, Com[com].Fecha, Com[com].Autor, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Res[re].Comentario, Res[re].Autor, Res[re].Fecha, Publi[Ver].Activo);
                Mostrar << Foro_Estudiantes;
        Fin_Caso
        Mostrar << "¿Desea salir del sistema? 1: Sí, 0: No";
        Leer >> R;
        Hasta(R = 1);
    Fin_Repetir
Fin_Procedimiento