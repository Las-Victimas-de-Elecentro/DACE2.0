Procedimiento Publicaciones(E/S: Aux, Ver, pos_usuario, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Comentarios, Publi[Ver].Cant_Reacciones, Datos[pos_usuario].Vistos: Entero, Publi[Ver].Autor, Publi[Ver].Tema, Publi[Ver].Normas, Publi[Ver].Texto, Publi[Ver].Tipo_Reaccion1, Publi[Ver].Tipo_Reaccion2, Publi[Ver].Tipo_Reaccion3, Publi[Ver].Etiqueta, Publi[Ver].Imagen: Cadena, Publi[Ver].Activo: Booleano, [Procedimiento Opciones_Publicacion(Aux, Ver, react, pub, Datos[pos_usuario].Vistos, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Cant_Reacciones, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, R3, [Procedimiento Agregar_Reaccion(Aux, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta)], [Procedimiento Comentar(com, Com[com].ID_Publicacion, Com[com].ID_Comentario, Com[com].Comentario, Com[com].Fecha, Com[com].Autor, Com[com].Imagen)], [Procedimiento Comentarios(Ver, re, react, Publi[Ver].ID_Publicacion, Publi[Ver].Comentarios, Com[J].ID_Publicacion, Com[J].ID_Comentario, Com[J].Cant_Reacciones, Res[K].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Rea[react].ID_Publicacion, Rea[react].ID_Comentario, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Com[J].Respuestas, Com[J].Autor, Com[J].Fecha, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Com[J].Comentario, Res[re].Comentario, Res[re].Autor, Res[re].Fecha, Com[J].Imagen, Res[re].Imagen, [Procedimiento Agregar_Reaccion(Aux, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta)])])]);
Inicio
    Var R, R2, R3: Booleano;
    Var opc = 0, J: Entero;
    Ver = 1;
    Mostrar << "¿Desea ver las publicaciones disponibles? 1: Sí, 0: No";
    Leer >> R;
    Si (R = 1) Entonces;
        Repetir
            Si (Ver > Datos[pos_usuario].Vistos) and (Publi[Ver].Activo = 1) Entonces;
                Mostrar << Publi[Ver].ID_Publicacion;
                Mostrar << Publi[Ver].Imagen;
                Mostrar << Publi[Ver].Autor;
                Mostrar << Publi[Ver].Tema;
                Mostrar << Publi[Ver].Normas;
                Mostrar << PublI[Ver].Texto;
                Mostrar << Publi[Ver].Comentarios;
                Mostrar << Publi[Ver].Cant_Reacciones;
                Mostrar << Publi[Ver].Tipo_Reaccion1;
                Mostrar << Publi[Ver].Tipo_Reaccion2;
                Mostrar << Publi[Ver].Tipo_Reaccion3;
                Mostrar << Publi[Ver].Etiqueta;
                Opciones_Publicacion(Aux, Ver, react, pub, Datos[pos_usuario].Vistos, Publi[Ver].Comentarios, Publi[Ver].ID_Publicacion, Publi[Ver].Cant_Reacciones, Rea[react].ID_Comentario, Rea[react].ID_Publicacion, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, R3, [Procedimiento Agregar_Reaccion(Aux, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta)], [Procedimiento Comentar(com, Com[com].ID_Publicacion, Com[com].ID_Comentario, Com[com].Comentario, Com[com].Fecha, Com[com].Autor)], [Procedimiento Comentarios(Ver, re, react, Publi[Ver].ID_Publicacion, Publi[Ver].Comentarios, Com[J].ID_Publicacion, Com[J].ID_Comentario, Com[J].Cant_Reacciones, Res[K].Cant_Reacciones, Res[re].ID_Comentario, Res[re].ID_Respuesta, Rea[react].ID_Publicacion, Rea[react].ID_Comentario, Rea[react].ID_Respuesta, Rea[react].ID_Reacciones, Com[J].Respuestas, Com[J].Autor, Com[J].Fecha, Com[J].Tipo_Reaccion1, Com[J].Tipo_Reaccion2, Com[J].Tipo_Reaccion3, Com[J].Comentario, Res[re].Comentario, Res[re].Autor, Res[re].Fecha, [Procedimiento Agregar_Reaccion(Aux, Rea[react].Cant_Gusta, Rea[react].Cant_Encanta, Rea[react].Cant_Importa, Rea[react].Cant_Divierte, Rea[react].Cant_Asombra, Rea[react].Cant_Entristece, Rea[react].Cant_Molesta, Rea[react].Me_Gusta, Rea[react].Me_Encanta, Rea[react].Me_Importa, Rea[react].Me_Divierte, Rea[react].Me_Asombra, Rea[react].Me_Entristece, Rea[react].Me_Molesta)])]);
                Mostrar << Opciones_Publicacion;
            Fin_Si
            Hasta(R3 = 0);
        Fin_Repetir
    Sino
        Mostrar << "Volviendo al menú principal";
    Fin_Si
Fin_Procedimiento