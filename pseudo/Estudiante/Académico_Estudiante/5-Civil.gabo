    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_IV > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_V < 5.5) Entonces;
        Mostrar << "Cálculo V";
        Mostrar << Inscripcion;
    Fin_Si

    //Sexto Semestre
    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Geologia_Aplicada > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Materiales_Y_Ensayos > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_De_Suelos < 5.5) Entonces;
        Mostrar << "Mecánica de Suelos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Quimica_Aplicada > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_De_Fluidos_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].H_San_Ambiental < 5.5) Entonces;
        Mostrar << "H & San Ambiental";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Resistencia_De_Materiales > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Teorias_De_Estructuras_I < 5.5) Entonces;
        Mostrar << "Teorías de Estructuras I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Geometria_Descriptiva_II > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Topografia > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Dibujo_De_Proyectos < 5.5) Entonces;
        Mostrar << "Dibujo de Proyectos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_De_Fluidos_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Geologia_Aplicada > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Hidrologia < 5.5) Entonces;
        Mostrar << "Hidrología";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_De_Fluidos_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_De_Fluidos_II < 5.5) Entonces;
        Mostrar << "Mecánica de Fluidos II";
        Mostrar << Inscripcion;
    Fin_Si

    //Séptimo Semestre
    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Teorias_De_Estructuras_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Teorias_De_Estructuras_II < 5.5) Entonces;
        Mostrar << "Teoría de Estructuras II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 100) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Estadistica_Para_Ingenieros > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Ingenieria_Economica < 5.5) Entonces;
        Mostrar << "Ingeniería Económica";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].H_San_Ambiental > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_De_Fluidos_II > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Dibujo_De_Proyectos > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Instalaciones_Para_Edificios < 5.5) Entonces;
        Mostrar << "Instalaciones para Edificios";
