    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Materiales_Y_Ensayos > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Teorias_De_Estructuras_II > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Concreto_Armado < 5.5) Entonces;
