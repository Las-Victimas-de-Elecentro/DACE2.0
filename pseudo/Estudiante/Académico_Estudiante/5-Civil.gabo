    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Fisica_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_Racional_I < 5.5) Entonces;
        Mostrar << "Mecánica Racional I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Metod_Razonamiento_Logico > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Informatica_Para_Ingenieros < 5.5) Entonces;
        Mostrar << "Informática para Ingenieros";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 21) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Quimica_Basica < 5.5) Entonces;
        Mostrar << "Química Básica";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 21) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Deportes < 5.5) Entonces;
        Mostrar << "Deportes";
        Mostrar << Inscripcion;
    Fin_Si

    //Cuarto Semestre
    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_Racional_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_Racional_II < 5.5) Entonces;
        Mostrar << "Mecánica Racional II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Quimica_Basica > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Quimica_Aplicada < 5.5) Entonces;
        Mostrar << "Química Aplicada";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_III > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Topografia < 5.5) Entonces;
