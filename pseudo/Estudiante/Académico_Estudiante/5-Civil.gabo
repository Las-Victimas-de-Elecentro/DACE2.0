Procedimiento Civil(E/S: Materias[J].Codigo, Clase[K].Codigo, Clase[K].Nombre_Profesor, Clase[K].Dia, Clase[K].Hora_Inicio, Clase[K].Hora_Fin, Clase[K].Aula, Lista[L].Nombre, Datos[I].Nombre, Base.Lista[i].Estado, Base.Lista[i].ID_Bloque, Base.Lista[i].Dia, Base.Lista[i].Hora_Inicio, Base.Lista[i].Hora_Fin, Base.Lista[i].Aula: Cadena, Clase[K].Seccion, Lista[L].Cedula, Datos[I].CI, Clase[K].Cant_Estudiantes, L, Datos[pos_usuario].UC_Aprobadas, Datos[pos_usuario].UC: Entero, Datos[pos_usuario].Materias.Civ[pos_usuario].Ingles_Tecnico, Datos[pos_usuario].Materias.Civ[pos_usuario].Tec_Estudio_Doc, Datos[pos_usuario].Materias.Civ[pos_usuario].Metod_Razonamiento_Logico, Datos[pos_usuario].Materias.Civ[pos_usuario].Arte_Y_Cultura, Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_I, Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_II, Datos[pos_usuario].Materias.Civ[pos_usuario].Fisica_I, Datos[pos_usuario].Materias.Civ[pos_usuario].Geometria_Descriptiva_I, Datos[pos_usuario].Materias.Civ[pos_usuario].Geometria_Descriptiva_II, Datos[pos_usuario].Materias.Civ[pos_usuario].Introduccion_Ciencias_Humanas, Datos[pos_usuario].Materias.Civ[pos_usuario].Sociedad_Ciencia_Tecnologia, Datos[pos_usuario].Materias.Civ[pos_usuario].Fisica_II, Datos[pos_usuario].Materias.Info[pos_usuario].Calculo_III, Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_Racional_I, Datos[pos_usuario].Materias.Civ[pos_usuario].Informatica_Para_Ingenieros, Datos[pos_usuario].Materias.Civ[pos_usuario].Quimica_Basica, Datos[pos_usuario].Materias.Civ[pos_usuario].Deportes, Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_Racional_II, Datos[pos_usuario].Materias.Civ[pos_usuario].Quimica_Aplicada, Datos[pos_usuario].Materias.Civ[pos_usuario].Topografia, Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_IV, Datos[pos_usuario].Materias.Civ[pos_usuario].Estadistica_Para_Ingenieros, Datos[pos_usuario].Materias.Civ[pos_usuario].Electiva_No_Tecnica, Datos[pos_usuario].Materias.Civ[pos_usuario].Geolog