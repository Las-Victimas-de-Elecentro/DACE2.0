        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 161) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Practica_Profesional > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Trabajo_Grado_I < 5.5) Entonces;
        Mostrar << "Trabajo Especial de Grado I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Concreto_Armado > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Concreto_Pretenzado < 5.5) Entonces;
        Mostrar << "Concreto Pretenzado";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Concreto_Armado > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_De_Suelos > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Fundaciones_Y_Muros < 5.5) Entonces;
        Mostrar << "Fundaciones y Muros";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Vias_De_Comunicacion_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Vias_De_Comunicacion_II < 5.5) Entonces;
        Mostrar << "Vías de Comunicación II";
        Mostrar << Inscripcion;
    Fin_Si

    //Décimo Semestre
    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Concreto_Armado > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Fundaciones_Y_Muros > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Proyectos_Estructurales_Concreto < 5.5) Entonces;
        Mostrar << "Proyectos Esctructurales de Concreto";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Trabajo_Grado_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Trabajo_Grado_II < 5.5) Entonces;
        Mostrar << "Trabajo Especial de Grado II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 171) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Administracion_De_Obras < 5.5) Entonces;
        Mostrar << "Administración de Obras";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Vias_De_Comunicacion_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Pavimentos < 5.5) Entonces;
        Mostrar << "Pavimentos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Concreto_Pretenzado > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Puentes < 5.5) Entonces;
        Mostrar << "Puentes";
        Mostrar << Inscripcion;
    Fin_Si
Fin_Procedimiento