    //Octavo Semestre
    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Electiva_Tecnica > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Electiva_Tecnica_II < 5.5) Entonces;
