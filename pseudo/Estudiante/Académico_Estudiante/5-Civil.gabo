rio].Trabajo_Grado_II, Datos[pos_usuario].Materias.Civ[pos_usuario].Administracion_De_Obras, Datos[pos_usuario].Materias.Civ[pos_usuario].Pavimentos, Datos[pos_usuario].Materias.Civ[pos_usuario].Puentes: Real);
Inicio
    Var UC: Entero;
    Mostrar << "Aquí los bloques disponibles para que pueda organizar sus materias:";
    Para (i = 1 Hasta i = 48) Hacer;
        Si (Base.Lista[i].Estado = "Libre") Entonces;
            Mostrar << "ID: ", Base.Lista[i].ID_Bloque, " | ", Base.Lista[i].Dia, " ", Base.Lista[i].Hora_Inicio, "-", Base.Lista[i].Hora_Fin, " | Aula: ", Base.Lista[i].Aula;
        Fin_Si
    Fin_Para
    UC = 20;
    Datos[pos_usuario].UC = Datos[pos_usuario].UC + UC;
    //Primer Semestre
    Si (Datos[pos_usuario].UC_Aprobadas = 0) Entonces;
        Mostrar << "Inglés Técnico";
        Mostrar << "Técnicas De Estudio y Documentación";
        Mostrar << "Geometria Descriptiva I";
        Mostrar << "Calculo I";
        Mostrar << "Metodología del Razonamiento Logico";
        Mostrar << "Arte Y Cultura";
        Para (I = 1 Hasta I = 6) Hacer;
            Mostrar << Inscripcion;
        Fin_Para
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Ingles_Tecnico < 5.5) Entonces;
        Mostrar << "Inglés Técnico";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Tec_Estudio_Doc < 5.5) Entonces;
        Mostrar << "Técnicas de Estudio y Documentación";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Metod_Razonamiento_Logico < 5.5) Entonces;
        Mostrar << "Metodología del Razonamiento Logico";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Arte_Y_Cultura < 5.5) Entonces;
        Mostrar << "Arte y Cultura";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Geometria_Descriptiva_I < 5.5) Entonces;
        Mostrar << "Geometría Descriptiva I";
        Mostrar << Inscripcion;
    Fin_Si
    
    //Segundo Semestre
    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_II < 5.5) Entonces;
        Mostrar << "Cálculo II";
        Mostrar << Inscripcion;
    Sino
        Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_I < 5.5) Entonces;
            Mostrar << "Cálculo I";
            Mostrar << Inscripcion;
        Fin_Si
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Fisica_I < 5.5) Entonces;
        Mostrar << "Física I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Geometria_Descriptiva_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Geometria_Descriptiva_II < 5.5) Entonces;
        Mostrar << "Geometría Descriptiva II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 4) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Introduccion_Ciencias_Humanas < 5.5) Entonces;
        Mostrar << "Introducción a las Ciencias Humanas";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 4) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Sociedad_Ciencia_Tecnologia < 5.5) Entonces;
        Mostrar << "Sociedad Ciencia y Tecnología";
        Mostrar << Inscripcion;
    Fin_Si

    //Tercer Semestre
    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Fisica_I > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Fisica_II < 5.5) Entonces;
        Mostrar << "Física II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Calculo_II > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Calculo_III < 5.5) Entonces;
