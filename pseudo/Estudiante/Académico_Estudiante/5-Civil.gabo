    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Acueductos_Y_Cloacas > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Hidrologia > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Obras_Hidraulicas < 5.5) Entonces;
