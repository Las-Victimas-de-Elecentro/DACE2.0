    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Estadistica_Para_Ingenieros > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Metodologia_Investigacion < 5.5) Entonces;
