    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Topografia > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_De_Fluidos_II > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Acueductos_Y_Cloacas < 5.5) Entonces;
