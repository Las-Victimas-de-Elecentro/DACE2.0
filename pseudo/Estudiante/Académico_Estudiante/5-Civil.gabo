    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 126) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Electiva_No_Tecnica_II > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Electiva_Tecnica < 5.5) Entonces;
        Mostrar << "Electiva Técnica";
        Mostrar << Inscripcion;
