    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_III > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_IV < 5.5) Entonces;
        Mostrar << "Calculo IV";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_III > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Estadistica_Para_Ingenieros < 5.5) Entonces;
        Mostrar << "Estadística para Ingenieros";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 40) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Electiva_No_Tecnica < 5.5) Entonces;
        Mostrar << "Electiva no Técnica";
        Mostrar << Inscripcion;
    Fin_Si

    //Quinto Semestre
    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Geometria_Descriptiva_II > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Quimica_Aplicada > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Topografia > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Geologia_Aplicada < 5.5) Entonces;
        Mostrar << "Geología Aplicada ";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_Racional_II > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Calculo_IV > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Resistencia_De_Materiales < 5.5) Entonces;
        Mostrar << "Resistencia de Materiales";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 60) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Electiva_No_Tecnica > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Electiva_No_Tecnica_II < 5.5) Entonces;
        Mostrar << "Electiva No Técnica II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Estadistica_Para_Ingenieros > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Quimica_Aplicada > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Materiales_Y_Ensayos < 5.5) Entonces;
        Mostrar << "Materiales y Ensayos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_Racional_II > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Quimica_Aplicada > 5.5) and (Datos[pos_usuario].Materias.Civ[pos_usuario].Mecanica_De_Fluidos_I < 5.5) Entonces;
        Mostrar << "Mecánica de Fluidos I";
