Procedimiento Inscripcion(E/S: Datos[pos_usuario].Carrera, cod: Cadena, pos_usuario, J: Entero, [Procedimiento Buscar_Materia_Inscripcion(cod, Materias[J].Codigo, Clase[K].Codigo, Clase[K].Nombre_Profesor, Clase[K].Dia, Clase[K].Hora_Inicio, Clase[K].Hora_Fin, Clase[K].Aula, Lista[I].Nombre, Datos[I].Nombre, pos_usuario, Clase[K].Cant_Estudiantes, Clase[K].Seccion, Lista[I].Cedula, Datos[I].CI, J, I)]);
Inicio
    Mostrar << "Ingrese el código de la materia que quiere inscribir:";
    Leer >> cod;
    Buscar_Materia_Inscripcion(cod, Materias[J].Codigo, Clase[K].Codigo, Clase[K].Nombre_Profesor, Clase[K].Dia, Clase[K].Hora_Inicio, Clase[K].Hora_Fin, Clase[K].Aula, Lista[I].Nombre, Datos[I].Nombre, pos_usuario, Clase[K].Cant_Estudiantes, Clase[K].Seccion, Lista[I].Cedula, Datos[I].CI, J, I);
    En_Caso (Datos[pos_usuario].Carrera <> "Ninguna") Sea;
        Caso(Datos[pos_usuario].Carrera = "Informatica");
            Para (J = 1 Hasta J = 59) Hacer;
                Mostrar << Buscar_Materia_Inscripcion;
            Fin_Para
        Caso(Datos[pos_usuario].Carrera = "Civil");
            Para (J = 60 Hasta J = 117) Hacer;
                Mostrar << Buscar_Materia_Inscripcion;
            Fin_Para
        Caso(Datos[pos_usuario].Carrera = "Hidrocarburos");
            Para (J = 118 Hasta J = 173) Hacer;
                Mostrar << Buscar_Materia_Inscripcion;
            Fin_Para
        Caso(Datos[pos_usuario].Carrera = "Medicina");
            Para (J = 174 Hasta J = 224) Hacer;
                Mostrar << Buscar_Materia_Inscripcion;
            Fin_Para
        Caso(Datos[pos_usuario].Carrera = "Odontologia");
            Para (J = 225 Hasta J = 258) Hacer;
                Mostrar << Buscar_Materia_Inscripcion;
            Fin_Para
        Caso(Datos[pos_usuario].Carrera = "Veterinaria");
            Para (J = 259 Hasta J = 301) Hacer;
                Mostrar << Buscar_Materia_Inscripcion;
            Fin_Para
        Caso(Datos[pos_usuario].Carrera = "Derecho");
            Para (J = 302 Hasta J = 355) Hacer;
                Mostrar << Buscar_Materia_Inscripcion;
            Fin_Para
        Caso(Datos[pos_usuario].Carrera = "Comunicación");
            Para (J = 356 Hasta J = 413) Hacer;
                Mostrar << Buscar_Materia_Inscripcion;
            Fin_Para
        Caso(Datos[pos_usuario].Carrera = "Contaduría");
            Para (J = 414 Hasta J = 465) Hacer;
                Mostrar << Buscar_Materia_Inscripcion;
            Fin_Para
        Otro_Caso
            Para (J = 466 Hasta J = 522) Hacer;
                Mostrar << Buscar_Materia_Inscripcion;
            Fin_Para
    Fin_Caso
Fin_Procedimiento