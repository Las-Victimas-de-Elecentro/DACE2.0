Procedimiento Veterinaria(E/S: Bloque[i].Estado, Bloque[i].ID_Bloque, Bloque[i].Dia, Bloque[i].Hora_Inicio, Bloque[i].Hora_Fin, Bloque[i].Aula: Cadena, pos_usuario, Datos[pos_usuario].UC_Aprobadas: Entero, Datos[pos_usuario].Materias.Vet[pos_usuario].Computacion, Datos[pos_usuario].Materias.Vet[pos_usuario].Deportes, Datos[pos_usuario].Materias.Vet[pos_usuario].Perfil_Profesional, Datos[pos_usuario].Materias.Vet[pos_usuario].Ecologia_Agricola, Datos[pos_usuario].Materias.Vet[pos_usuario].Ingles_Instrumental, Datos[pos_usuario].Materias.Vet[pos_usuario].Anatomia_I, Datos[pos_usuario].Materias.Vet[pos_usuario].Faenas_Pecuarias, Datos[pos_usuario].Materias.Vet[pos_usuario].Bioquimica, Datos[pos_usuario].Materias.Vet[pos_usuario].Electiva_Complementaria, Datos[pos_usuario].Materias.Vet[pos_usuario].Zoologia, Datos[pos_usuario].Materias.Vet[pos_usuario].Histologia, Datos[pos_usuario].Materias.Vet[pos_usuario].Microbiologia, Datos[pos_usuario].Materias.Vet[pos_usuario].Genetica, Datos[pos_usuario].Materias.Vet[pos_usuario].Zootecnia, Datos[pos_usuario].Materias.Vet[pos_usuario].Bioestadistica, Datos[pos_usuario].Materias.Vet[pos_usuario].Arte_Cultura, Datos[pos_usuario].Materias.Vet[pos_usuario].Fisiologia_Animal, Datos[pos_usuario].Materias.Vet[pos_usuario].Patologia_Clinica, Datos[pos_usuario].Materias.Vet[pos_usuario].Reproduccion, Datos[pos_usuario].Materias.Vet[pos_usuario].Farmacologia, Datos[pos_usuario].Materias.Vet[pos_usuario].Semiologia, Datos[pos_usuario].Materias.Vet[pos_usuario].Nutricion, Datos[pos_usuario].Materias.Vet[pos_usuario].Parasitologia, Datos[pos_usuario].Materias.Vet[pos_usuario].Anatomia_Patologica, Datos[pos_usuario].Materias.Vet[pos_usuario].Investigacion_I, Datos[pos_usuario].Materias.Vet[pos_usuario].Medicina_Caninos, Datos[pos_usuario].Materias.Vet[pos_usuario].Gerencia, Datos[pos_usuario].Materias.Vet[pos_usuario].Mejoramiento_Animal, Datos[pos_usuario].Materias.Vet[pos_usuario].Medicina_Rumiantes, Datos[pos_usuario].Materias.Vet[pos_usuario].Cirugia, Datos[pos_usuario].Materias.Vet[pos_usuario].Saneamiento, Datos[pos_usuario].Materias.Vet[pos_usuario].Extension_I, Datos[pos_usuario].Materias.Vet[pos_usuario].Medicina_Preventiva, Datos[pos_usuario].Materias.Vet[pos_usuario].Produccion_Industria, Datos[pos_usuario].Materias.Vet[pos_usuario].Derecho_Constitucional, Datos[pos_usuario].Materias.Vet[pos_usuario].Medicina_Suinos, Datos[pos_usuario].Materias.Vet[pos_usuario].Medicina_Especies, Datos[pos_usuario].Materias.Vet[pos_usuario].Legislacion, Datos[pos_usuario].Materias.Vet[pos_usuario].Servicio_Comunitario, Datos[pos_usuario].Materias.Vet[pos_usuario].Pasantias, Datos[pos_usuario].Materias.Vet[pos_usuario].Epidemiologia, Datos[pos_usuario].Materias.Vet[pos_usuario].Investigacion_II, Datos[pos_usuario].Materias.Vet[pos_usuario].Extension_II: Real, [Procedimiento Inscripcion(cod, J, [Procedimiento Buscar_Materia_Inscripcion(cod, Materias[J].Codigo, Clase[K].Codigo, Clase[K].Nombre_Profesor, Clase[K].Dia, Clase[K].Hora_Inicio, Clase[K].Hora_Fin, Clase[K].Aula, Lista[I].Nombre, Datos[I].Nombre, Clase[K].Cant_Estudiantes, Clase[K].Seccion, Lista[I].Cedula, Datos[I].CI, J, I)])]);
Inicio
    Var i: Entero;
    Var I: Entero;
    Inscripcion(cod, J, [Procedimiento Buscar_Materia_Inscripcion(cod, Materias[J].Codigo, Clase[K].Codigo, Clase[K].Nombre_Profesor, Clase[K].Dia, Clase[K].Hora_Inicio, Clase[K].Hora_Fin, Clase[K].Aula, Lista[I].Nombre, Datos[I].Nombre, Clase[K].Cant_Estudiantes, Clase[K].Seccion, Lista[I].Cedula, Datos[I].CI, J, I)]);
    Mostrar << "Aquí los bloques disponibles para que pueda organizar sus materias:";
    Para (i = 1 Hasta i = 48) Hacer;
        Si (Bloque[i].Estado = "Libre") Entonces;
            Mostrar << "ID: ", Bloque[i].ID_Bloque, " | ", Bloque[i].Dia, " ", Bloque[i].Hora_Inicio, "-", Bloque[i].Hora_Fin, " | Aula: ", Bloque[i].Aula;
        Fin_Si
    Fin_Para
    //Primer Año
    Si (Datos[pos_usuario].UC_Aprobadas = 0) Entonces;
        Mostrar << "Computación";
        Mostrar << "Educación Física y Deportes";
        Mostrar << "Análisis del Perfil Profesional";
        Mostrar << "Ecología Agrícola";
        Mostrar << "Inglés Instrumental";
        Mostrar << "Anatomía de los Animales Domesticos";
        Mostrar << "Faenas Pecuarias";
        Mostrar << "Bioquímica";
        Mostrar << "Electiva Complementaria";
        Mostrar << "Zoología";
        Para (I = 1 Hasta I = 10) Hacer;
            Mostrar << Inscripcion;
        Fin_Para
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Computacion < 5.5) Entonces;
        Mostrar << "Computación";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Deportes < 5.5) Entonces;
        Mostrar << "Educación Física y Deportes";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Perfil_Profesional < 5.5) Entonces;
        Mostrar << "Análisis del Perfil Profesional";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Ecologia_Agricola < 5.5) Entonces;
        Mostrar << "Ecología Agrícola";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Ingles_Instrumental < 5.5) Entonces;
        Mostrar << "Inglés Instrumental";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Anatomia_I < 5.5) Entonces;
        Mostrar << "Anatomía de los Animales Domésticos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Faenas_Pecuarias < 5.5) Entonces;
        Mostrar << "Faenas Pecuarias";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Bioquimica < 5.5) Entonces;
        Mostrar << "Bioquímica";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Electiva_Complementaria < 5.5) Entonces;
        Mostrar << "Electiva Complementaria";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Zoologia < 5.5) Entonces;
        Mostrar << "Zoología";
        Mostrar << Inscripcion;
    Fin_Si

    //Segundo Año
    Si (Datos[pos_usuario].Year >= 2) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Histologia < 5.5) Entonces;
        Mostrar << "Histología Veterinaria";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 2) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Microbiologia < 5.5) Entonces;
        Mostrar << "Microbiología";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 2) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Genetica < 5.5) Entonces;
        Mostrar << "Genética";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 2) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Zootecnia < 5.5) Entonces;
        Mostrar << "Zootecnia";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 2) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Bioestadistica < 5.5) Entonces;
        Mostrar << "Bioestadística";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 2) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Arte_Cultura < 5.5) Entonces;
        Mostrar << "Arte y Cultura";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 2) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Fisiologia_Animal < 5.5) Entonces;
        Mostrar << "Fisiología Animal";
        Mostrar << Inscripcion;
    Fin_Si

    //Tercer Año
    Si (Datos[pos_usuario].Year >= 3) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Patologia_Clinica < 5.5) Entonces;
        Mostrar << "Patología Clínica Veterinaria";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 3) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Reproduccion < 5.5) Entonces;
        Mostrar << "Reproducción Animal";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 3) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Farmacologia < 5.5) Entonces;
        Mostrar << "Farmacología Veterinaria";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 3) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Semiologia < 5.5) Entonces;
        Mostrar << "Semiología Veterinaria";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 3) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Nutricion < 5.5) Entonces;
        Mostrar << "Nutrición y Alimentación Animal";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 3) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Parasitologia < 5.5) Entonces;
        Mostrar << "Parasitología Veterinaria";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 3) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Anatomia_Patologica < 5.5) Entonces;
        Mostrar << "Anatomía Patológica Veterinaria";
        Mostrar << Inscripcion;
    Fin_Si

    //Cuarto Año
    Si (Datos[pos_usuario].Year >= 4) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Investigacion_I < 5.5) Entonces;
        Mostrar << "Investigación Veterinaria I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 4) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Medicina_Caninos < 5.5) Entonces;
        Mostrar << "Medicina de Caninos y Felinos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 4) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Gerencia < 5.5) Entonces;
        Mostrar << "Gerencia de Servicio Veterinaria";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 4) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Mejoramiento_Animal < 5.5) Entonces;
        Mostrar << "Mejoramiento Animal";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 4) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Medicina_Rumiantes < 5.5) Entonces;
        Mostrar << "Medicina de Rumiantes y Equino";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 4) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Cirugia < 5.5) Entonces;
        Mostrar << "Cirugía Veterinaria";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 4) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Saneamiento < 5.5) Entonces;
        Mostrar << "Saneamiento Ambiental";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 4) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Extension_I < 5.5) Entonces;
        Mostrar << "Extensión Profesional I";
        Mostrar << Inscripcion;
    Fin_Si

    //Quinto Año
    Si (Datos[pos_usuario].Year >= 5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Medicina_Preventiva < 5.5) Entonces;
        Mostrar << "Medicina Preventiva y Clínica Hospitalaria";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Produccion_Industria < 5.5) Entonces;
        Mostrar << "Proceso de Producción Industrial e Inp San";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Derecho_Constitucional < 5.5) Entonces;
        Mostrar << "Derecho Constitucional";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Medicina_Suinos < 5.5) Entonces;
        Mostrar << "Medicina de Suinos y Aves";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Medicina_Especies < 5.5) Entonces;
        Mostrar << "Medicina Conejo, Peces, Especies Silvestres Laboratorio";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Legislacion < 5.5) Entonces;
        Mostrar << "Legislación y Deontología Veterinaria";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Servicio_Comunitario < 5.5) Entonces;
        Mostrar << "Servicio Comunitario";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Pasantias < 5.5) Entonces;
        Mostrar << "Pasantías Profesionales";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Epidemiologia < 5.5) Entonces;
        Mostrar << "Epidemiología General";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Investigacion_I > 5.5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Investigacion_II < 5.5) Entonces;
        Mostrar << "Investigación Veterinaria II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Year >= 5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Extension_I > 5.5) and (Datos[pos_usuario].Materias.Vet[pos_usuario].Extension_II < 5.5) Entonces;
        Mostrar << "Extensión Profesional II";
        Mostrar << Inscripcion;
    Fin_Si
Fin_Procedimiento