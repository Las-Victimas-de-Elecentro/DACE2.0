Procedimiento Buscar_Materia_Inscripcion(E/S: cod, Materias[J].Codigo, Clase[K].Codigo, Clase[K].Nombre_Profesor, Clase[K].Dia, Clase[K].Hora_Inicio, Clase[K].Hora_Fin, Clase[K].Aula, Lista[I].Nombre, Datos[I].Nombre: Cadena, Clase[K].Cant_Estudiantes, Clase[K].Seccion, Lista[I].Cedula, Datos[I].CI, J: Entero);
Inicio
    Var q: Booleano;
    Var I, K: Entero;
    Si (cod = Materias[J].Codigo) Entonces;
        Para (K = 1 Hasta K = 1600) Hacer;
            Si (Clase[K].Codigo = cod) Entonces;
                Si (Clase[K].Cant_Estudiantes >= 50) Entonces;
                    Mostrar << "Profesor: ", Clase[K].Nombre_Profesor;
                    Mostrar << "Día: ", Clase[K].Dia;
                    Mostrar << "Hora de inicio: ", Clase[K].Hora_Inicio;
                    Mostrar << "Hora que finaliza: ", Clase[K].Hora_Fin;
                    Mostrar << "Aula: ", Clase[K].Aula;
                    Mostrar << "Sección: ", Clase[K].Seccion;
                    Mostrar << "No puede inscribir la materia acá porque ya no hay cupos.";
                Sino
                    Si (Datos[pos_usuario].UC < Materias[J].Creditos) Entonces;
                        Mostrar << "No puedes inscribir esta materia porque no tienes suficientes unidades de crédito";
                    Sino
                        Mostrar << "Profesor: ", Clase[K].Nombre_Profesor;
                        Mostrar << "Día: ", Clase[K].Dia;
                        Mostrar << "Hora de inicio: ", Clase[K].Hora_Inicio;
                        Mostrar << "Hora que finaliza: ", Clase[K].Hora_Fin;
                        Mostrar << "Aula: ", Clase[K].Aula;
                        Mostrar << "Sección: ", Clase[K].Seccion;
                        Mostrar << "¿Desea inscribir la materia en esa clase? 1: Sí, 0: No";
                        Leer >> q;
                        Si (q = 1) Entonces;
                            Para (I = 1 Hasta I = 80000) Hacer;
                                Si (Lista[I].ID_Lista = Clase[K].ID_Clase) Entonces;
                                    Si (Lista[I].Cedula = 0) Entonces;
                                        Lista[I].Nombre = Datos[pos_usuario].Nombre;
                                        Lista[I].Cedula = Datos[pos_usuario].CI;
                                    Fin_Si
                                Fin_Si
                            Fin_Para
                            Datos[pos_usuario].UC = Datos[pos_usuario].UC - Materias[J].Creditos;
                            Clase[K].Cant_Estudiantes = Clase[K].Cant_Estudiantes + 1;
                        Fin_Si
                    Fin_Si
                Fin_Si
            Fin_Si
        Fin_Para
    Fin_Si
Fin_Procedimiento