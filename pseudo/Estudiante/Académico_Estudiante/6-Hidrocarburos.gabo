terias.Hid[pos_usuario].Recuperacion_Mejorada: Real);
Inicio
    Var UC: Entero;
    Mostrar << "Aquí los bloques disponibles para que pueda organizar sus materias:";
    Para (i = 1 Hasta i = 48) Hacer;
        Si (Base.Lista[i].Estado = "Libre") Entonces;
            Mostrar << "ID: ", Base.Lista[i].ID_Bloque, " | ", Base.Lista[i].Dia, " ", Base.Lista[i].Hora_Inicio, "-", Base.Lista[i].Hora_Fin, " | Aula: ", Base.Lista[i].Aula;
        Fin_Si
    Fin_Para
    UC = 18;
    Datos[pos_usuario].UC = Datos[pos_usuario].UC + UC;
    //Primer Semestre
    Si (Datos[pos_usuario].UC_Aprobadas = 0) Entonces;
        Mostrar << "Formación Socio Política I";
        Mostrar << "Proyecto Comunitario Socio Energético I";
        Mostrar << "Dibujo Técnico y Descriptiva";
        Mostrar << "Matemática I";
        Mostrar << "Ingles Técnico";
        Mostrar << "Química Inorgánica";
        Mostrar << "Orientación a la Ingeniería del Petróleo y Gas Natural"; 
        Mostrar << "Arte y Cultura";
        Para (I = 1 Hasta I = 8) Hacer;
            Mostrar << Inscripcion;
        Fin_Para
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Formacion_Socio_I < 5.5) Entonces;
        Mostrar << "Formación Socio Política I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_I < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Energético I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Dibujo_Tecnico < 5.5) Entonces;
        Mostrar << "Dibujo Técnico y Descriptiva";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Matematica_I < 5.5) Entonces;
