        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Arte_Cultura < 5.5) Entonces;
        Mostrar << "Arte y Cultura";
        Mostrar << Inscripcion;
    Fin_Si

    //Segundo Semestre
    Si (Datos[pos_usuario].UC_Aprobadas >= 10) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Informatica < 5.5) Entonces;
        Mostrar << "Informática";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Matematica_I > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Matematica_II < 5.5) Entonces;
        Mostrar << "Matemática II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Matematica_I > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Fisica_I < 5.5) Entonces;
        Mostrar << "Física I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Quimica_Inorganica > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Quimica_Organica > 5.5) Entonces;
        Mostrar << "Química Orgánica";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Formacion_Socio_I > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Formacion_Socio_II < 5.5) Entonces;
        Mostrar << "Formación Socio Política II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_I > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_II < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Energético II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 20) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Deporte < 5.5) Entonces;
        Mostrar << "Deporte";
        Mostrar << Inscripcion;
    Fin_Si

    //Tercer Semestre
    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Formacion_Socio_II > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Formacion_Socio_III < 5.5) Entonces;
        Mostrar << "Formación Socio Política III";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_II > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_III < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Energético III";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Fisica_I > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Fisica_II < 5.5) Entonces;
        Mostrar << "Física II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Quimica_Inorganica > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Geologia_General < 5.5) Entonces;
        Mostrar << "Geología General";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Matematica_II > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Matematica_III < 5.5) Entonces;
        Mostrar << "Matemática III";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Fisica_I > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Lab_Fisica < 5.5) Entonces;
        Mostrar << "Laboratorio de Física";
        Mostrar << Inscripcion;
    Fin_Si

    //Cuarto Semestre
    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Formacion_Socio_III > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Formacion_Socio_IV < 5.5) Entonces;
        Mostrar << "Formación Socio Política IV";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_III > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_IV < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Energético IV";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Fisica_II > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Mecanica_Rocas_Fluidos < 5.5) Entonces;
        Mostrar << "Mecánica de las Rocas y de los Fluidos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Matematica_III > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Probabilidades_Estadisticas < 5.5) Entonces;
        Mostrar << "Probabilidades y Estadísticas";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Matematica_III > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Fisica_II > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Termodinamica < 5.5) Entonces;
        Mostrar << "Termodinámica General y Aplicada";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Geologia_General > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Caracterizacion_Fisica_Yac < 5.5) Entonces;
        Mostrar << "Caracterización Física de los Yacimientos";
        Mostrar << Inscripcion;
    Fin_Si

    //Quinto Semestre
    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Termodinamica > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Mecanica_Rocas_Fluidos > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Sistema_Comprension_Gas < 5.5) Entonces;
        Mostrar << "Sistema de Compresión de Gas";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Formacion_Socio_IV > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Legislacion_Petrolera < 5.5) Entonces;
        Mostrar << "Formación Socio Política Legislación Petrolera";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_IV > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_V < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Energético V";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Caracterizacion_Fisica_Yac > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Perforacion_Pozos < 5.5) Entonces;
        Mostrar << "Perforación de Pozos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Caracterizacion_Fisica_Yac > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Caracterizacion_Energetica_Yac < 5.5) Entonces;
        Mostrar << "Caracterización Energética de los Yacimientos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Mecanica_Rocas_Fluidos > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Transporte_Distribucion < 5.5) Entonces;
        Mostrar << "Transporte y Distribución de Hidrocarburos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Mecanica_Rocas_Fluidos > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Geologia_Estructural < 5.5) Entonces;
        Mostrar << "Geología Estructural";
        Mostrar << Inscripcion;
    Fin_Si

    //Sexto Semestre
    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Legislacion_Petrolera > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Comercio_Internacional < 5.5) Entonces;
        Mostrar << "Formación Socio Política Integración con el Comercio Internacional";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_V > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_VI < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Energético VI";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 100) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Seguridad_Industrial < 5.5) Entonces;
        Mostrar << "Seguridad Industrial";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Caracterizacion_Energetica_Yac > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Caracterizacion_Dinamica_Yac < 5.5) Entonces;
        Mostrar << "Caracterización Dinámica de los Yacimientos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Perforacion_Pozos > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Perfilaje_Pozos < 5.5) Entonces;
        Mostrar << "Perfilaje de Pozos";
        Mostrar << Inscripcion;
    Fin_Si
    
    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Perforacion_Pozos > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Completacion_Pozos < 5.5) Entonces;
        Mostrar << "Completación de Pozos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Caracterizacion_Energetica_Yac > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Recuperacion_Secundaria < 5.5) Entonces;
        Mostrar << "Recuperación Secundaria de los Yacimientos";
