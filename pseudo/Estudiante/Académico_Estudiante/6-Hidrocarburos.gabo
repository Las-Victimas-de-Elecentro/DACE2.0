    Fin_Si

    //Séptimo Semestre
    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_VI > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_VII < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Energético VII";
