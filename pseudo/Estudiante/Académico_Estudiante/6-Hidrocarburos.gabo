    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Seguridad_Industrial > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Proteccion_Riesgos < 5.5) Entonces;
        Mostrar << "Protección Integral de Riesgos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 120) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Electiva_Corrosion < 5.5) Entonces;
        Mostrar << "Electiva Profesional (Corrosión e Integridad Mecánica)";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 120) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Auditoria_Ambiental < 5.5) Entonces;
