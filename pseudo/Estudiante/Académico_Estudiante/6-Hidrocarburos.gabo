        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Ingles_Tecnico < 5.5) Entonces;
        Mostrar << "Inglés Técnico";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Quimica_Inorganica < 5.5) Entonces;
