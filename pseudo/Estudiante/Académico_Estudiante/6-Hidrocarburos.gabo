        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Ing_Produccion_I > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Ing_Produccion_II < 5.5) Entonces;
        Mostrar << "Ingeniería de Producción II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Matematica_III > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Simulacion_Yacimientos < 5.5) Entonces;
        Mostrar << "Simulación Numérica de Yacimientos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Transporte_Distribucion > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Procesos_Refinacion < 5.5) Entonces;
        Mostrar << "Procesos de Refinación";
        Mostrar << Inscripcion;
    Fin_Si

    //Noveno Semestre
    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Proyecto_VIII > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].TEG < 5.5) Entonces;
        Mostrar << "Trabajo Especial de Grado";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Recuperacion_Secundaria > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Recuperacion_Mejorada < 5.5) Entonces;
        Mostrar << "Recuperación Mejorada";
        Mostrar << Inscripcion;
    Fin_Si
Fin_Procedimiento