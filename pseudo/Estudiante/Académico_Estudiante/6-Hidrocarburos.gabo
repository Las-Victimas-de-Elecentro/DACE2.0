    Fin_Si

    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Geologia_Estructural > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Caracterizacion_Dinamica_Yac > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Geologia_Produccion < 5.5) Entonces;
