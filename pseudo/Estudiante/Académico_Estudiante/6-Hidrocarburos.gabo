    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Termodinamica > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Transferencia_Calor < 5.5) Entonces;
        Mostrar << "Transferencia de Calor";
        Mostrar << Inscripcion;
    Fin_Si

    //Octavo Semestre
    Si (Datos[pos_usuario].Materias.Hid[pos_usuario].Transporte_Distribucion > 5.5) and (Datos[pos_usuario].Materias.Hid[pos_usuario].Procesos_Petroquimicos < 5.5) Entonces;
