    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Con[pos_usuario].Contabilidad_Especializada_I > 5.5) and (Datos[pos_usuario].Materias.Con[pos_usuario].Contabilidad_Especializada_II < 5.5) Entonces;
