    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Con[pos_usuario].Practica_Profesional_I > 5.5) and (Datos[pos_usuario].Materias.Con[pos_usuario].Practica_Profesional_II < 5.5) Entonces;
