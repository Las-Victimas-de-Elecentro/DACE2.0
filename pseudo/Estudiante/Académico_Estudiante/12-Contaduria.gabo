    //Séptimo Semestre
    Si (Datos[pos_usuario].Semestre >= 7) and (Datos[pos_usuario].Materias.Con[pos_usuario].Sistemas_Tributarios_I > 5.5) and (Datos[pos_usuario].Materias.Con[pos_usuario].Sistemas_Tributarios_II < 5.5) Entonces;
