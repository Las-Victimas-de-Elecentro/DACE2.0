    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Con[pos_usuario].Auditoria_I > 5.5) and (Datos[pos_usuario].Materias.Con[pos_usuario].Auditoria_II < 5.5) Entonces;
        Mostrar << "Auditoría II";
