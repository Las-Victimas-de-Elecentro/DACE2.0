Procedimiento Plan_Evaluacion_Estudiante(E/S: Datos[pos_usuario].Carrera, cod, Materias[J].Codigo, Clase[K].Codigo, Plan[Q].Nombre_Profesor, Plan[Q].Nombre_Materia, Plan[Q].Tema, Plan[Q].Fecha, Plan[Q].Estrategia: Cadena, Lista[F].ID_Lista, Clase[K].ID_Clase, Datos[pos_usuario].CI, Lista[L].Cedula, Plan[Q].ID_Plan, Plan[Q].Ponderacion: Entero, Plan[Q].Firmado: Booleano);
Inicio
    Var J: Entero;
    Var R: Booleano;
    Repetir
        Mostrar << "¡Bienvenido al apartado de los Planes de Evaluación!";
        Mostrar << "Ingrese el código de la materia de la cual desea ver su plan de evaluación";
        Leer >> cod;
        Buscar_Materia_Plan(cod, Materias[J].Codigo, Clase[K].Codigo, Plan[Q].Nombre_Profesor, Plan[Q].Nombre_Materia, Plan[Q].Tema, Plan[Q].Fecha, Plan[Q].Estrategia, Lista[F].ID_Lista, Clase[K].ID_Clase, Datos[pos_usuario].CI, Lista[L].Cedula, Plan[Q].ID_Plan, Plan[Q].Ponderacion, Plan[Q].Firmado);
        En_Caso (Datos[pos_usuario].Carrera <> "Ninguna") Sea;
            Caso(Datos[pos_usuario].Carrera = "Informatica");
                Para (J = 1 Hasta J = 59) Hacer;
                    Mostrar << Buscar_Materia_Plan;
                Fin_Para
            Caso(Datos[pos_usuario].Carrera = "Civil");
                Para (J = 60 Hasta J = 117) Hacer;
                    Mostrar << Buscar_Materia_Plan;
                Fin_Para
            Caso(Datos[pos_usuario].Carrera = "Hidrocarburos");
                Para (J = 118 Hasta J = 173) Hacer;
                    Mostrar << Buscar_Materia_Plan;
                Fin_Para
            Caso(Datos[pos_usuario].Carrera = "Medicina");
                Para (J = 174 Hasta J = 224) Hacer;
                    Mostrar << Buscar_Materia_Plan;
                Fin_Para
            Caso(Datos[pos_usuario].Carrera = "Odontologia");
                Para (J = 225 Hasta J = 258) Hacer;
                    Mostrar << Buscar_Materia_Plan;
                Fin_Para
            Caso(Datos[pos_usuario].Carrera = "Veterinaria");
                Para (J = 259 Hasta J = 304) Hacer;
                    Mostrar << Buscar_Materia_Plan;
                Fin_Para
            Caso(Datos[pos_usuario].Carrera = "Derecho");
                Para (J = 305 Hasta J = 360) Hacer;
                    Mostrar << Buscar_Materia_Plan;
                Fin_Para
            Caso(Datos[pos_usuario].Carrera = "Comunicación");
                Para (J = 361 Hasta J = 418) Hacer;
                    Mostrar << Buscar_Materia_Plan;
                Fin_Para
            Caso(Datos[pos_usuario].Carrera = "Contaduría");
                Para (J = 419 Hasta J = 470) Hacer;
                    Mostrar << Buscar_Materia_Plan;
                Fin_Para
            Otro_Caso
                Para (J = 471 Hasta J = 527) Hacer;
                    Mostrar << Buscar_Materia_Plan;
                Fin_Para
        Fin_Caso
        Mostrar << "¿Desea ver el plan de evaluación de otra materia? 1: Sí, 0: No";
        Leer >> R;
        Hasta(R = 0);
    Fin_Repetir
Fin_Procedimiento