Procedimiento Salir_Club(E/S: club, pos_usuario, Club[I].Miembros_Inscritos: Entero, Club[I].Nombre, Datos[pos_usuario].Club: Cadena, Datos[pos_usuario].Esta_en_Club: Booleano);
Inicio 
    Var Nombre_Club: Entero;
    Si (Datos[pos_usuario].Esta_en_Club = 1) Entonces;
        Mostrar << "Ingrese el nombre del club de dónde está inscrito";
        Leer >> Nombre_Club;
        Para (I = 1 Hasta I = club) Hacer;
            Si (Datos[pos_usuario].Club = Nombre_Club) Entonces;
                Club[I].Miembros_Inscritos = Club[I].Miembros_Inscritos - 1;
                Mostrar << "Ha salido del club:..,", Club[I].Nombre;
                Datos[pos_usuario].Club = null;
                Datos[pos_usuario].Esta_en_Club = 0;
            
        Fin_Para
    Sino
        Mostrar << "No está inscrito en ningún club";
    Fin_Si
Fin_Procedimiento