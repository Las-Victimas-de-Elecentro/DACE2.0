            Caso(opc = 3);
                Docente_Social([Procedimiento Mostrar_Novedades(Nov[I].Hecho, Nov[I].Fecha, Nov[I].Responsables, Nov[I].Contexto, Nov[I].Lugar)], [Procedimiento Mostrar_Grupos(I, Gru[I].Nombre_Profesor, Gru[I].Codigo_Materia, Gru[I].Miembros, Gru[I].Seccion)], [Procedimiento Amigos_Docente(Am, pos, Lim, v, prof, Prof[J].Avatar, Admin[J].Avatar, Prof[J].Nombre, Prof[J].Materias, Amig[Am].Nombre_Emisor, Amig[Am].Nombre_Receptor, Amig[Am].Avatar_Receptor, Admin[J].Usuario, Admin[J].Cargo, Datos[J].Nombre, Datos[J].Avatar, Datos[J].Carrera, Prof[pos].CI, Amig[Am].CI_Emisor, Amig[Am].CI_Receptor, Prof[pos].Amigos, Datos[J].Semestre, Datos[J].Year, Prof[J].Cant_Materias)]);
                Mostrar << Docente_Social;
            Caso(opc = 4);
                Docente_Extracurricular([Procedimiento Eventos(Even[I].Nombre, Even[I].Fecha, Even[I].Descripcion)], [Procedimiento Mostrar_Clubes(Club[I].Nombre, Club[I].Descripcion, Club[I].Horarios_Disponibles, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima)], [Procedimiento Inscripcion_Club_Docente(Prof[pos].Club, Club[I].Nombre, Club[I].Horarios_Disponibles, pos, club, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima, Prof[pos].Esta_en_Club)], [Procedimiento Salir_Club_Docente(club, pos, Club[I].Miembros_Inscritos, Club[I].Nombre, Prof[I].Club, Prof[pos].Esta_en_Club)], [Procedimiento Informacion_Club_Docente(Prof[pos].Club, Club[I].Nombre, Club[I].Descripcion, Club[I].Horarios_Disponibles, pos, club, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima, Prof[pos].Esta_en_Club)], [Procedimiento Celebraciones(Cel[I].Nombre, Cel[I].Fecha, Cel[I].Tipo, Cel[I].Descripcion)]);
                Mostrar << Docente_Extracurricular;
            Otro_Caso
                R = 0;
        Fin_Caso
        Hasta(R = 0);
    Fin_Repetir
Fin_Procedimiento