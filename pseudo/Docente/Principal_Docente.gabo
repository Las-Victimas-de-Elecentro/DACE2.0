Inicio
    Var opc: Entero;
    Var R: Booleano;
    Repetir
        Mostrar << "¡Bienvenido a la sección Docente!";
        Mostrar << "¿A dónde deseas acceder?";
        Mostrar << "1: Sección Académica";
        Mostrar << "2: Sección Personal";
        Mostrar << "3: Sección Social";
        Mostrar << "4: Sección Extracurricular";
        Mostrar << "5: Salir";
        Leer >> opc;
        Mientras (opc < 1 or opc > 5) Hacer;
            Mostrar << "Es invalido";
            Leer >> opc;
