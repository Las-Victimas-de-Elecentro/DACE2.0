Procedimiento Salir_Club_Docente(E/S: club, pos, Club[I].Miembros_Inscritos: Entero, Club[I].Nombre, Prof[I].Club: Cadena, Prof[pos].Esta_en_Club: Booleano);
Inicio 
    Var Nombre_Club: Cadena;
    Si (Prof[pos].Esta_en_Club = 1) Entonces;
        Mostrar << "Ingrese el nombre del club de dónde está inscrito";
        Leer >> Nombre_Club;
        Para (I = 1 Hasta I = club) Hacer;
            Si (Prof[pos].Club = Nombre_Club) Entonces;
                Club[I].Miembros_Inscritos = Club[I].Miembros_Inscritos - 1;
                Mostrar << "Ha salido del club:..,", Club[I].Nombre;
                Prof[pos].Club = null;
                Prof[pos].Esta_en_Club = 0;
            Fin_Si
        Fin_Para
    Sino
        Mostrar << "No está inscrito en ningún club";
    Fin_Si
Fin_Procedimiento