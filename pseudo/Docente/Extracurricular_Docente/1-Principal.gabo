Procedimiento Docente_Extracurricular([Procedimiento Eventos(eve, Even[I].Nombre, Even[I].Fecha, Even[I].Descripcion)], [Procedimiento Mostrar_Clubes(Club[I].Nombre, Club[I].Descripcion, Club[I].Horarios_Disponibles, club, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima)], [Procedimiento Inscripcion_Club_Docente(Prof[pos].Club, Club[I].Nombre, Club[I].Horarios_Disponibles, pos, club, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima, Prof[pos].Esta_en_Club)], [Procedimiento Salir_Club_Docente(club, pos, Club[I].Miembros_Inscritos, Club[I].Nombre, Prof[I].Club, Prof[pos].Esta_en_Club)], [Procedimiento Informacion_Club_Docente(Prof[pos].Club, Club[I].Nombre, Club[I].Descripcion, Club[I].Horarios_Disponibles, pos, club, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima, Prof[pos].Esta_en_Club)], [Procedimiento Celebraciones(cel, Cel[I].Nombre, Cel[I].Fecha, Cel[I].Tipo, Cel[I].Descripcion)]);
Inicio
    Var opc, opcion: Entero;
    Var R: Booleano;
    Repetir
        Mostrar << "=== SISTEMA EXTRACURRICULAR ===";
        Mostrar << "1. Eventos";
        Mostrar << "2. Clubes";
        Mostrar << "3. Celebraciones";
        Mostrar << "4. Salir";
        Mostrar << "Seleccione una opción: ";
        Leer >> opc;
        Mientras (opc < 1 or opc > 4) Hacer;
            Mostrar << "Error, vuelva a intentar";
            Leer >> opc;
        Fin_Mientras
        En_Caso(opc > 0) Sea;
            Caso (opc = 1);
                Eventos(eve, Even[I].Nombre, Even[I].Fecha, Even[I].Descripcion);
                Mostrar << Eventos;
            Caso (opc = 2);
                Mostrar << "=== MENÚ DE CLUBES ===";
                Mostrar << "1. Ver clubes disponibles";
                Mostrar << "2. Inscribirse en un club";
                Mostrar << "3. Salir de un club";
                Mostrar << "4. Ver información de mi club";
                Mostrar << "Seleccione una opción: ";
                Leer >> opcion;
                Mientras (opcion < 1 or opcion > 4) Hacer;
                    Mostrar << "Es invalido, solo rango entre 1-4";
                    Leer >> opcion;
                Fin_Mientras
                En_Caso (opcion > 0) Sea;
                    Caso(opcion = 1);
                        Mostrar_Clubes(Club[I].Nombre, Club[I].Descripcion, Club[I].Horarios_Disponibles, club, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima);
                        Mostrar << Mostrar_Clubes;
                    Caso(opcion = 2);
                        Inscripcion_Club_Docente(Prof[pos].Club, Club[I].Nombre, Club[I].Horarios_Disponibles, pos, club, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima, Prof[pos].Esta_en_Club);
                        Mostrar << Inscripcion_Club;
                    Caso(opcion = 3);
                        Salir_Club_Docente(club, pos, Club[I].Miembros_Inscritos, Club[I].Nombre, Prof[I].Club, Prof[pos].Esta_en_Club);
                        Mostrar << Salir_Club;
                    Otro_Caso
                        Informacion_Club_Docente(Prof[pos].Club, Club[I].Nombre, Club[I].Descripcion, Club[I].Horarios_Disponibles, pos, club, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima, Prof[pos].Esta_en_Club);
                        Mostrar << Informacion_Club;
                Fin_Caso
            Caso(opc = 3);
                Celebraciones(cel, Cel[I].Nombre, Cel[I].Fecha, Cel[I].Tipo, Cel[I].Descripcion);
                Mostrar << Celebraciones;
            Otro_Caso
                Mostrar << "¡Hasta pronto!";
                R = 0;
        Fin_Caso
        Hasta(R = 0);
    Fin_Repetir
Fin_Procedimiento