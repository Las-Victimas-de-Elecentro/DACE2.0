Procedimiento Informacion_Club_Docente(E/S: Prof[pos].Club, Club[I].Nombre, Club[I].Descripcion, Club[I].Horarios_Disponibles: Cadena, pos, club, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima: Entero, Prof[pos].Esta_en_Club: Booleano);
Inicio
    Var Nombre_Club: Cadena;
    Si (Prof[pos].Esta_en_Club = 1) Entonces;
        Mostrar << "Ingrese el Nombre del club al que pertenece";
        Leer >> Nombre_Club;
        Para (I = 1 Hasta I = club) Hacer;
            Si (Prof[pos].Club = Nombre_Club) Entonces;
                Mostrar << "Información de su club";
                Mostrar << "Club:..,", Club[I].Nombre;
                Mostrar << "Descripción:..,", Club[I].Descripcion;
                Mostrar << "Horarios:..,", Club[I].Horarios_Disponibles;
                Mostrar << "Miembros Actuales:..,", Club[I].Miembros_Inscritos;
                Mostrar << "Capacidad del club:..,", Club[I].Capacidad_Maxima;
            Fin_Si
        Fin_Para
    Sino
        Mostrar << "No estás en ningún club, ingresa en uno.";
    Fin_Si
Fin_Procedimiento