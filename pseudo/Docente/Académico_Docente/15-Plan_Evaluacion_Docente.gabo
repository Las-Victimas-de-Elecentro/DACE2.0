Procedimiento Plan_Evaluacion_Docente(E/S: Materias[I].Codigo, Clase[J].Codigo_Materia, Prof[pos].Nombre, Clase[J].Nombre_Profesor, Plan[plan].Fecha, Plan[plan].Tema, Plan[plan].Estrategia, Plan[plan].Nombre_Profesor, Plan[plan].Nombre_Materia, Plan[plan].Codigo_Materia: Cadena, Plan[plan].Ponderacion, Plan[plan].ID_Plan, Clase[J].ID_Clase, plan: Entero, Plan[plan].Firmado: Booleano);
Inicio
    Var I, J: Entero;
    Var cod: Cadena;
    Var R, R2, R3: Booleano;
    Mostrar << "¡Bienvenido a la sección de Planes de Evaluación!";
    Mostrar << "¿Desea asignar una evaluación para su materia? 1: Sí, 0: No";
    Leer >> R;
    Repetir
        Si (R = 1) Entonces;
            Mostrar << "Ingrese el código de la materia a la que le quiere agregar una evaluación.";
            Leer >> cod;
            Para (I = 1 Hasta I = 522) Hacer;
                Si (cod = Materias[I].Codigo) Entonces;
                    Mostrar << "Materia encontrada";
                    Para (J = 1 Hasta I = 1600) Hacer;
                        Si (cod = Clase[J].Codigo_Materia) and (Prof[pos].Nombre = Clase[J].Nombre_Profesor) Entonces;
                            Mostrar << "Ingrese la fecha de la evaluación (DD/MM/YYYY)";
                            Leer >> Plan[plan].Fecha;
                            Mostrar << "De acuerdo, ingrese el tema de la evaluación:";
                            Leer >> Plan[plan].Tema;
                            Mostrar << "Ingrese la estrategia de la evaluación que se usará";
                            Leer >> Plan[plan].Estrategia;
                            Mostrar << "Ingrese la ponderación que tendrá esa evaluación:";
                            Leer >> Plan[plan].Ponderacion;
                            Mientras (Plan[plan].Ponderacion < 1) Hacer;
                                Mostrar << "Es invalido, solo positivos";
                                Leer >> Plan[plan].Ponderacion;
                            Fin_Mientras
                            Mostrar << "¿Está correcto? 1: Sí, 0: No";
                            Leer >> R3;
                            Si (R3 = 0) Entonces;
                                Mostrar << "Ingrese la fecha de la evaluación (DD/MM/YYYY)";
                                Leer >> Plan[plan].Fecha;
                                Mostrar << "De acuerdo, ingrese el tema de la evaluación:";
                                Leer >> Plan[plan].Tema;
                                Mostrar << "Ingrese la estrategia de la evaluación que se usará";
                                Leer >> Plan[plan].Estrategia;
                                Mostrar << "Ingrese la ponderación que tendrá esa evaluación:";
                                Leer >> Plan[plan].Ponderacion;
                                Mientras (Plan[plan].Ponderacion < 1) Hacer;
                                    Mostrar << "Es invalido, solo positivos";
                                    Leer >> Plan[plan].Ponderacion;
                                Fin_Mientras
                            Fin_Si
                            Mostrar << "Perfecto. Evaluación añadida a la espera para ser aprobada por el consejo";
                            Plan[plan].ID_Plan = Clase[J].ID_Clase;
                            Plan[plan].Nombre_Profesor = Prof[pos].Nombre;
                            Plan[plan].Codigo_Materia = cod;
                            Plan[plan].Nombre_Materia = Materias[I].Nombre;
                            Plan[plan].Firmado = 0;
                            plan = plan + 1;
                        Fin_Si
                    Fin_Para
                Fin_Si
            Fin_Para
        Sino
            Mostrar << "Vuelva pronto.";
            R2 = 0;
        Fin_Si
        Mostrar << "¿Desea asignar otra evaluación? 1: Sí, 0: No";
        Hasta(R2 = 0);
    Fin_Repetir
Fin_Procedimiento