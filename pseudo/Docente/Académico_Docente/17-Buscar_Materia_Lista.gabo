Datos[L].Materias.Eco[L].Microeconomia_II, Datos[L].Materias.Eco[L].Matematica_Financiera, Datos[L].Materias.Eco[L].Contabilidad_Social, Datos[L].Materias.Eco[L].Desarrollo_Economico, Datos[L].Materias.Eco[L].Analisis_Economico_Regional, Datos[L].Materias.Eco[L].Economia_Politica, Datos[L].Materias.Eco[L].Formulacion_Evaluacion_Proyectos, Datos[L].Materias.Eco[L].Investigacion_Operaciones, Datos[L].Materias.Eco[L].Teoria_Politica_Fiscal, Datos[L].Materias.Eco[L].Seminario_II, Datos[L].Materias.Eco[L].Economia_Politica_Agricola, Datos[L].Materias.Eco[L].Economia_Industrial, Datos[L].Materias.Eco[L].Economia_Industrial, Datos[L].Materias.Eco[L].Economia_Minera, Datos[L].Materias.Eco[L].Economia_Ambiente, Datos[L].Materias.Eco[L].Seminario_III, Datos[L].Materias.Eco[L].Econometria, Datos[L].Materias.Eco[L].Teoria_Politica_Monetaria, Datos[L].Materias.Eco[L].Planificacion, Datos[L].Materias.Eco[L].Economia_Internacional, Datos[L].Materias.Eco[L].Formulacion_Evaluacion_Agricola, Datos[L].Materias.Eco[L].Gestion_Comunitaria, Datos[L].Materias.Eco[L].Contabilidad_Costos, Datos[L].Materias.Eco[L].Presupuesto, Datos[L].Materias.Eco[L].Trabajo_Final_Grado, Datos[L].Materias.Eco[L].Finanzas_Internacionales, Datos[L].Materias.Eco[L].Estructura_Economica_Mundial, Datos[L].Materias.Eco[L].Gestion_Riesgo, Datos[L].Materias.Eco[L].Economia_Crisis: Real);
Inicio
    Var K, F, L, nota: Entero;
    Si (cod = Materias[J].Codigo) Entonces;
        Para (K = 1 Hasta K = 500) Hacer;
            Si (Clase[K].Codigo_Materia = cod) Entonces;
                Para (F = 1 Hasta F = 500) Hacer;
                    Si (Lista[F].ID_Lista = Clase[K].ID_Clase) Entonces;
                        Si (Prof[pos].Cedula = Clase[K].CI_Profesor) Entonces;
                            Para (L = F Hasta L = F+49) Hacer;
                                Mostrar << Clase[L].Seccion;
                                Mostrar << Datos[L].Nombre;
                                Mostrar << Datos[L].CI;
                                Mostrar << "¿Cuánta nota desea ponerle a este estudiante?";
                                Leer >> nota;
                                Mientras (nota < 1 or nota > 10) Hacer;
                                    Mostrar << "Es invalido, intente una nota del 1 al 10";
                                    Leer >> nota;
                                Fin_Mientras
                                En_Caso (carrera <> "Ninguna") Sea;
                                    Caso(carrera = "Informatica");
                                        // Primer Semestre
                                        Si (Materias[J].Nombre = "Matemática I") Entonces;
                                            Datos[L].Materias.Info[L].Matematica_I = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Fundamentos de la Informática") Entonces;
                                            Datos[L].Materias.Info[L].Fundamentos_Informatica = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Lógica Matemática") Entonces;
                                            Datos[L].Materias.Info[L].Logica_Matematica = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Lenguaje y Comunicación") Entonces;
                                            Datos[L].Materias.Info[L].Lenguaje_Comunicacion = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Ingles I") Entonces;
                                            Datos[L].Materias.Info[L].Ingles_I = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Formacion Constitucional") Entonces;
                                            Datos[L].Materias.Info[L].Formacion_Constitucional = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Economía Digital") Entonces;
                                            Datos[L].Materias.Info[L].Economia_Digital = nota;
                                        Fin_Si

                                        // Segundo Semestre
                                        Si (Materias[J].Nombre = "Matemática II") Entonces;
                                            Datos[L].Materias.Info[L].Matematica_II = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Física I") Entonces;
                                            Datos[L].Materias.Info[L].Fisica_I = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Algoritmos I") Entonces;
                                            Datos[L].Materias.Info[L].Algoritmos_I = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Problemática Científica Tecnológica") Entonces;
                                            Datos[L].Materias.Info[L].Prob_Cient_Tec = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Ingles II") Entonces;
                                            Datos[L].Materias.Info[L].Ingles_II = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Electiva I") Entonces;
                                            Datos[L].Materias.Info[L].Electiva_I = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Arte y Cultura") Entonces;
                                            Datos[L].Materias.Info[L].Arte_Y_Cultura = nota;
                                        Fin_Si

                                        // Tercer Semestre
                                        Si (Materias[J].Nombre = "Matemática III") Entonces;
                                            Datos[L].Materias.Info[L].Matematica_III = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Física II") Entonces;
                                            Datos[L].Materias.Info[L].Fisica_II = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Algoritmos II") Entonces;
                                            Datos[L].Materias.Info[L].Algoritmos_II = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Programación I") Entonces;
                                            Datos[L].Materias.Info[L].Programacion_I = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Metodología y Técnicas de Investigación") Entonces;
                                            Datos[L].Materias.Info[L].Tecnicas_Investigacion = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Electiva II") Entonces;
                                            Datos[L].Materias.Info[L].Electiva_II = nota;
                                        Fin_Si

                                        // Cuarto Semestre
                                        Si (Materias[J].Nombre = "Matemática IV") Entonces;
                                            Datos[L].Materias.Info[L].Matematica_IV = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Probabilidad y Estadística") Entonces;
                                            Datos[L].Materias.Info[L].Probabilidad_Estadistica = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Estructuras Discretas I") Entonces;
                                            Datos[L].Materias.Info[L].Estructuras_Discretas_I = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Programación II") Entonces;
                                            Datos[L].Materias.Info[L].Programacion_II = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Base de Datos") Entonces;
                                            Datos[L].Materias.Info[L].Base_Datos = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Electiva III") Entonces;
                                            Datos[L].Materias.Info[L].Electiva_III = nota;
                                        Fin_Si

                                        // Quinto Semestre
                                        Si (Materias[J].Nombre = "Organización del Computador") Entonces;
                                            Datos[L].Materias.Info[L].Organizacion_Computador = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Algebra Booleana") Entonces;
                                            Datos[L].Materias.Info[L].Algebra_Booleana = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Estructuras Discretas II") Entonces;
                                            Datos[L].Materias.Info[L].Estructuras_Discretas_II = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Programación III") Entonces;
                                            Datos[L].Materias.Info[L].Programacion_III = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Teoría de Sistemas") Entonces;
                                            Datos[L].Materias.Info[L].Teoria_Sistemas = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Electiva IV") Entonces;
                                            Datos[L].Materias.Info[L].Electiva_IV = nota;
                                        Fin_Si

                                        // Sexto Semestre
                                        Si (Materias[J].Nombre = "Arquitectura del Computador") Entonces;
                                            Datos[L].Materias.Info[L].Arquitectura_Computador = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Métodos Numéricos") Entonces;
                                            Datos[L].Materias.Info[L].Metodos_Numericos = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Investigación de Operaciones") Entonces;
                                            Datos[L].Materias.Info[L].Investigacion_Operaciones = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Ingeniería Económica") Entonces;
                                            Datos[L].Materias.Info[L].Ingenieria_Economica = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Sistemas de Información I") Entonces;
                                            Datos[L].Materias.Info[L].Sistemas_Informacion_I = nota;
                                        Fin_Si
                                        Si (Materias[J].Nombre = "Electiva V") Entonces;
                                            Datos[L].Materias.Info[L].Electiva_V = nota;
                                        Fin_Si

                                        // Séptimo Semestre
                                        Si (Materias[J].Nombre = "Sistemas Operativos") Entonces;
                                            Datos[L].Materias.Info[L].Sistemas_Operativos = nota;
