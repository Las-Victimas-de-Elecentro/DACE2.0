Procedimiento Buscar_Materia(E: Materias[i].Codigo, cod: Cadena, E/S: ok: Booleano);
Inicio
    Var i: Entero;
    ok = 0;
    Var pos = 0;
    Para (i = 1 Hasta i = 522) Hacer;
        Si (Materias[i].Codigo = cod) Entonces;
            ok = 1;
            pos = i;
        Fin_Si
    Fin_Para
Fin_Procedimiento