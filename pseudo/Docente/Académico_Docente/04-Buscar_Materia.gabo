Procedimiento Buscar_Materia(E: Materias[i].Codigo, cod: Cadena, E/S: pos: Entero, encontrado: Booleano);
Inicio
    Var i: Entero;
    encontrado = 0;
    pos = 0;
    Para (i = 1 Hasta i = 522) Hacer;
        Si (Materias[i].Codigo = cod) Entonces;
            encontrado = 1;
            pos = i;
        Fin_Si
    Fin_Para
Fin_Procedimiento