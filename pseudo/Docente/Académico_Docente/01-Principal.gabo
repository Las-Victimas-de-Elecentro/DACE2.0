].Materias.Eco[L].Gestion_Comunitaria, Datos[L].Materias.Eco[L].Contabilidad_Costos, Datos[L].Materias.Eco[L].Presupuesto, Datos[L].Materias.Eco[L].Trabajo_Final_Grado, Datos[L].Materias.Eco[L].Finanzas_Internacionales, Datos[L].Materias.Eco[L].Estructura_Economica_Mundial, Datos[L].Materias.Eco[L].Gestion_Riesgo, Datos[L].Materias.Eco[L].Economia_Crisis: Real, Plan[P].Firmado: Booleano);
Inicio
    Var opc: Entero;
    Mostrar << "Bienvenido al sistema DACE - Sección Académica (Docente)";
    Repetir
        Mostrar << "========================================";
        Mostrar << "Seleccione su acción, Maestro:";
        Mostrar << "1: Registrar Materias";
        Mostrar << "2: Asignar Horario (selección de bloque)";
        Mostrar << "3: Ver Mi Horario";
        Mostrar << "4: Registrar Solicitud";
        Mostrar << "5: Registrar Reporte";
        Mostrar << "6: Crear Asignación";
        Mostrar << "7: Publicar Asignación";
        Mostrar << "8: Cerrar Asignación";
        Mostrar << "9: Listar Mis Asignaciones";
        Mostrar << "10: Clases Magistrales";
        Mostrar << "11: Plan de Evaluación";
        Mostrar << "12: Cargar notas en el sistema";
        Mostrar << "0: Salir";
        Mostrar << "========================================";
        Leer >> opc;
        Mientras (opc < 0 or opc > 12) Hacer;
            Mostrar << "Error al ingresar, intente de nuevo";
            Leer >> opc;
        Fin_Mientras
        En_Caso(opc > 0) sea;
            Caso (opc = 1);
                Agregar_Materia(Prof[pos].Materias, Materias[I].Nombre, Materias[I].Codigo, Prof[pos].Cant_Materias);
                Mostrar << Agregar_Materia;
            Caso (opc = 2); 
                Asignar_Horario(Materias[i].Codigo, cod, pos, encontrado);
                Mostrar << Asignar_Horario;
            Caso (opc = 3); 
                Listar_Horario(Prof[i].Cant_Materias, Clase[i].Seccion, Clase[i].Cant_Estudiantes, Prof[i].Nombre, Clase[i].Nombre_Profesor, Clase[i].Dia, Clase[i].Hora_Inicio, Clase[i].Hora_Fin, Clase[i].Aula, Clase[i].Materias, Clase[i].Codigo_Materia);
                Mostrar << Listar_Horario;
            Caso (opc = 4); 
                Registrar_Solicitud_Docente(S, Soli[i].Titulo, Soli[i].Descripcion, Soli[i].Titular, Soli[i].Destinatario, Soli[i].Fecha, Prof[pos].Nombre, Soli[i].Estado);
                Mostrar << Registrar_Solicitud;
            Caso (opc = 5); 
                Registrar_Reporte_Docente(Re, Rep[i].Titulo, Rep[i].Descripcion, Rep[i].Titular, Rep[i].Problema, Rep[i].Fecha, Prof[pos].Nombre, Rep[i].Recibido);
                Mostrar << Registrar_Reporte;
            Caso (opc = 6); 
                Crear_Asignacion(Asig[i].Codigo_Materia, Asig[i].Descripcion, Asig[i].Fecha_Publicacion, Asig[i].Fecha_Entrega, Asig[i].Estado, cod, pos, As, ok);
                Mostrar << Crear_Asignacion;
            Caso (opc = 7); 
                Publicar_Asignacion(As, Prof[pos].Nombre, Asig[i].Nombre_Profesor, Asig[i].Titulo, Asig[i].Estado, Asig[i].Codigo_Materia);
                Mostrar << Publicar_Asignacion;
            Caso (opc = 8); 
                Cerrar_Asignacion(As, Prof[pos].Nombre, Asig[i].Nombre_Profesor, Asig[i].Estado, Asig[i].Titulo, Asig[i].Codigo_Materia, Asig[i].Fecha_Entrega);
                Mostrar << Cerrar_Asignacion;
            Caso (opc = 9); 
                Listar_Asignaciones(As, Prof[pos].Nombre, Asig[i].Nombre_Profesor, Asig[i].Titulo, Asig[i].Codigo_Materia, Asig[i].Estado, Asig[i].Fecha_Entrega);
                Mostrar << Listar_Asignaciones;
            Caso (opc = 10); 
                Clases_Magistrales_Docente(Materias[I].Codigo, Materias[I].Nombre, Prof[pos].Nombre, Mag[magis].Fecha, Mag[magis].Aula, Mag[magis].Nombre_Materia, Mag[magis].Codigo_Materia, Mag[magis].Nombre_Profesor, Prof[pos].Cedula, Mag[magis].CI_Profesor, Mag[magis].ID_Clase, magis, Mag[magis].Horas, Mag[magis].Precio);
                Mostrar << Clases_Magistrales;
            Caso (opc = 11); 
                Plan_Evaluacion_Docente(Materias[I].Codigo, Clase[J].Codigo_Materia, Prof[pos].Nombre, Clase[J].Nombre_Profesor, Plan[P].Fecha, Plan[P].Tema, Plan[P].Estrategia, Plan[P].Nombre_Profesor, Plan[P].Nombre_Materia, Plan[P].Codigo_Materia, Plan[P].Ponderacion, Plan[P].ID_Plan, Clase[J].ID_Clase, P, Plan[P].Firmado);
