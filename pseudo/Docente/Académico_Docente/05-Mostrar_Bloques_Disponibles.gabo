Procedimiento Mostrar_Bloques_Disponibles(E/S: Base.Lista[i].ID_Bloque: Entero, Base.Lista[i].Dia, Base.Lista[i].Hora_Inicio, Base.Lista[i].Hora_Fin, Base.Lista[i].Aula, Base.Lista[i].Estado: Cadena);
Inicio
    Mostrar<<"=== Bloques disponibles ===";
    Var i: Entero;
    Para (i = 1 Hasta i = 48) Hacer;
        Si (Base.Lista[i].Estado = "Libre") Entonces;
            Mostrar << "ID: ", Base.Lista[i].ID_Bloque, " | ", Base.Lista[i].Dia, " ", Base.Lista[i].Hora_Inicio, "-", Base.Lista[i].Hora_Fin, " | Aula: ", Base.Lista[i].Aula;
        Fin_Si
    Fin_Para
    Mostrar<<"===========================";
Fin_Procedimiento