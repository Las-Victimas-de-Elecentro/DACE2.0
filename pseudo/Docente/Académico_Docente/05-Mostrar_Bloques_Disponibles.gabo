Procedimiento Mostrar_Bloques_Disponibles(E/S: Bloque[i].ID_Bloque: Entero, Bloque[i].Dia, Bloque[i].Hora_Inicio, Bloque[i].Hora_Fin, Bloque[i].Aula, Bloque[i].Estado: Cadena);
Inicio
    Mostrar<<"=== Bloques disponibles ===";
    Var i: Entero;
    Para (i = 1 Hasta i = 48) Hacer;
        Si (Bloque[i].Estado = "Libre") Entonces;
            Mostrar << "ID: ", Bloque[i].ID_Bloque, " | ", Bloque[i].Dia, " ", Bloque[i].Hora_Inicio, "-", Bloque[i].Hora_Fin, " | Aula: ", Bloque[i].Aula;
        Fin_Si
    Fin_Para
    Mostrar<<"===========================";
Fin_Procedimiento