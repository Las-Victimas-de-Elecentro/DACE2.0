Procedimiento Agregar_Materia(E/S: pos: Entero, Prof[pos].Materias, Materias[I].Nombre, Materias[I].Codigo: Cadena, Prof[pos].Cant_Materias: Entero);
Inicio
    Var Cant, I: Entero;
    Var Materias, Codigo: Cadena;
    Mostrar << "¿Cuántas materias va a impartir?";
    Leer >> Cant;
    Mientras (Cant < 1 or Cant > 50) Hacer;
        Mostrar << "Solo positivos, y el límite no puede superar las 50 materias";
        Leer >> Cant;
    Fin_Mientras
    Si (Cant = 1) Entonces;
        Mostrar << "Ingrese el nombre de la materia que va a impartir";
        Leer >> Materias;
        Mostrar << "Ingrese el código de la materia";
        Leer >> Codigo;
        Para (I = 1 Hasta I = 527) Hacer;
            Si (Materias = Materias[I].Nombre) or (Codigo = Materias[I].Codigo) Entonces;
                Mostrar << "Materia encontrada.";
                Mostrar << "Impartirá la materia llamada: ", Materias[I].Nombre;
                Prof[pos].Materias = Materias;
                Prof[pos].Cant_Materias = Cant;
            Fin_Si
        Fin_Para
    Sino
        Mostrar << "Ingrese las materias que impartirá separadas por comas (Ejemplo: 'Matemática I, Lógica Matemática')";
        Leer >> Materias;
        Prof[pos].Materias = Materias;
        Prof[pos].Cant_Materias = Cant;
        Para (i = 1 Hasta i = Cant) Hacer;
            Mostrar << "Ingrese el nombre de las materias individualmente, aquí la materia n°", i, ":";
            Leer >> Materias;
            Mostrar << "Ingrese el código de la materia";
            Leer >> Codigo;
            Para (i = 1 Hasta i = 522) Hacer;
                Si (Materias = Materias[I].Nombre) or (Codigo = Materias[I].Codigo) Entonces;
                    Mostrar << "Materias encontrada.";
                    Mostrar << "Impartirá la materia llamada: ", Materias[I].Nombre;
                Fin_Si
            Fin_Para
        Fin_Para
    Fin_Si
Fin_Procedimiento