Procedimiento Publicar_Asignacion(E/S: pos, As: Entero, Prof[pos].Nombre, Asig[i].Nombre_Profesor, Asig[i].Titulo, Asig[i].Estado, Asig[i].Codigo_Materia: Cadena);
Inicio
    Var i: Entero;
    Var id: Entero, pos1, pos2 = 1: Entero;
    Var asig[pos2]: Entero;
    Si (As = 0) Entonces;
        Mostrar << "No hay asignaciones para publicar.";
    Sino
        Mostrar << "=== Asignaciones ===";
        Para (i = 1 Hasta i = As) Hacer;
            Si (Prof[pos].Nombre = Asig[i].Nombre_Profesor) Entonces;
                Mostrar << " | ", Asig[i].Titulo, " | Estado: ", Asig[i].Estado, " | Materia: ", Asig[i].Codigo_Materia;
                asig[pos2] = i;
                pos2 = pos2 + 1;
            Fin_Si
        Fin_Para
        Mostrar << "Ingrese el ID de la asignación a publicar:";
        pos1 = 0;
        Para (i = 1 Hasta i = pos2) Hacer;
            Mostrar << asig[i];
        Fin_Para
        Mostrar << "Debe ser alguno de esos IDs.";
        Leer >> id;
        Mientras (id < 1) Hacer;
            Mostrar << "Es invalido, solo positivos.";
            Leer >> id;
        Fin_Mientras
        Para (i = 1 Hasta i = As) Hacer;
            Si (asig[i] = id) Entonces;
                pos1 = i;
            Fin_Si
        Fin_Para
        Si (pos1 = 0) Entonces;
            Mostrar << "ID no encontrado.";
        Sino
            Asig[pos1].Estado = "Publicada";
            Mostrar << "Asignación publicada.";
        Fin_Si
    Fin_Si
Fin_Procedimiento