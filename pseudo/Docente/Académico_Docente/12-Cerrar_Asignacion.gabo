Procedimiento Cerrar_Asignacion(E/S: pos, As, Asig[i].ID_Asignacion: Entero, Prof[pos].Nombre, Asig[i].Nombre_Profesor, Asig[i].Estado, Asig[i].Titulo, Asig[i].Codigo_Materia, Asig[i].Fecha_Entrega: Cadena);
Inicio
    Var i: Entero;
    Var id: Entero;
    Var pos, pos2 = 1: Entero;
    Var asig[pos2]: Entero;
    Si (As = 0) Entonces;
        Mostrar << "No hay asignaciones para cerrar.";
    Sino
        Mostrar << "=== Asignaciones Publicadas ===";
        Para (i = 1 Hasta i = As) Hacer;
            Si (Prof[pos].Nombre = Asig[i].Nombre_Profesor) and (Asig[i].Estado = "Publicada") Entonces;
                Mostrar << " | ", Asig[i].Titulo, " | Materia: ", Asig[i].Codigo_Materia, " | Entrega: ", Asig[i].Fecha_Entrega;
                asig[pos2] = i;
                pos2 = pos2 + 1;
            Fin_Si
        Fin_Para
        Mostrar << "Ingrese el ID de la asignación a cerrar:";
        pos = 0;
        Para (i = 1 Hasta i = pos2) Hacer;
            Mostrar << asig[i];
        Fin_Para
        Mostrar << "Debe ser alguno de estos IDs";
        Leer >> id;
        Para (i = 1 Hasta i = As) Hacer;
            Si (asig[i] = id) Entonces;
                pos = i;
            Fin_Si
        Fin_Para
        Si (pos = 0) Entonces;
            Mostrar << "ID no encontrado.";
        Sino
            Asig[pos].Estado = "Cerrada";
            Mostrar << "Asignación cerrada. Se detienen entregas.";
        Fin_Si
    Fin_Si
    Para (I = 1 Hasta I = As) Hacer;
        Si (Asig[I].Estado = "Cerrada") Entonces;
            Asig[I].ID_Asignacion = Asig[As - 1].ID_Asignacion;
            Asig[I].Nombre_Profesor = Asig[As - 1].Nombre_Profesor;
            Asig[I].Codigo_Materia = Asig[As - 1].Codigo_Materia;
            Asig[I].Titulo = Asig[As - 1].Titulo;
            Asig[I].Descripcion = Asig[As - 1].Descripcion;
            Asig[I].Fecha_Publicacion = Asig[As - 1].Fecha_Publicacion;
            Asig[I].Fecha_Entrega = Asig[As - 1].Fecha_Entrega;
            Asig[I].Estado = Asig[As - 1].Estado;

            Asig[As - 1].ID_Asignacion = 0;
            Asig[As - 1].Nombre_Profesor = null;
            Asig[As - 1].Codigo_Materia = null;
            Asig[As - 1].Titulo = null;
            Asig[As - 1].Descripcion = null;
            Asig[As - 1].Fecha_Publicacion = null;
            Asig[As - 1].Fecha_Entrega = null;
            Asig[As - 1].Estado = null;
            As = As - 1;
        Fin_Si
    Fin_Para
Fin_Procedimiento