Procedimiento Crear_Asignacion(E/S: Prof[pos].Nombre, Asig[i].Titulo, Asig[i].Codigo_Materia, Asig[i].Descripcion, Asig[i].Fecha_Publicacion, Asig[i].Fecha_Entrega, Asig[i].Estado, cod: Cadena, pos, As: Entero, ok: Booleano, [Procedimiento Buscar_Materia(Materias[i].Codigo, cod, ok)]);
Inicio 
    Var ok: Booleano;
    Mostrar << "=== Creación de Asignación ===";
    Mostrar << "Código de materia:";
    Leer >> cod;
    Buscar_Materia(Materias[i].Codigo, cod, ok);
    Si (ok = 0) Entonces;
        Mostrar << "Materia no encontrada.";
    Sino
        Asig[As].Codigo_Materia = cod;
        Asig[As].Nombre_Profesor = Prof[pos].Nombre;
        Mostrar << "Título:";
        Leer >> Asig[As].Titulo;
        Mostrar << "Descripción:";
        Leer >> Asig[As].Descripcion;
        Mostrar << "Fecha de publicación (YYYY-MM-DD):";
        Leer >> Asig[As].Fecha_Publicacion;
        Mostrar << "Fecha de entrega (YYYY-MM-DD):";
        Leer >> Asig[As].Fecha_Entrega;
        Asig[As].Estado = "Borrador";
        Mostrar << "La tarea ha sido sembrada (en borrador).";
        As = As + 1;
    Fin_Si
Fin_Procedimiento