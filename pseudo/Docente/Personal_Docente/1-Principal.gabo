Procedimiento Docente_Personal(E/S: Avatares[I], Prof[pos].Avatar, Prof[pos].Nombre, Prof[pos].Gmail, Prof[pos].Password, Prof[pos].Salud[pos].Transmisibles, Prof[pos].Salud[pos].Cronicas, Prof[pos].Salud[pos].Neurologicas, Prof[pos].Salud[pos].Neoplasias, Prof[pos].Salud[pos].Autoinmunes, Prof[pos].Salud[pos].Trastornos, Prof[pos].Salud[pos].Lesiones, Prof[pos].Salud[pos].Congenitas, Prof[pos].Salud[pos].Metabolicos, Prof[pos].Salud[pos].Ocupacionales, Clase[I].Codigo_Materia, Clase[I].Nombre_Materia, Clase[I].Periodo, Clase[I].Nombre_Profesor, Clase[I].Dia, Clase[I].Hora_Inicio, Clase[I].Hora_Fin, Clase[I].Aula: Cadena, Prof[pos].CI, Clase[I].Cant_Estudiantes: Entero, Tema: Booleano);
Inicio
    var Opc: Entero, R: Booleano;
    Repetir
        Mostrar << "Bienvenido a tu perfil personal de profesor";
        Mostrar << "Aqui puedes gestionar tu informacion, seguridad y preferencias";
        Mostrar << "Seleccione una opción";
        Mostrar << "1: Información personal";
        Mostrar << "2: Seguridad";
        Mostrar << "3: Historial Labor Docente";
        Mostrar << "4: Modo Oscuro";
        Mostrar << "5: Avatar";
        Mostrar << "6: Salud";
        Mostrar << "0: Salir";
        Leer >> Opc;
        Mientras (Opc < 0 Or Opc > 6) Hacer;
            Mostrar << "Ingrese solo opciones entre 1-6";
            Leer >> Opc;
        Fin_Mientras
        En_Caso (Opc > 0) Sea;
            Caso(Opc = 1);
                Informacion_Personal_Prof(Prof[pos].Avatar, Prof[pos].Nombre, Prof[pos].Gmail, Prof[pos].CI);
                Mostrar << Informacion_Personal_Prof;
            Caso(Opc = 2);
                Seguridad_Personal_Prof(Prof[pos].Password, Prof[pos].Gmail);
                Mostrar << Seguridad_Personal_Prof;
            Caso(Opc = 3);
                Historial_Personal_Prof(Clase[I].Codigo_Materia, Clase[I].Nombre_Materia, Clase[I].Periodo, Clase[I].Nombre_Profesor, Clase[I].Dia, Clase[I].Hora_Inicio, Clase[I].Hora_Fin, Clase[I].Aula, Clase[I].Cant_Estudiantes);
                Mostrar << Historial_Personal_Prof;
            Caso(Opc = 4);
                Oscuro_Personal_Prof(Tema);
                Mostrar << Oscuro_Personal_Prof;
            Caso(Opc = 5);
                Avatares (Avatares[I]);
                Avatar_Personal_Prof(Avatares[I], Prof[pos].Avatar);
                Mostrar << Avatar_Personal_Prof;
            Caso (Opc = 6);
                Salud_Personal_Prof(Prof[pos].Salud[pos].Transmisibles, Prof[pos].Salud[pos].Cronicas, Prof[pos].Salud[pos].Neurologicas, Prof[pos].Salud[pos].Neoplasias, Prof[pos].Salud[pos].Autoinmunes, Prof[pos].Salud[pos].Trastornos, Prof[pos].Salud[pos].Lesiones, Prof[pos].Salud[pos].Congenitas, Prof[pos].Salud[pos].Metabolicos, Prof[pos].Salud[pos].Ocupacionales);
                Mostrar << Salud_Personal_Prof;
            Otro_Caso
                R = 0;
        Fin_Caso
        Mostrar << "¿Desea elegir otra opción? Ingrese 1: Sí, 0:No";
        Leer >> R;
        Hasta(R = 0);
    Fin_Repetir
Fin_Procedimiento