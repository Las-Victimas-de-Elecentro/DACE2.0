Procedimiento Docente_Personal([Procedimiento Informacion_Docente(Prof[pos].Avatar, Prof[pos].Nombre, Prof[pos].Gmail, pos, Prof[pos].CI)], [Procedimiento Seguridad_Docente(indice, pos, pass, Prof[pos].Password, Prof[pos].Gmail, Acceso, [Procedimiento Validar_Coordenada_Prof(pos, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna, Minimo, Maximo, Acceso)], [Procedimiento Encriptacion(indice, pass)])], [Procedimiento Historial_Docente(Prof[pos].Nombre, Clase[I].Codigo_Materia, Clase[I].Nombre_Materia, Clase[I].Periodo, Clase[I].Nombre_Profesor, Clase[I].Dia, Clase[I].Hora_Inicio, Clase[I].Hora_Fin, Clase[I].Aula, class, pos, Clase[I].Seccion, Clase[I].Cant_Estudiantes)], [Procedimiento Modo_Oscuro(Tema)], [Procedimiento Avatar_Docente(pos, Avatares[I], Prof[pos].Avatar)], [Procedimiento Salud_Docente(pos, Prof[pos].Salud[pos].Transmisibles, Prof[pos].Salud[pos].Cronicas, Prof[pos].Salud[pos].Neurologicas, Prof[pos].Salud[pos].Neoplasias, Prof[pos].Salud[pos].Autoinmunes, Prof[pos].Salud[pos].Trastornos, Prof[pos].Salud[pos].Lesiones, Prof[pos].Salud[pos].Congenitas, Prof[pos].Salud[pos].Metabolicos, Prof[pos].Salud[pos].Ocupacionales)]);
Inicio
    Var Opc: Entero, R: Booleano;
    Repetir
        Mostrar << "Bienvenido a tu perfil personal de profesor";
        Mostrar << "Aqui puedes gestionar tu informacion, seguridad y preferencias";
        Mostrar << "Seleccione una opción";
        Mostrar << "1: Información personal";
        Mostrar << "2: Seguridad";
        Mostrar << "3: Historial Labor Docente";
        Mostrar << "4: Modo Oscuro";
        Mostrar << "5: Avatar";
        Mostrar << "6: Salud";
        Mostrar << "0: Salir";
        Leer >> Opc;
        Mientras (Opc < 0 Or Opc > 6) Hacer;
            Mostrar << "Ingrese solo opciones entre 1-6";
            Leer >> Opc;
        Fin_Mientras
        En_Caso (Opc > 0) Sea;
            Caso(Opc = 1);
                Informacion_Docente(Prof[pos].Avatar, Prof[pos].Nombre, Prof[pos].Gmail, pos, Prof[pos].CI);
                Mostrar << Informacion_Docente;
            Caso(Opc = 2);
                Seguridad_Docente(indice, pos, pass, Prof[pos].Password, Prof[pos].Gmail, Acceso, [Procedimiento Validar_Coordenada_Prof(pos, Tarjeta_P[I].ID, Tarjeta_P[I].Fila, Tarjeta_P[I].Columna, Minimo, Maximo, Acceso)], [Procedimiento Encriptacion(indice, pass)]);
                Mostrar << Seguridad_Docente;
            Caso(Opc = 3);
                Historial_Docente(Prof[pos].Nombre, Clase[I].Codigo_Materia, Clase[I].Nombre_Materia, Clase[I].Periodo, Clase[I].Nombre_Profesor, Clase[I].Dia, Clase[I].Hora_Inicio, Clase[I].Hora_Fin, Clase[I].Aula, class, pos, Clase[I].Seccion, Clase[I].Cant_Estudiantes);
                Mostrar << Historial_Docente;
            Caso(Opc = 4);
                Modo_Oscuro(Tema);
                Mostrar << Modo_Oscuro;
            Caso(Opc = 5);
                Avatar_Docente(pos, Avatares[I], Prof[pos].Avatar);
                Mostrar << Avatar_Docente;
            Caso (Opc = 6);
                Salud_Docente(pos, Prof[pos].Salud[pos].Transmisibles, Prof[pos].Salud[pos].Cronicas, Prof[pos].Salud[pos].Neurologicas, Prof[pos].Salud[pos].Neoplasias, Prof[pos].Salud[pos].Autoinmunes, Prof[pos].Salud[pos].Trastornos, Prof[pos].Salud[pos].Lesiones, Prof[pos].Salud[pos].Congenitas, Prof[pos].Salud[pos].Metabolicos, Prof[pos].Salud[pos].Ocupacionales);
                Mostrar << Salud_Docente;
            Otro_Caso
                R = 0;
        Fin_Caso
        Mostrar << "¿Desea elegir otra opción? Ingrese 1: Sí, 0:No";
        Leer >> R;
        Hasta(R = 0);
    Fin_Repetir
Fin_Procedimiento