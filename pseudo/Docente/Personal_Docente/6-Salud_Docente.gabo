Procedimiento Salud_Docente(E/S: pos: Entero, Prof[pos].Salud[pos].Transmisibles, Prof[pos].Salud[pos].Cronicas, Prof[pos].Salud[pos].Neurologicas, Prof[pos].Salud[pos].Neoplasias, Prof[pos].Salud[pos].Autoinmunes, Prof[pos].Salud[pos].Trastornos, Prof[pos].Salud[pos].Lesiones, Prof[pos].Salud[pos].Congenitas, Prof[pos].Salud[pos].Metabolicos, Prof[pos].Salud[pos].Ocupacionales: Cadena);
Inicio
    Var Opc: Entero, R: Booleano;
    Repetir
        Mostrar << "Ingreso de información de salud";
        Mostrar << "¿Que tipo de enfermedad desea ingresar?";
        Mostrar << "Ingrese una opción";
        Mostrar << "1: Transmisibles";
        Mostrar << "2: Cronicas";
        Mostrar << "3: Neurologicas";
        Mostrar << "4: Neoplasias";
        Mostrar << "5: Autoinmunes";
        Mostrar << "6: Trastornos";
        Mostrar << "7: Lesiones";
        Mostrar << "8: Congenitas";
        Mostrar << "9: Metabolicos";
        Mostrar << "10: Ocupacionales";
        Leer >> Opc;
        Mientras (Opc < 1 Or Opc > 10) Hacer;
            Mostrar << "Ingrese solo opciones entre 1-10";
            Leer >> Opc;
        Fin_Mientras
        En_Caso (Opc > 0) Sea;
            Caso(Opc = 1);
                Mostrar << "Ingrese la enfermedad transmisible que padece";
                Leer >> Prof[pos].Salud[pos].Transmisibles;
            Caso(Opc = 2);
                Mostrar << "Ingrese la enfermedad cronica que padece";
                Leer >> Prof[pos].Salud[pos].Cronicas;
            Caso(Opc = 3);
                Mostrar << "Ingrese la enfermedad neurologica que padece";
                Leer >> Prof[pos].Salud[pos].Neurologicas;
            Caso(Opc = 4);
                Mostrar << "Ingrese la enfermedad neoplasia que padece";
                Leer >> Prof[pos].Salud[pos].Neoplasias;
            Caso(Opc = 5);
                Mostrar << "Ingrese la enfermedad autoinmune que padece";
                Leer >> Prof[pos].Salud[pos].Autoinmunes;
            Caso(Opc = 6);
                Mostrar << "Ingrese el transtorno que padece";
                Leer >> Prof[pos].Salud[pos].Trastornos;
            Caso(Opc = 7);
                Mostrar << "Ingrese la lesión que padece";
                Leer >> Prof[pos].Salud[pos].Lesiones;
            Caso(Opc = 8);
                Mostrar << "Ingrese la enfermedad congenita que padece";
                Leer >> Prof[pos].Salud[pos].Congenitas;
            Caso(Opc = 9);
                Mostrar << "Ingrese el transtorno metabolico que padece";
                Leer >> Prof[pos].Salud[pos].Metabolicos;
            Otro_Caso
                Mostrar << "Ingrese la enfermedad ocupacional que padece";
                Leer >> Prof[pos].Salud[pos].Ocupacionales;
        Fin_Caso
        Mostrar << "Enfermedad ingresada con extio";
        Mostrar << "¿Desea ingresar otra enfermedad? Ingrese 1:Sí / 0:No";
        Leer >> R;
        Hasta(R = 0);
    Fin_Repetir
Fin_Procedimiento