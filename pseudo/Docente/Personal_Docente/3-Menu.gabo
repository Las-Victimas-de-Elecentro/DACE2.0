Procedimiento Menu_Personal_Prof();
Inicio
    var Opc: entero, R: Booleano;
    Repetir
        Mostrar << "Bienvenido a tu perfil personal de profesor";
        Mostrar << "Aqui puedes gestionar tu informacion, seguridad y preferencias";
        Mostrar << "Seleccione una opción";
        Mostrar << "1: Información personal";
        Mostrar << "2: Seguridad";
        Mostrar << "3: Historial Labor Docente";
        Mostrar << "4: Modo Oscuro";
        Mostrar << "5: Avatar";
        Mostrar << "6: Salud";
        Leer >> Opc;
        Mientras (Opc < 1 Or Opc > 6) Hacer;
            Mostrar << "Ingrese solo opciones entre 1-6";
            Leer >> Opc;
        Fin_Mientras
        En_Caso (Opc > 0) Sea;
            Caso(Opc = 1);
                Informacion_Personal_Prof(Prof[pos].Avatar, Prof[pos].Nombre, Prof[pos].Gmail, Prof[pos].CI);
                Mostrar << Informacion_Personal_Prof;
            Caso(Opc = 2);
                Seguridad_Personal_Prof(Prof[pos].Password, Prof[pos].Gmail);
                Mostrar << Seguridad_Personal_Prof;
            Caso(Opc = 3);
                Historial_Personal_Prof(Clase[pos].Codigo_Materia, Clase[pos].Nombre_Materia, Clase[pos].Periodo, Clase[pos].Cant_Profudiantes);
                Mostrar << Historial_Personal_Prof;
            Caso(Opc = 4);
                Oscuro_Personal_Prof(Tema);
                Mostrar << Oscuro_Personal_Prof;
            Caso(Opc = 5);
                Avatares (Avatares[10]);
                Avatar_Personal_Prof(Avatares[10], Prof[pos].Avatar);
                Mostrar << Avatar_Personal_Prof;
            Otro_Caso
                Salud_Personal_Prof(Prof.Salud[pos].Transmisibles, Prof.Salud[pos].Cronicas, Prof.Salud[pos].Neurologicas, Prof.Salud[pos].Neoplasias, Prof.Salud[pos].Autoinmunes, Prof.Salud[pos].Trastornos, Prof.Salud[pos].Lesiones, Prof.Salud[pos].Congenitas, Prof.Salud[pos].Metabolicos, Prof.Salud[pos].Ocupacionales);
                Mostrar << Salud_Personal_Prof;
        Fin_Caso
        Mostrar << "¿Desea elegir otra opción? Ingrese 1:Si, 0:No";
        Leer R;
        Hasta(R = 0);
    Fin_Repetir

Fin_Procedimiento