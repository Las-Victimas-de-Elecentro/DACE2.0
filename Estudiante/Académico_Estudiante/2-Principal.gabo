Procedimiento Academico_Estudiante();
Inicio
    Var opc: Entero;
    Var R: Booleano;
    Repetir
        Mostrar << "¡Bienvenido a la sección acádemica!";
        Mostrar << "¿Qué desea hacer?";
        Mostrar << "1: Ver su Horario";
        Mostrar << "2: Inscripciones";
        Mostrar << "3: Asignaciones";
        Mostrar << "4: Solicitudes";
        Mostrar << "5: Reportes";
        Mostrar << "6: Notas";
        Mostrar << "7: Clases Magistrales";
        Mostrar << "8: Planes de Evaluación";
        Mostrar << "9: Carnetización";
        Mostrar << "10: Pasantías";
        Mostrar << "11: Servicio Comunitario";
        Leer >> opc;
        Mientras (opc < 1 or opc > 11) Hacer;
            Mostrar << "Es invalido";
            Leer >> opc;
        Fin_Mientras
        En_Caso (opc > 0) Sea;
            Caso(opc = 1);
                Horario();
                Mostrar << Horario;
            Caso(opc = 2);
                Inscripciones();
                Mostrar << Inscripciones;
            Caso(opc = 3);
                Asignaciones();
            Caso(opc = 4);
                Registrar_Solicitud_Estudiante();
                Mostrar << Registrar_Solicitudes_Estudiante;
            Caso(opc = 5);
                Registrar_Reporte_Estudiante();
                Mostrar << Registrar_Reporte_Estudiante;
            Caso(opc = 6);
                Historial();
                Mostrar << Historial;
            Caso(opc = 7);
                Clases_Magistrales();
                Mostrar << Clases_Magistrales;
            Caso(opc = 8);
                Plan_Evaluacion();
            Caso(opc = 9);
                Carnetizacion();
            Caso(opc = 10);
                Pasantias();
                Mostrar << Pasantias;
            Otro_Caso
                Servicio_Comunitario();
                Mostrar << Servicio_Comunitario;
        Fin_Caso
        Mostrar << "¿Desea salir del sistema? 1: Sí, 0: No";
        Leer >> R;
        Hasta(R = 1);
    Fin_Repetir
Fin_Procedimiento