Procedimiento Buscar_Materia(E: Prof:Docente, E: codigo: Cadena, E/S: pos: Entero, E/S: encontrado: Booleano);
Inicio
Var i: Entero;
    encontrado = Falso;
    pos = 0;
    Para (i = 1 Hasta i = Prof.Cant_Materias) Hacer;
        Si (Prof.Materias[i].Codigo = codigo) Entonces;
            encontrado = 1;
            pos = i;
        Fin_Si
    Fin_Para
Fin_Procedimiento