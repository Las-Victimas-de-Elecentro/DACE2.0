Procedimiento Economia();
Inicio
    Mostrar << "Aquí los bloques disponibles para que pueda organizar sus materias:";
    Para (i = 1 Hasta i = 48) Hacer;
        Si (Base.Lista[i].Estado = "Libre") Entonces;
            Mostrar << "ID: ", Base.Lista[i].ID_Bloque, " | ", Base.Lista[i].Dia, " ", Base.Lista[i].Hora_Inicio, "-", Base.Lista[i].Hora_Fin, " | Aula: ", Base.Lista[i].Aula;
        Fin_Si
    Fin_Para
    //Primer Semestre
    Si (Datos[pos_usuario].UC_Aprobadas = 0) Entonces;
        Mostrar << "Introduccion a la Economia";
        Mostrar << "Analisis Matematico I";
        Mostrar << "Lenguaje y Comunicacion";
        Mostrar << "Fundamentos del Derecho";
        Mostrar << "Metodologia de la Investigacion";
        Mostrar << "Deporte y Recreacion";
        Mostrar << "Ingles Instrumental";
        Para (I = 1 Hasta I = 7) Hacer;
            Mostrar << Inscripcion;
        Fin_Para
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Introduccion_Economia < 5.5) Entonces;
        Mostrar << "Introducción a la Economía";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Matematico_I < 5.5) Entonces;
        Mostrar << "Análisis Matemático I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Lenguaje_Comunicacion < 5.5) Entonces;
        Mostrar << "Lenguaje y Comunicación";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Fundamentos_Derecho < 5.5) Entonces;
        Mostrar << "Fundamentos del Derecho";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Metodologia_Investigacion < 5.5) Entonces;
        Mostrar << "Metodología de la Investigación";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Deporte_Recreacion < 5.5) Entonces;
        Mostrar << "Deporte y Recreación";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Ingles_Instrumental < 5.5) Entonces;
        Mostrar << "Inglés Instrumental";
        Mostrar << Inscripcion;
    Fin_Si

    //Segundo Semestre
    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Introduccion_Economia > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_I < 5.5) Entonces;
        Mostrar << "Economía I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Sociologia < 5.5) Entonces;
        Mostrar << "Sociología";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Matematico_I > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Matematico_II < 5.5) Entonces;
        Mostrar << "Análisis Matemático II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_General_I < 5.5) Entonces;
        Mostrar << "Contabilidad General I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Informatica < 5.5) Entonces;
        Mostrar << "Informática";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Arte_Cultura < 5.5) Entonces;
        Mostrar << "Arte y Cultura";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_I < 5.5) Entonces;
        Mostrar << "Estadística I";
        Mostrar << Inscripcion;
    Fin_Si

    //Tercer Semestre
    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_I > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_II < 5.5) Entonces;
        Mostrar << "Economía II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Sociopolitica_Productiva < 5.5) Entonces;
        Mostrar << "Sociopolitica Productiva";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_I > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_II < 5.5) Entonces;
        Mostrar << "Estadística II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_General_I > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_General_II < 5.5) Entonces;
        Mostrar << "Contabilidad General II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Introduccion_Administracion < 5.5) Entonces;
        Mostrar << "Introducción a la Administración";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Historia_Doctrina_Economica < 5.5) Entonces;
        Mostrar << "Sociopolitica Productiva";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Informatica > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Informatica_Aplicada < 5.5) Entonces;
        Mostrar << "Informática Aplicada";
        Mostrar << Inscripcion;
    Fin_Si

    //Cuarto Semestre
    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_II > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Macroeconomia_I < 5.5) Entonces;
        Mostrar << "Macroeconomía I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_I > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Financiero < 5.5) Entonces;
        Mostrar << "Análisis Financiero";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Matematica_II > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Matematica_III < 5.5) Entonces;
        Mostrar << "Matemática III";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_II > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Microeconomia_I < 5.5) Entonces;
        Mostrar << "Microeconomía I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Teoria_Investigacion_Mercado < 5.5) Entonces;
        Mostrar << "Teoría e Investigación de Mercado";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_I < 5.5) Entonces;
        Mostrar << "Seminario I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_II > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Estadistica_Aplicada < 5.5) Entonces;
        Mostrar << "Estadística Aplicada";
        Mostrar << Inscripcion;
    Fin_Si

    //Quinto Semestre
    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Macroeconomia_I > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Macroeconomia_II < 5.5) Entonces;
        Mostrar << "Macroeconomía II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Microeconomia_I > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Microeconomia_II < 5.5) Entonces;
        Mostrar << "Microeconomía II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Matematico_II > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Matematica_Financiera < 5.5) Entonces;
        Mostrar << "Matemática Financiera";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_Social < 5.5) Entonces;
        Mostrar << "Contabilidad Social";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Desarrollo_Economico < 5.5) Entonces;
        Mostrar << "Desarrollo Económico";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Analisis_Economico_Regional < 5.5) Entonces;
        Mostrar << "Análisis Económico Regional";
        Mostrar << Inscripcion;
    Fin_Si

    //Sexto Semestre
    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Politica < 5.5) Entonces;
        Mostrar << "Economía Política";
        Mostrar << Inscripcion;
    Fin_Si
    
    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Formulacion_Evaluacion_Proyectos < 5.5) Entonces;
        Mostrar << "Formulacion y Evaluación de Proyectos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Investigacion_Operaciones < 5.5) Entonces;
        Mostrar << "Investigación de Operaciones";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Teoria_Politica_Fiscal < 5.5) Entonces;
        Mostrar << "Teoría y Política Fiscal";
        Mostrar << Inscripcion;
    Fin_Si
    
    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_I > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_II < 5.5) Entonces;
        Mostrar << "Seminario II";
        Mostrar << Inscripcion;
    Fin_Si

    //Electiva I
    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Politica_Agricola < 5.5) Entonces;
        Mostrar << "Economía y Política Agrícola";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Industrial < 5.5) Entonces;
        Mostrar << "Economía Industrial";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Minera < 5.5) Entonces;
        Mostrar << "Economía Minera y Petrolera";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Ambiente < 5.5) Entonces;
        Mostrar << "Economía Ambiente y Sociedad";
        Mostrar << Inscripcion;
    Fin_Si

    //Séptimo Semestre
    Si (Datos[pos_usuario].Semestre >= 7) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_II > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_III < 5.5) Entonces;
        Mostrar << "Seminario III";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 7) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Econometria < 5.5) Entonces;
        Mostrar << "Econometría";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 7) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Teoria_Politica_Monetaria < 5.5) Entonces;
        Mostrar << "Teoría y Política Monetaria";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 7) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Planificacion < 5.5) Entonces;
        Mostrar << "Planificación";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 7) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Economia_Internacional < 5.5) Entonces;
        Mostrar << "Economía Internacional";
        Mostrar << Inscripcion;
    Fin_Si

    //Electiva II
    Si (Datos[pos_usuario].Semestre >= 7) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Formulacion_Evaluacion_Agricola < 5.5) Entonces;
        Mostrar << "Formulación y Evaluación de Proyectos Agrícolas";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 7) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Gestion_Comunitaria < 5.5) Entonces;
        Mostrar << "Gestión Comunitaria";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 7) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Contabilidad_Costos < 5.5) Entonces;
