    Si (Datos[pos_usuario].Semestre >= 7) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Presupuesto < 5.5) Entonces;
        Mostrar << "Presupuesto";
        Mostrar << Inscripcion;
    Fin_Si

    //Octavo Semestre
    Si (Datos[pos_usuario].Semestre >= 8) and (Datos[pos_usuario].UC_Aprobadas >= 206) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Seminario_II > 5.5) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Trabajo_Final_Grado < 5.5) Entonces;
        Mostrar << "Trabajo Final de Grado";
        Mostrar << Inscripcion;
    Fin_Si

    //Electiva III
    Si (Datos[pos_usuario].Semestre >= 8) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Finanzas_Internacionales < 5.5) Entonces;
        Mostrar << "Finanzas Internacionales";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 8) and (Datos[pos_usuario].Materias.Eco[pos_usuario].Estructura_Economica_Mundial < 5.5) Entonces;
