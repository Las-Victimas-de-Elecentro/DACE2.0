Procedimiento Cambiar_Estado_Reporte(E/S: Prof:Docente);
Inicio
    Si (Prof.Cant_Reportes = 0) Entonces;
        Mostrar << "No hay reportes registrados.";
    Sino
        Var i: Entero;
        Mostrar << "=== Reportes ===";
        Para (i = 1 Hasta i = Prof.Cant_Reportes) Hacer;
            Mostrar << "ID: ", Prof.Reportes[i].ID_Reporte, " | Estado: ", Prof.Reportes[i].Estado, " | Fecha: ", Prof.Reportes[i].Fecha;
        Fin_Para
        Mostrar << "Ingrese el ID del reporte a actualizar:";
        Var id: Entero, pos: Entero; pos = 0;
        Leer >> id;
        Para (i = 1 Hasta i = Prof.Cant_Reportes) Hacer;
            Si (Prof.Reportes[i].ID_Reporte = id) Entonces;
                pos = i;
            Fin_Si
        Fin_Para
        Si (pos = 0) Entonces;
            Mostrar << "ID no encontrado.";
        Sino
            Mostrar << "Nuevo estado (Pendiente, Atendido, En progreso):";
            Var nuevo: Cadena;
            Leer >> nuevo;
            Prof.Reportes[pos].Estado = nuevo;
            Mostrar << "Estado actualizado.";
        Fin_Si
    Fin_Si
Fin_Procedimiento