Procedimiento Publicar_Asignacion(E/S:Prof:Docente);
Inicio
    Var i: Entero;
    Var id: Entero, pos: Entero;
    Si (Prof.Cant_Asignaciones = 0) Entonces;
        Mostrar << "No hay asignaciones para publicar.";
    Sino
        Mostrar << "=== Asignaciones ===";
        Para (i = 1 Hasta i = Prof.Cant_Asignaciones) Hacer;
            Mostrar << "ID: ", Prof.Asignaciones[i].ID_Asignacion, " | ", Prof.Asignaciones[i].Titulo, " | Estado: ", Prof.Asignaciones[i].Estado, " | Materia: ", Prof.Asignaciones[i].Codigo_Materia;
        Fin_Para
        Mostrar << "Ingrese el ID de la asignación a publicar:";
        pos = 0;
        Leer >> id;
        Para (i = 1 Hasta i = Prof.Cant_Asignaciones) Hacer;
            Si (Prof.Asignaciones[i].ID_Asignacion = id) Entonces;
                pos = i;
            Fin_Si
        Fin_Para
        Si (pos = 0) Entonces;
            Mostrar << "ID no encontrado.";
        Sino
            Prof.Asignaciones[pos].Estado = "Publicada";
            Mostrar << "Asignación publicada.";
        Fin_Si
    Fin_Si
Fin_Procedimiento