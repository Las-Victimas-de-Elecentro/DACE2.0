Procedimiento Informatica();
Inicio
    Var q: Booleano;
    Inscripcion(Materias[J].Codigo, Clase[K].Codigo, Clase[K].Nombre_Profesor, Clase[K].Dia, Clase[K].Hora_Inicio, Clase[K].Hora_Fin, Clase[K].Aula, List[L].Nombre, Datos[I].Nombre, Clase[K].Seccion, List[L].Cedula, Datos[I].CI, Clase[K].Cant_Estudiantes, L);
    Mostrar << "Aquí los bloques disponibles para que pueda organizar sus materias:";
    Para (i = 1 Hasta i = 48) Hacer;
        Si (Base.Lista[i].Estado = "Libre") Entonces;
            Mostrar << "ID: ", Base.Lista[i].ID_Bloque, " | ", Base.Lista[i].Dia, " ", Base.Lista[i].Hora_Inicio, "-", Base.Lista[i].Hora_Fin, " | Aula: ", Base.Lista[i].Aula;
        Fin_Si
    Fin_Para
    //Primer Semestre
    Si (Datos[pos_usuario].UC_Aprobadas = 0) Entonces;
        Mostrar << "Tiene estas materias disponibles para inscribir:";
        Mostrar << "Matemática I";
        Mostrar << "Fundamentos de la Informática";
        Mostrar << "Lógica Matemática";
        Mostrar << "Lenguaje y Comunicación";
        Mostrar << "Inglés I";
        Mostrar << "Formación Constitucional";
        Mostrar << "Economía Digital";
        Mostrar << "Deporte";
        Para (I = 1 Hasta I = 8) Hacer;
            Mostrar << Inscripcion;
        Fin_Para
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Info[pos_usuario].Lenguaje_Comunicacion < 5.5) Entonces;
        Mostrar << "Lenguaje y Comunicación";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Info[pos_usuario].Economia_Digital < 5.5) Entonces;
        Mostrar << "Economía Digital";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Info[pos_usuario].Deporte < 5.5) Entonces;
        Mostrar << "Deporte";
        Mostrar << Inscripcion;
    Fin_Si
    //Segundo Semestre
    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Matematica_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Matematica_II < 5.5) Entonces;
        Mostrar << "Matemática II";
        Mostrar << Inscripcion;
    Sino
        Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Info[pos_usuario].Matematica_I < 5.5) Entonces;
            Mostrar << "Matemática I";
            Mostrar << Inscripcion;
        Fin_Si
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Matematica_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Fisica_I < 5.5) Entonces;
        Mostrar << "Física I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Fundamentos_Informatica > 5.5) And (Datos[pos_usuario].Materias.Info[pos_usuario].Logica_Matematica > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Algoritmos_I < 5.5) Entonces;
        Mostrar << "Algoritmos I:...";
        Mostrar << Inscripcion;
    Sino
        Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Info[pos_usuario].Fundamentos_Informatica < 5.5) Entonces;
            Mostrar << "Fundamentos de la Informática";
            Mostrar << Inscripcion;
        Sino
            Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Info[pos_usuario].Logica_Matematica < 5.5) Entonces;
                Mostrar << "Lógica Matemática";
                Mostrar << Inscripcion;
            Fin_Si
        Fin_Si
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Ingles_I > 5.5) Entonces;
        Mostrar << "Inglés II";
        Mostrar << Inscripcion;
    Sino
        Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Info[pos_usuario].Ingles_I < 5.5) Entonces;
            Mostrar << "Inglés I";
            Mostrar << Inscripcion;
        Fin_Si
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 13) and (Datos[pos_usuario].Materias.Info[pos_usuario].Prob_Cient_Tec < 5.5) Entonces; //13 UC Aprobadas
        Mostrar << "Problemática Científica Tecnológica";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Formacion_Constitucional > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Arte_Y_Cultura < 5.5) Entonces;
        Mostrar << "Arte y Cultura";
        Mostrar << Inscripcion;
    Sino   
        Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Info[pos_usuario].Formacion_Constitucional < 5.5) Entonces;
            Mostrar << "Formación Constitucional";
            Mostrar << Inscripcion;
        Fin_Si
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 13) and (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_I < 5.5) Entonces;
        Mostrar << "Electiva I";
        Mostrar << Inscripcion;
    Fin_Si

    //Tercer Semestre
    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Matematica_II > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Matematica_III < 5.5) Entonces;
        Mostrar << "Matemática III";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Fisica_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Fisica_II < 5.5) Entonces;
        Mostrar << "Física II";
        Mostrar << Inscripcion;
    Fin_Si
    
    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Algoritmos_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Algoritmos_II < 5.5) Entonces;
        Mostrar << "Algoritmos II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Algoritmos_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Programacion_I < 5.5) Entonces;
        Mostrar << "Programación I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_II < 5.5) Entonces;
        Mostrar << "Electiva II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 30) and (Datos[pos_usuario].Materias.Info[pos_usuario].Tecnicas_Investigacion < 5.5) Entonces; //30 UC Aprobadas
        Mostrar << "Metodología y Técnicas de Investigación";
        Mostrar << Inscripcion;
    Fin_Si

    //Cuarto Semestre
    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Matematica_III > 5.5) and (Datos.Materias.Info[pos_usuario].Matematica_IV < 5.5) Entonces;
        Mostrar << "Matemática IV";
        Mostrar << Inscripcion;
    Fin_Si
    
    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Matematica_III > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Probabilidad_Estadistica < 5.5) Entonces;
        Mostrar << "Probabilidad y Estadística";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Algoritmos_II > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Estructuras_Discretas_I < 5.5) Entonces;
        Mostrar << "Estructuras Discretas I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Programacion_I > 5.5) and (Datos.Materias.Info[pos_usuario].Algoritmos_II > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Programacion_II < 5.5) Entonces;
        Mostrar << "Programación II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Programacion_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Base_Datos < 5.5) Entonces;
        Mostrar << "Base de Datos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_II > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_III < 5.5) Entonces;
        Mostrar << "Electiva III";
        Mostrar << Inscripcion;
    Fin_Si

    //Quinto Semestre
    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Fisica_II > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Organizacion_Computador < 5.5) Entonces;
        Mostrar << "Organización del Computador";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Estructuras_Discretas_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Algebra_Booleana < 5.5) Entonces;
        Mostrar << "Algebra Booleana";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Estructuras_Discretas_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Estructuras_Discretas_II < 5.5) Entonces;
        Mostrar << "Estructuras Discretas II";
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Programacion_II > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Programacion_III < 5.5) Entonces;
        Mostrar << "Programación III";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_III > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_IV < 5.5) Entonces;
        Mostrar << "Electiva IV";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 50) and (Datos.Materias.Info[pos_usuario].Teoria_Sistemas < 5.5) Entonces; //50 UC Aprobadas
        Mostrar << "Teoría de Sistemas";
        Mostrar << Inscripcion;
    Fin_Si

    //Sexto Semestre
    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Organizacion_Computador > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Arquitectura_Computador < 5.5) Entonces;
        Mostrar << "Arquitectura del Computador";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Matematica_IV > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Estructuras_Discretas_II > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Metodos_Numericos < 5.5) Entonces;
        Mostrar << "Métodos Numéricos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos.Materias.Info[pos_usuario].Probabilidad_Estadistica > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Investigacion_Operaciones < 5.5) Entonces;
        Mostrar << "Investigación de Operaciones";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Base_Datos > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Teoria_Sistemas > 5.5) and (Datos.Materias.Info[pos_usuario].Sistemas_Informacion_I < 5.5) Entonces;
        Mostrar << "Sistemas de Información I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_IV > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_V < 5.5) Entonces;
        Mostrar << "Electiva V";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 70) and (Datos[pos_usuario].Materias.Info[pos_usuario].Ingenieria_Economica < 5.5) Entonces; //70 UC Aprobadas
        Mostrar << "Ingeniería Económica";
        Mostrar << Inscripcion;
    Fin_Si

    //Séptimo Semestre
    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Arquitectura_Computador > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Sistemas_Operativos < 5.5) Entonces;
        Mostrar << "Sistemas Operativos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Estructuras_Discretas_II > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Traductores_Interpretes < 5.5) Entonces;
        Mostrar << "Traductores e Interpretes";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Sistemas_Informacion_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Sistemas_Informacion_II < 5.5) Entonces;
        Mostrar << "Sistemas de Información II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 86) and (Datos[pos_usuario].Materias.Info[pos_usuario].Control_Proyectos < 5.5) Entonces; //86 UC Aprobadas
        Mostrar << "Control de Proyectos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 86) and (Datos[pos_usuario].Materias.Info[pos_usuario].Gestion_Empresarial < 5.5) Entonces;
        Mostrar << "Gestión Empresarial";
        Mostrar << Inscripcion;
    Fin_Si

    //Octavo Semestre
    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Sistemas_Operativos > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Redes < 5.5) Entonces;
        Mostrar << "Redes";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Traductores_Interpretes > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Lenguajes_Programacion < 5.5) Entonces;
        Mostrar << "Lenguaje de Programación";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Sistemas_Informacion_II > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Sistemas_Informacion_III < 5.5) Entonces;
        Mostrar << "Sistemas de Información III";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Sistemas_Informacion_II > 5.5) and (Datos.Materias.Info[pos_usuario].Etica_Profesional < 5.5) Entonces;
        Mostrar << "Ética Profesional";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Control_Proyectos > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Gestion_Empresarial > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Pasantias < 5.5) Entonces;
        Mostrar << "Pasantías";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 100) and (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Area_I < 5.5) Entonces; //100 UC Aprobadas
        Mostrar << "Electiva de Área I";
        Mostrar << Inscripcion;
    Fin_Si

    //Noveno Semestre
    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Redes > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Sistemas_Distribuidos < 5.5) Entonces;
        Mostrar << "Sistemas Distribuidos";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 136) and (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Libre_I < 5.5) Entonces;
        Mostrar << "Electiva Libre I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 157) and (Datos[pos_usuario].Materias.Info[pos_usuario].Proyecto_Grado_I < 5.5) Entonces;
        Mostrar << "Proyecto de Grado I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 157) and (Datos[pos_usuario].Materias.Info[pos_usuario].Informatica_Educativa < 5.5) Entonces;
        Mostrar << "Informática Educativa";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Area_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Area_II < 5.5) Entonces;
        Mostrar << "Electiva de Área II";
        Mostrar << Inscripcion;
    Fin_Si

    //Décimo Semestre
    Si (Datos[pos_usuario].UC_Aprobadas >= 157) and (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Libre_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Libre_II < 5.5) Entonces;
        Mostrar << "Electiva Libre II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Pasantias > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Gerencia_Proyectos < 5.5) Entonces;
        Mostrar << "Gerencia de Proyecto";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Proyecto_Grado_I > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Proyecto_Grado_II < 5.5) Entonces;
        Mostrar << "Proyecto de Grado II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Area_II > 5.5) and (Datos[pos_usuario].Materias.Info[pos_usuario].Electiva_Area_III < 5.5) Entonces;
        Mostrar << "Electiva de Área III";
        Mostrar << Inscripcion;
    Fin_Si
Fin_Procedimiento