    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 132) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Trabajo_Grado < 5.5) Entonces;
        Mostrar << "Trabajo Especial de Grado";
        Mostrar << Inscripcion;
    Fin_Si
Fin_Procedimiento