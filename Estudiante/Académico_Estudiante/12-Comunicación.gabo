Procedimiento Comunicacion();
Inicio
    Mostrar << "Aquí los bloques disponibles para que pueda organizar sus materias:";
    Para (i = 1 Hasta i = 48) Hacer;
        Si (Base.Lista[i].Estado = "Libre") Entonces;
            Mostrar << "ID: ", Base.Lista[i].ID_Bloque, " | ", Base.Lista[i].Dia, " ", Base.Lista[i].Hora_Inicio, "-", Base.Lista[i].Hora_Fin, " | Aula: ", Base.Lista[i].Aula;
        Fin_Si
    Fin_Para
    //Primer Semestre
    Si (Datos[pos_usuario].UC_Aprobadas = 0) Entonces;
        Mostrar << "Morfosintaxis del castellano";
        Mostrar << "Comunicación Social en el periodismo";
        Mostrar << "Psicología de la Comunicación";
        Mostrar << "Estadística";
        Mostrar << "Deporte, Arte y cultura";
        Mostrar << "Pensamiento Bolivariano";
        Para (I = 1 Hasta I = 6) Hacer;
            Mostrar << Inscripcion;
        Fin_Para
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Morfosintaxis < 5.5) Entonces;
        Mostrar << "Morfosintaxis del Castellano";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Periodismo < 5.5) Entonces;
        Mostrar << "Comunicación Social en el Periodismo";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Psicologia_Com < 5.5) Entonces;
        Mostrar << "Psicología de la comunicación";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Estadistica < 5.5) Entonces;
        Mostrar << "Estadística";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Deporte_Arte_Cultura < 5.5) Entonces;
        Mostrar << "Deporte, Arte y Cultura";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Pensamiento_Bolivariano < 5.5) Entonces;
        Mostrar << "Pensamiento Bolivariano";
        Mostrar << Inscripcion;
    Fin_Si

    //Segundo Semestre
    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Informativo < 5.5) Entonces;
        Mostrar << "Periodismo Informativo";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Radio < 5.5) Entonces;
        Mostrar << "Comunicación Social en la Radio";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Cine < 5.5) Entonces;
        Mostrar << "Comunicación Social en el Cine";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_TV < 5.5) Entonces;
        Mostrar << "Comunicación Social en la Televisión";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Foto < 5.5) Entonces;
        Mostrar << "Comunicación Social en la Fotografía";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 2) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Morfosintaxis > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Taller_Redaccion_I < 5.5) Entonces;
        Mostrar << "Taller de Redacción y Estilo I";
        Mostrar << Inscripcion;
    Fin_Si

    //Tercer Semestre
    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_I < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Comunicacional I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Taller_Redaccion_I > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Taller_Redaccion_II < 5.5) Entonces;
        Mostrar << "Taller de Redacción y Estilo II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Foto > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Grafica < 5.5) Entonces;
        Mostrar << "Comunicación Gráfica";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Radio > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Radiofonico < 5.5) Entonces;
        Mostrar << "Periodismo Radiofónico";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_Cine > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Lenguaje_Cine < 5.5) Entonces;
        Mostrar << "Lenguaje y Planificación Cinematográfica";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 3) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Social_TV > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_TV < 5.5) Entonces;
        Mostrar << "Periodismo Televisivo";
        Mostrar << Inscripcion;
    Fin_Si

    //Cuarto Semestre
    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Com_Grafica > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Estetica_Imagen_Sonido < 5.5) Entonces;
        Mostrar << "Estética de la Imagen y el Sonido";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Teoria_Comunicacion < 5.5) Entonces;
        Mostrar << "Teoría de la Comunicación";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Opinion_Publica < 5.5) Entonces;
        Mostrar << "Opinión Pública";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Formacion_Sociopolitica < 5.5) Entonces;
        Mostrar << "Formación Sociopolítica";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_I > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_II < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Comunicacional II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 4) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Etica_Legislacion < 5.5) Entonces;
        Mostrar << "Ética y Legislación de Medios y del Periodismo";
        Mostrar << Inscripcion;
    Fin_Si

    //Quinto Semestre
    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_II > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_III < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Comunicacional III";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Teoria_Comunicacion > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Sociologia_Comunicacion < 5.5) Entonces;
        Mostrar << "Sociología de la Comunicación";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Investigacion_Comunicacion < 5.5) Entonces;
        Mostrar << "Investigación de la Comunicación";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Interpretativo < 5.5) Entonces;
        Mostrar << "Periodismo Interpretativo";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Opinion_Publica > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Opinion < 5.5) Entonces;
        Mostrar << "Periodismo de Opinión";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Economia_Politica < 5.5) Entonces;
        Mostrar << "Economía Política";
        Mostrar << Inscripcion;
    Fin_Si

    //Sexto Semestre
    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Estetica_Imagen_Sonido > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_TV < 5.5) Entonces;
        Mostrar << "Producción de Televisión";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_Radio < 5.5) Entonces;
        Mostrar << "Producción de Radio";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_Cine < 5.5) Entonces;
        Mostrar << "Producción de Cine";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Semestre >= 6) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_I < 5.5) Entonces;
        Mostrar << "Seminario de Formación Socio Crítica I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_III > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_IV < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Comunicacional IV";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Sociologia_Comunicacion > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Semiologia < 5.5) Entonces;
        Mostrar << "Semiología";
        Mostrar << Inscripcion;
    Fin_Si

    //Séptimo Semestre
    Si (Datos[pos_usuario].UC_Aprobadas >= 82) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Fotoperiodismo < 5.5) Entonces;
        Mostrar << "Fotoperiodismo";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_I > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_II < 5.5) Entonces;
        Mostrar << "Seminario de Formación Socio Crítica II";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 82) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Cientifico < 5.5) Entonces;
        Mostrar << "Periodismo Científico";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_Cine > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Produccion_TV > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Montajes_Audiovisuales < 5.5) Entonces;
        Mostrar << "Montajes Audiovisuales";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 82) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Relaciones_Publicas < 5.5) Entonces;
        Mostrar << "Relaciones Públicas";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_IV > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_V < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Comunicacional V";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 82) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Tecnologia_Informacion < 5.5) Entonces;
        Mostrar << "Tecnología de la Información";
        Mostrar << Inscripcion;
    Fin_Si

    //Octavo Semestre
    Si (Datos[pos_usuario].UC_Aprobadas >= 98) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Locucion_Basica < 5.5) Entonces;
        Mostrar << "Locución Básica";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Relaciones_Publicas > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Publicidad < 5.5) Entonces;
        Mostrar << "Publicidad";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 98) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Idioma_Moderno < 5.5) Entonces;
        Mostrar << "Idioma Moderno";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_II > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Seminario_Critica_III < 5.5) Entonces;
        Mostrar << "Seminario de Formacion Socio Crítica III";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 98) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Economico < 5.5) Entonces;
        Mostrar << "Periodismo Económico";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_V > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_VI < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Comunicacional VI";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 98) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Orientacion_Profesional_I < 5.5) Entonces;
        Mostrar << "Orientación Profesional I";
        Mostrar << Inscripcion;
    Fin_Si

    //Noveno Semestre
    Si (Datos[pos_usuario].UC_Aprobadas >= 115) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Gerencia_Corporativa < 5.5) Entonces;
        Mostrar << "Gerencia Corporativa";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Publicidad > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Mercadeo < 5.5) Entonces;
        Mostrar << "Mercadeo";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Locucion_Basica > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Locucion_Profesional < 5.5) Entonces;
        Mostrar << "Locución Profesional";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_VI > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Proyecto_VII < 5.5) Entonces;
        Mostrar << "Proyecto Comunitario Socio Comunicacional VII";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas >= 115) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Periodismo_Politico < 5.5) Entonces;
