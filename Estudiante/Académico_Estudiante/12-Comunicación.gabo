        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].Materias.Soc[pos_usuario].Orientacion_Profesional_I > 5.5) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Orientacion_Profesional_II < 5.5) Entonces;
        Mostrar << "Orientación Profesional II";
        Mostrar << Inscripcion;
    Fin_Si

    //Décimo Semestre
    Si (Datos[pos_usuario].UC_Aprobadas >= 115) and (Datos[pos_usuario].Materias.Soc[pos_usuario].Vinculacion_Profesional < 5.5) Entonces;
        Mostrar << "Vinculación Profesional en el Campo Socio Comunicacional";
