Procedimiento Derecho();
Inicio
    Mostrar << "Aquí los bloques disponibles para que pueda organizar sus materias:";
    Para (i = 1 Hasta i = 48) Hacer;
        Si (Base.Lista[i].Estado = "Libre") Entonces;
            Mostrar << "ID: ", Base.Lista[i].ID_Bloque, " | ", Base.Lista[i].Dia, " ", Base.Lista[i].Hora_Inicio, "-", Base.Lista[i].Hora_Fin, " | Aula: ", Base.Lista[i].Aula;
        Fin_Si
    Fin_Para
    //Primer Año
    Si (Datos[pos_usuario].UC_Aprobadas = 0) Entonces;
        Mostrar << "Derecho Civil I";
        Mostrar << "Derecho Constitucional";
        Mostrar << "Pensamiento Bolivariano";
        Mostrar << "Introduccion al Derecho";
        Mostrar << "Economia Politica";
        Mostrar << "Metodología de Investigación Jurídica";
        Mostrar << "Derecho Popular";
        Mostrar << "Derecho Romano";
        Mostrar << "Lógica Jurídica";
        Mostrar << "Deontología Jurídica";
        Mostrar << "Arte y Cultura";
        Mostrar << "Deporte";
        Para (I = 1 Hasta I = 12) Hacer;
            Mostrar << Inscripcion;
        Fin_Para
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Der[pos_usuario].Derecho_Civil_I < 5.5) Entonces;
        Mostrar << "Derecho Civil I";
        Mostrar << Inscripcion;
    Fin_Si

    Si (Datos[pos_usuario].UC_Aprobadas > 0) and (Datos[pos_usuario].Materias.Der[pos_usuario].Derecho_Constitucional < 5.5) Entonces;
