Procedimiento Menu_Personal_Est();
Inicio
    var Opc: entero, R: Booleano;
    Repetir
        Mostrar << "Bienvenido a tu perfil personal de estudiante";
        Mostrar << "Aqui puedes gestionar tu informacion, seguridad y preferencias";
        Mostrar << "Seleccione una opción";
        Mostrar << "1: Información personal";
        Mostrar << "2: Seguridad";
        Mostrar << "3: Historial Académico";
        Mostrar << "4: Modo Oscuro";
        Mostrar << "5: Avatar";
        Mostrar << "6: Salud";
        Leer >> Opc;
        Mientras (Opc < 1 Or Opc > 6) Hacer;
            Mostrar << "Ingrese solo opciones entre 1-6";
            Leer >> Opc;
        Fin_Mientras
        En_Caso (Opc > 0) Sea;
            Caso(Opc = 1);
                Informacion_Personal_Est(Datos[pos_usuario].Avatar, Datos[pos_usuario].Nombre, Datos[pos_usuario].Gmail, Datos[pos_usuario].Carrera, Datos[pos_usuario].CI, Datos[pos_usuario].Year, Datos[pos_usuario].Tarjeta);
                Mostrar << Informacion_Personal_Est;
            Caso(Opc = 2);
                Seguridad_Personal_Est(Datos[pos_usuario].Password, Datos[pos_usuario].Gmail);
                Mostrar << Seguridad_Personal_Est;
            Caso(Opc = 3);
               Historial_Carreras (Datos[pos_usuario].Carrera);
               Mostrar << Historial_Carreras;
            Caso(Opc = 4);
                Oscuro_Personal_Est(Tema);
                Mostrar << Oscuro_Personal_Est;
            Caso(Opc = 5);
                Avatares (Avatares[10]);
                Avatar_Personal_Est(Avatares[10], Datos[pos_usuario].Avatar);
                Mostrar << Avatar_Personal_Est;
            Otro_Caso
                Salud_Personal_Est(Datos.Salud[pos_usuario].Transmisibles, Datos.Salud[pos_usuario].Cronicas, Datos.Salud[pos_usuario].Neurologicas, Datos.Salud[pos_usuario].Neoplasias, Datos.Salud[pos_usuario].Autoinmunes, Datos.Salud[pos_usuario].Trastornos, Datos.Salud[pos_usuario].Lesiones, Datos.Salud[pos_usuario].Congenitas, Datos.Salud[pos_usuario].Metabolicos, Datos.Salud[pos_usuario].Ocupacionales);
                Mostrar << Salud_Personal_Est;
        Fin_Caso
        Mostrar << "¿Desea elegir otra opción? Ingrese 1:Si, 0:No";
        Leer R;
        Hasta(R = 0);
    Fin_Repetir

Fin_Procedimiento