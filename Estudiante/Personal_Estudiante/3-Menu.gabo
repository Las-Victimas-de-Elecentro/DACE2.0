Procedimiento Menu_Personal_Est();
Inicio
    var Opc: entero, R: Booleano;
    Repetir
        Mostrar << "Bienvenido a tu perfil personal de estudiante";
        Mostrar << "Aqui puedes gestionar tu informacion, seguridad y preferencias";
        Mostrar << "Seleccione una opción";
        Mostrar << "1: Información personal";
        Mostrar << "2: Seguridad";
        Mostrar << "3: Historial Académico";
        Mostrar << "4: Modo Oscuro";
        Mostrar << "5: Avatar";
        Mostrar << "6: Salud";
        Mostrar << "7: Volver al menú principal";
        Leer >> Opc;
        Mientras (Opc < 1 Or Opc > 7) Hacer;
            Mostrar << "Ingrese solo opciones entre 1-7";
            Leer >> Opc;
        Fin_Mientras
        En_Caso (Opc > 0) Sea;
            Caso(Opc = 1);
                Informacion_Personal_Est(Datos[pos_usuario].Nombre, Datos[pos_usuario].Gmail, Datos[pos_usuario].Carrera, Datos[pos_usuario].CI, Datos[pos_usuario].Year, Datos[pos_usuario].Tarjeta);
                Mostrar << Informacion_Personal_Est;
            Caso(Opc = 2);
                Seguridad_Personal_Est(Datos[pos_usuario].Password, Datos[pos_usuario].Gmail);
                Mostrar << Seguridad_Personal_Est;
            Caso(Opc = 3);
