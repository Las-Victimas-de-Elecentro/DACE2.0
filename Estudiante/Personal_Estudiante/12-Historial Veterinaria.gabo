        Mostrar << "Anatomía Patológica Vet:...", Datos.Materias.Vet[pos_usuario].Anatomia_Patologica;
        
        Suma = Suma + (Datos.Materias.Vet[pos_usuario].Patologia_Clinica + Datos.Materias.Vet[pos_usuario].Farmacologia + Datos.Materias.Vet[pos_usuario].Semiologia + Datos.Materias.Vet[pos_usuario].Nutricion + Datos.Materias.Vet[pos_usuario].Reproduccion + Datos.Materias.Vet[pos_usuario].Parasitologia + Datos.Materias.Vet[pos_usuario].Anatomia_Patologica);
