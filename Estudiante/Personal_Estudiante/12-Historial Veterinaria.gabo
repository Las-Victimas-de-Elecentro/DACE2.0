        Suma = Suma + (Datos.Materias.Vet[pos_usuario].Histologia + Datos.Materias.Vet[pos_usuario].Arte_Cultura + Datos.Materias.Vet[pos_usuario].Bioestadistica + Datos.Materias.Vet[pos_usuario].Genetica + Datos.Materias.Vet[pos_usuario].Fisiologia_Animal + Datos.Materias.Vet[pos_usuario].Zootecnia + Datos.Materias.Vet[pos_usuario].Microbiologia);
        Contador = Contador + 7;
    Fin_Si

    // Tercer Año
    Si (Datos[pos_usuario].Year >= 3) Entonces;
        Mostrar << "Patología Clínica Veterinaria:...", Datos.Materias.Vet[pos_usuario].Patologia_Clinica;
