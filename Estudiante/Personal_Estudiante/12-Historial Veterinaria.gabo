        Mostrar << "Cirugía Veterinaria:...", Datos.Materias.Vet[pos_usuario].Cirugia;
        
        Suma = Suma + (Datos.Materias.Vet[pos_usuario].Gerencia + Datos.Materias.Vet[pos_usuario].Saneamiento + Datos.Materias.Vet[pos_usuario].Medicina_Rumiantes + Datos.Materias.Vet[pos_usuario].Mejoramiento_Animal + Datos.Materias.Vet[pos_usuario].Medicina_Caninos + Datos.Materias.Vet[pos_usuario].Investigacion_I + Datos.Materias.Vet[pos_usuario].Extension_I + Datos.Materias.Vet[pos_usuario].Cirugia);
        Contador = Contador + 8;
    Fin_Si

    // Quinto Año
    Si (Datos[pos_usuario].Year >= 5) Entonces;
        Mostrar << "Servicio Comunitario:...", Datos.Materias.Vet[pos_usuario].Servicio_Comunitario;
        Mostrar << "Med. Preventiva y Cli. Hospit.:...", Datos.Materias.Vet[pos_usuario].Medicina_Preventiva;
