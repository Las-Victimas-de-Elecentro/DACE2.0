        Mostrar << "Anat. de los Animales Domestic.:...", Datos.Materias.Vet[pos_usuario].Anatomia_I;
        
        Suma = Suma + (Datos.Materias.Vet[pos_usuario].Faenas_Pecuarias + Datos.Materias.Vet[pos_usuario].Ingles_Instrumental + Datos.Materias.Vet[pos_usuario].Ecologia_Agricola + Datos.Materias.Vet[pos_usuario].Perfil_Profesional + Datos.Materias.Vet[pos_usuario].Deportes + Datos.Materias.Vet[pos_usuario].Bioquimica + Datos.Materias.Vet[pos_usuario].Computacion + Datos.Materias.Vet[pos_usuario].Zoologia + Datos.Materias.Vet[pos_usuario].Anatomia_I);
        Contador = Contador + 9;
    Fin_Si

    // Segundo Año
    Si (Datos[pos_usuario].Year >= 2) Entonces;
        Mostrar << "Histología Veterinaria:...", Datos.Materias.Vet[pos_usuario].Histologia;
        Mostrar << "Arte y Cultura:...", Datos.Materias.Vet[pos_usuario].Arte_Cultura;
