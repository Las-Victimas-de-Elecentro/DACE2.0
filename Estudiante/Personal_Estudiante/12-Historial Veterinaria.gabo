Procedimiento Historial_Veterinaria (E/S: Suma, Datos.Materias.Vet[pos_usuario].Faenas_Pecuarias, Datos.Materias.Vet[pos_usuario].Ingles_Instrumental, Datos.Materias.Vet[pos_usuario].Ecologia_Agricola, Datos.Materias.Vet[pos_usuario].Perfil_Profesional, Datos.Materias.Vet[pos_usuario].Deportes, Datos.Materias.Vet[pos_usuario].Bioquimica, Datos.Materias.Vet[pos_usuario].Computacion, Datos.Materias.Vet[pos_usuario].Zoologia, Datos.Materias.Vet[pos_usuario].Anatomia_I, Datos.Materias.Vet[pos_usuario].Histologia, Datos.Materias.Vet[pos_usuario].Arte_Cultura, Datos.Materias.Vet[pos_usuario].Bioestadistica, Datos.Materias.Vet[pos_usuario].Genetica, Datos.Materias.Vet[pos_usuario].Fisiologia_Animal, Datos.Materias.Vet[pos_usuario].Zootecnia, Datos.Materias.Vet[pos_usuario].Microbiologia, Datos.Materias.Vet[pos_usuario].Patologia_Clinica, Datos.Materias.Vet[pos_usuario].Farmacologia, Datos.Materias.Vet[pos_usuario].Semiologia, Datos.Materias.Vet[pos_usuario].Nutricion, Datos.Materias.Vet[pos_usuario].Reproduccion, Datos.Materias.Vet[pos_usuario].Parasitologia, Datos.Materias.Vet[pos_usuario].Anatomia_Patologica, Datos.Materias.Vet[pos_usuario].Gerencia, Datos.Materias.Vet[pos_usuario].Saneamiento, Datos.Materias.Vet[pos_usuario].Medicina_Rumiantes, Datos.Materias.Vet[pos_usuario].Mejoramiento_Animal, Datos.Materias.Vet[pos_usuario].Medicina_Caninos, Datos.Materias.Vet[pos_usuario].Investigacion_I, Datos.Materias.Vet[pos_usuario].Extension_I, Datos.Materias.Vet[pos_usuario].Cirugia, Datos.Materias.Vet[pos_usuario].Servicio_Comunitario, Datos.Materias.Vet[pos_usuario].Medicina_Preventiva, Datos.Materias.Vet[pos_usuario].Extension_II, Datos.Materias.Vet[pos_usuario].Investigacion_II, Datos.Materias.Vet[pos_usuario].Medicina_Especies, Datos.Materias.Vet[pos_usuario].Legislacion, Datos.Materias.Vet[pos_usuario].Produccion_Industria, Datos.Materias.Vet[pos_usuario].Derecho_Constitucional, Datos.Materias.Vet[pos_usuario].Epidemiologia, Datos.Materias.Vet[pos_usuario].Medicina_Suinos, Datos.Materias.Vet[pos_usuario].Pasantias: Real);
Inicio

    // Primer Año
    Si (Datos[pos_usuario].Year >= 1) Entonces;
        Mostrar << "Faenas Pecuarias:...", Datos.Materias.Vet[pos_usuario].Faenas_Pecuarias;
        Mostrar << "Ingles Instrumental:...", Datos.Materias.Vet[pos_usuario].Ingles_Instrumental;
        Mostrar << "Ecología Agrícola:...", Datos.Materias.Vet[pos_usuario].Ecologia_Agricola;
