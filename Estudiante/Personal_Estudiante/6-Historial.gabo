                Contador = Contador + 2;
            Fin_Si

            Si (Datos[pos_usuario].Semestre = 5) Entonces;
                Mostrar << "Contabilidad Social:...", Datos.Materias.Eco.Pre3eco[pos_usuario].Contabilidad_Social;
                Suma = Suma + (Datos.Materias.Eco.Pre3eco[pos_usuario].Contabilidad_Social);
                Contador = Contador + 1;
            Fin_Si

            Si (Datos[pos_usuario].Semestre = 6) Entonces;
                Mostrar << "Investigacion De Operaciones:...", Datos.Materias.Eco.Pre3eco[pos_usuario].Investigacion_Operaciones;
                Suma = Suma + (Datos.Materias.Eco.Pre3eco[pos_usuario].Investigacion_Operaciones);
                Contador = Contador + 1;
            Fin_Si

            Si (Datos[pos_usuario].Semestre = 7) Entonces;
                Mostrar << "Teoria Y Politica Monetaria:...", Datos.Materias.Eco.Pre3eco[pos_usuario].Teoria_Politica_Monetaria;
                Mostrar << "Planificacion:...", Datos.Materias.Eco.Pre3eco[pos_usuario].Planificacion;
                Suma = Suma + (Datos.Materias.Eco.Pre3eco[pos_usuario].Teoria_Politica_Monetaria + Datos.Materias.Eco.Pre3eco[pos_usuario].Planificacion);
                Contador = Contador + 2;
            Fin_Si

            //Prelación 4: Seminario y Proyecto Final

            Si (Datos[pos_usuario].Semestre >= 1 And Datos[pos_usuario].Semestre <= 4 ) Entonces;
                Mostrar << "Seminario I:...", Datos.Materias.Eco.Pre4eco[pos_usuario].Seminario_I;
                Suma = Suma + (Datos.Materias.Eco.Pre4eco[pos_usuario].Seminario_I);
                Contador = Contador + 1;
            Fin_Si

            Si (Datos.Materias.Eco.Pre4eco[pos_usuario].Seminario_I > 5.5) Entonces;
                Mostrar << "Seminario II:...", Datos.Materias.Eco.Pre4eco[pos_usuario].Seminario_II;
                Suma = Suma + (Datos.Materias.Eco.Pre4eco[pos_usuario].Seminario_II);
                Contador = Contador + 1;
            Fin_Si

            Si (Datos.Materias.Eco.Pre4eco[pos_usuario].Seminario_II > 5.5) Entonces;
                Mostrar << "Seminario III:...", Datos.Materias.Eco.Pre4eco[pos_usuario].Seminario_III;
                Suma = Suma + (Datos.Materias.Eco.Pre4eco[pos_usuario].Seminario_III);
                Contador = Contador + 1;
            Fin_Si

            Si (Datos[pos_usuario].Semestre = 8) Entonces;
                Mostrar << "Trabajo Final De Grado:...", Datos.Materias.Eco.Pre4eco[pos_usuario].Trabajo_Final_De_Grado;
                Suma = Suma + (Datos.Materias.Eco.Pre4eco[pos_usuario].Trabajo_Final_De_Grado);
                Contador = Contador + 1;
            Fin_Si

            Si (Datos[pos_usuario].Semestre = 6) Entonces;
                Mostrar << "Formulacion Y Evaluacion De Proyectos:...", Datos.Materias.Eco.Pre4eco[pos_usuario].Formulacion_Evaluacion_Proyectos;
                Mostrar << "Teoria Y Politica Fiscal:...", Datos.Materias.Eco.Pre4eco[pos_usuario].Teoria_Y_Politica_Fiscal;
                Suma = Suma + (Datos.Materias.Eco.Pre4eco[pos_usuario].Formulacion_Evaluacion_Proyectos + Datos.Materias.Eco.Pre4eco[pos_usuario].Teoria_Y_Politica_Fiscal);
                Contador = Contador + 2;
            Fin_Si

            //Prelaciónn 5: Generales y Complementarias

            Si (Datos[pos_usuario].Semestre = 1) Entonces;
                Mostrar << "Lenguaje Y Comunicacion:...", Datos.Materias.Eco.Pre5eco[pos_usuario].Lenguaje_Comunicacion;
                Mostrar << "Fundamentos Del Derecho:...", Datos.Materias.Eco.Pre5eco[pos_usuario].Fundamentos_Del_Derecho;
                Mostrar << "Metodologia De La Investigacion:...", Datos.Materias.Eco.Pre5eco[pos_usuario].Metodologia;
                Mostrar << "Deporte Y Recreacion:...", Datos.Materias.Eco.Pre5eco[pos_usuario].Deporte;
                Mostrar << "Ingles Instrumental:...", Datos.Materias.Eco.Pre5eco[pos_usuario].Ingles_Instrumental;
                Suma = Suma + (Datos.Materias.Eco.Pre5eco[pos_usuario].Lenguaje_Comunicacion + Datos.Materias.Eco.Pre5eco[pos_usuario].Fundamentos_Del_Derecho + Datos.Materias.Eco.Pre5eco[pos_usuario].Metodologia + Datos.Materias.Eco.Pre5eco[pos_usuario].Deporte + Datos.Materias.Eco.Pre5eco[pos_usuario].Ingles_Instrumental);
                Contador = Contador + 5;
            Fin_Si

            Si (Datos[pos_usuario].Semestre >= 1 And Datos[pos_usuario].Semestre <= 2 ) Entonces;
                Mostrar << "Sociologia:...", Datos.Materias.Eco.Pre5eco[pos_usuario].Sociologia;
                Mostrar << "Arte Y Cultura:...", Datos.Materias.Eco.Pre5eco[pos_usuario].Arte_Y_Cultura;
                Suma = Suma + (Datos.Materias.Eco.Pre5eco[pos_usuario].Sociologia + Datos.Materias.Eco.Pre5eco[pos_usuario].Arte_Y_Cultura);
                Contador = Contador + 2;
            Fin_Si

            Si (Datos[pos_usuario].Semestre >= 1 And Datos[pos_usuario].Semestre <= 3 ) Entonces;
                Mostrar << "Sociopolitica Productiva:...", Datos.Materias.Eco.Pre5eco[pos_usuario].Sociopolitica_Productiva;
                Suma = Suma + (Datos.Materias.Eco.Pre5eco[pos_usuario].Sociopolitica_Productiva);
                Contador = Contador + 1;
            Fin_Si

            Si (Datos[pos_usuario].Semestre >= 1 And Datos[pos_usuario].Semestre <= 4 ) Entonces;
                Mostrar << "Teoria E Investigacion De Mercado:...", Datos.Materias.Eco.Pre5eco[pos_usuario].Investigacion_De_Mercado;
                Suma = Suma + (Datos.Materias.Eco.Pre5eco[pos_usuario].Investigacion_De_Mercado);
                Contador = Contador + 1;
            Fin_Si

            Si (Datos[pos_usuario].Semestre >= 1 And Datos[pos_usuario].Semestre <= 5 ) Entonces;
                Mostrar << "Desarrollo Economico:...", Datos.Materias.Eco.Pre5eco[pos_usuario].Desarrollo_Economico;
                Mostrar << "Analisis Economico Regional:...", Datos.Materias.Eco.Pre5eco[pos_usuario].Analisis_Economico_Regional;
                Suma = Suma + (Datos.Materias.Eco.Pre5eco[pos_usuario].Desarrollo_Economico + Datos.Materias.Eco.Pre5eco[pos_usuario].Analisis_Economico_Regional);
                Contador = Contador + 2;
            Fin_Si

    Fin_Caso

    //Promedio

    Si (Suma > 0 And Contador > 0) Entonces;
        Promedio = Suma / Contador;
        Mostrar << "Tu Promedio Es De:...", Promedio;
    Sino
        Promedio = 0;
        Mostrar << "No Tienes Promedio";
    Fin_Si

    //Actas

    Si (Datos[pos_usuario].Actas ≠ "") Entonces;
        Mostrar << "Posees actas disciplinaria registrada";
        Mostrar << Datos[pos_usuario].Actas;
    Sino
        Mostrar << "No se registran problemas disciplinarios";
    Fin_Si
    
Fin_Procedimiento