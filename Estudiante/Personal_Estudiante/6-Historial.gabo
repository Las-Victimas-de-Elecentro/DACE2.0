.Materias.Cont.Pre1cont[pos_usuario].Contabilidad_De_Costos_II, Datos.Materias.Cont.Pre1cont[pos_usuario].Contabilidad_De_Costos_III, Datos.Materias.Cont.Pre1cont[pos_usuario].Auditoria_I, Datos.Materias.Cont.Pre1cont[pos_usuario].Contabilidad_Especializada_I, Datos.Materias.Cont.Pre3cont[pos_usuario].Instituciones_Financieras, Datos.Materias.Cont.Pre4cont[pos_usuario].Practica_Profesional_I, Datos.Materias.Cont.Pre4cont[pos_usuario].Seminario_I, Datos.Materias.Cont.Pre4cont[pos_usuario].Practica_Profesional_II, Datos.Materias.Cont.Pre4cont[pos_usuario].Seminario_II, Datos.Materias.Cont.Pre4cont[pos_usuario].Etica_Desarrollo_Profesional, Datos.Materias.Cont.Pre4cont[pos_usuario].Tesina_De_Grado, Datos.Materias.Cont.Pre4cont[pos_usuario].Pasantias, Datos.Materias.Eco.Pre2eco[pos_usuario].Matematica_Financiera, Datos.Materias.Eco.Pre2eco[pos_usuario].Estadistica_I, Datos.Materias.Eco.Pre2eco[pos_usuario].Estadistica_II, Datos.Materias.Eco.Pre2eco[pos_usuario].Estadistica_Aplicada, Datos.Materias.Eco.Pre2eco[pos_usuario].Econometria, Datos.Materias.Eco.Pre5eco[pos_usuario].Deporte, Datos.Materias.Eco.Pre5eco[pos_usuario].Ingles_Instrumental, Datos.Materias.Eco.Pre5eco[pos_usuario].Sociologia, Datos.Materias.Eco.Pre5eco[pos_usuario].Arte_Y_Cultura, Datos.Materias.Eco.Pre5eco[pos_usuario].Sociopolitica_Productiva, Datos.Materias.Eco.Pre5eco[pos_usuario].Investigacion_De_Mercado, Datos.Materias.Eco.Pre5eco[pos_usuario].Desarrollo_Economico, Datos.Materias.Eco.Pre5eco[pos_usuario].Analisis_Economico_Regional: Real);
Inicio

    Mostrar << "Historial Académico";
    Mostrar << "Aquí se muestra tu desempeño y registro disciplinario";

    En_Caso (Datos[pos_usuario].Carrera ≠ "Ninguna") Sea;

        Caso(Datos[pos_usuario].Carrera = "Informatica");

            //Prelación 1: Matemáticas e Infraestructura

            Si (Datos[pos_usuario].Semestre = 1) Entonces;
                Mostrar << "Matematica_I:...", Datos.Materias.Info.Pre1info[pos_usuario].Matematica_I;
                Suma = Suma + (Datos.Materias.Info.Pre1info[pos_usuario].Matematica_I);
                Contador = Contador + 1;
            Fin_Si

            Si (Datos.Materias.Info.Pre1info[pos_usuario].Matematica_I > 5.5) Entonces;
                Mostrar << "Matematica_II:...", Datos.Materias.Info.Pre1info[pos_usuario].Matematica_II;
                Mostrar << "Fisica_I:...", Datos.Materias.Info.Pre1info[pos_usuario].Fisica_I;
                Suma = Suma + (Datos.Materias.Info.Pre1info[pos_usuario].Matematica_II + Datos.Materias.Info.Pre1info[pos_usuario].Fisica_I);
                Contador = Contador + 2;
            Fin_Si

            Si (Datos.Materias.Info.Pre1info[pos_usuario].Matematica_II > 5.5) Entonces;
                Mostrar << "Matematica_III:...", Datos.Materias.Info.Pre1info[pos_usuario].Matematica_III;
                Suma = Suma + (Datos.Materias.Info.Pre1info[pos_usuario].Matematica_III);
                Contador = Contador + 1;
            Fin_Si

            Si (Datos.Materias.Info.Pre1info[pos_usuario].Fisica_I > 5.5) Entonces;
                Mostrar << "Fisica_II:...", Datos.Materias.Info.Pre1info[pos_usuario].Fisica_II;
                Suma = Suma + (Datos.Materias.Info.Pre1info[pos_usuario].Fisica_II);
                Contador = Contador + 1;
            Fin_Si

            Si (Datos.Materias.Info.Pre1info[pos_usuario].Fisica_II > 5.5) Entonces;
                Mostrar << "Organizacion_Del_Computador:...", Datos.Materias.Info.Pre1info[pos_usuario].Organizacion_Del_Computador;
                Suma = Suma + (Datos.Materias.Info.Pre1info[pos_usuario].Organizacion_Del_Computador);
                Contador = Contador + 1;
            Fin_Si

            Si (Datos.Materias.Info.Pre1info[pos_usuario].Matematica_III > 5.5) Entonces;
                Mostrar << "Matematica_IV:...", Datos.Materias.Info.Pre1info[pos_usuario].Matematica_IV;
                Mostrar << "Probabilidad_Y_Estadistica:...", Datos.Materias.Info.Pre1info[pos_usuario].Probabilidad_Y_Estadistica;
                Suma = Suma + (Datos.Materias.Info.Pre1info[pos_usuario].Matematica_IV + Datos.Materias.Info.Pre1info[pos_usuario].Probabilidad_Y_Estadistica);
