Procedimiento Historial_Odontologia (E/S: Suma, Datos.Materias.Odo[pos_usuario].Morfologia_Dentaria, Datos.Materias.Odo[pos_usuario].Formacion_Cultural_I, Datos.Materias.Odo[pos_usuario].Odontologia_Comunitaria_I, Datos.Materias.Odo[pos_usuario].Iniciacion_Clinica, Datos.Materias.Odo[pos_usuario].Morfologia_Humana, Datos.Materias.Odo[pos_usuario].Formacion_Instrumental_I, Datos.Materias.Odo[pos_usuario].Bioquimica_Aplicada, Datos.Materias.Odo[pos_usuario].Histologia_Embriologia, Datos.Materias.Odo[pos_usuario].Deportes_I, Datos.Materias.Odo[pos_usuario].Investigacion_I, Datos.Materias.Odo[pos_usuario].Odontologia_Comunitaria_II, Datos.Materias.Odo[pos_usuario].Formacion_Cultural_II, Datos.Materias.Odo[pos_usuario].Histofisiologia, Datos.Materias.Odo[pos_usuario].Clinica_Adulto_I, Datos.Materias.Odo[pos_usuario].Biomateriales, Datos.Materias.Odo[pos_usuario].Deportes_II, Datos.Materias.Odo[pos_usuario].Investigacion_II, Datos.Materias.Odo[pos_usuario].Microbiologia_Parasitologia, Datos.Materias.Odo[pos_usuario].Formacion_Instrumental_II, Datos.Materias.Odo[pos_usuario].Investigacion_III, Datos.Materias.Odo[pos_usuario].Clinica_Adulto_II, Datos.Materias.Odo[pos_usuario].Toxicologia, Datos.Materias.Odo[pos_usuario].Odontologia_Comunitaria_III, Datos.Materias.Odo[pos_usuario].Atencion_Nino_I, Datos.Materias.Odo[pos_usuario].Medicina_Semiologia, Datos.Materias.Odo[pos_usuario].Fisiopatologia, Datos.Materias.Odo[pos_usuario].Gerontologia, Datos.Materias.Odo[pos_usuario].Farmacologia, Datos.Materias.Odo[pos_usuario].Investigacion_IV, Datos.Materias.Odo[pos_usuario].Odontologia_Comunitaria_IV, Datos.Materias.Odo[pos_usuario].Atencion_Nino_II, Datos.Materias.Odo[pos_usuario].Clinica_Adulto_III, Datos.Materias.Odo[pos_usuario].Investigacion_V, Datos.Materias.Odo[pos_usuario].Odontologia_Comunitaria_V: Real);
Inicio

    // Primer Año
    Si (Datos[pos_usuario].Year >= 1) Entonces;
