Procedimiento Informacion_Club(E/S: Club[I].Nombre, Club[I].Descripcion, Club[I].Horarios_Disponibles: Cadena, Club[I].Miembros_Inscritos, Club[I].Capacidad_Maxima: Entero);
Inicio
    Var ID: Entero;
    Mostrar << "Ingrese el ID del club al que pertenece";
    Leer >> ID;
    Para (I = 1 Hasta I = Club) Hacer;
        Si (ID = I) Entonces;
            Mostrar << "Información de su club";
            Mostrar << "Club:..,", Club[I].Nombre;
            Mostrar << "Descripción:..,", Club[I].Descripcion;
            Mostrar << "Horarios:..,", Club[I].Horarios_Disponibles;
            Mostrar << "Miembros Actuales:..,", Club[I].Miembros_Inscritos;
            Mostrar << "Capacidad del club:..,", Club[I].Capacidad_Maxima;
        Fin_Si
    Fin_Para
Fin_Procedimiento