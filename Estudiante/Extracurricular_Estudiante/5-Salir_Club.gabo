Procedimiento Salir_Club(E/S: Club[I].Miembros_Inscritos: Entero, Club[I].Nombre, Datos[I].Club: Cadena);
Inicio 
    Var ID: Entero;
    Mostrar << "Ingrese el ID del club de dónde está inscrito";
    Leer >> ID;
    Para (I = 1 Hasta I = Club) Hacer;
        Si (I = ID) Entonces;
            Club[I].Miembros_Inscritos = Club[I].Miembros_Inscritos - 1;
            Mostrar << "Ha salido del club:..,", Club[I].Nombre;
            Datos[pos_usuario].Club = null;
        Sino
            Mostrar << "No está inscrito en ningún club";
        Fin_Si
    Fin_Para
Fin_Procedimiento