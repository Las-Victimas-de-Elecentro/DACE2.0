Procedimiento Agregar_Materia(E/S: Prof[pos].Materias, Materia[I].Nombre, Materia[I].Codigo: Cadena, Prof[pos].Cant_Materias: Entero);
Inicio
    Var Cant, I: Entero;
    Var Materia, Codigo: Cadena;
    //Nuevo
    Mostrar << "¿Cuántas materias va a impartir?";
    Leer >> Cant;
    Mientras (Cant < 1 or Cant > 50) Hacer;
        Mostrar << "Solo positivos, y el límite no puede superar las 50 materias";
        Leer >> Cant;
    Fin_Mientras
    Si (Cant = 1) Entonces;
        Mostrar << "Ingrese el nombre de la materia que va a impartir";
        Leer >> Materia;
        Mostrar << "Ingrese el código de la materia";
        Leer >> Codigo;
        Para (I = 1 Hasta I = 200) Hacer;
            Si (Materia = Materia[I].Nombre) or (Codigo = Materia[I].Codigo) Entonces;
                Mostrar << "Materia encontrada.";
                Mostrar << "Impartirá la materia llamada: ", Materia[I].Nombre;
                Prof[pos].Materias = Materia;
                Prof[pos].Cant_Materias = Cant;
            Fin_Si
        Fin_Para
    Sino
        Mostrar << "Ingrese las materias que impartirá separadas por comas (Ejemplo: 'Matemática I, Lógica Matemática')";
        Leer >> Materia;
        Prof[pos].Materia = Materia;
        Prof[pos].Cant_Materias = Cant;
        Para (i = 1 Hasta i = Cant) Hacer;
            Mostrar << "Ingrese el nombre de las materias individualmente, aquí la materia n°", i, ":";
            Leer >> Materia;
            Mostrar << "Ingrese el código de la materia";
            Leer >> Codigo;
            Para (i = 1 Hasta i = 200) Hacer;
                Si (Materia = Materia[I].Nombre) or (Codigo = Materia[I].Codigo) Entonces;
                    Mostrar << "Materia encontrada.";
                    Mostrar << "Impartirá la materia llamada: ", Materia[I].Nombre;
                Fin_Si
            Fin_Para
        Fin_Para
    Fin_Si
Fin_Procedimiento

