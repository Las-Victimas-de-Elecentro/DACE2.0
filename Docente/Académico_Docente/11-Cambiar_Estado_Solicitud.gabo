Procedimiento Cambiar_Estado_Solicitud(E/S:Prof:Docente);
Inicio
    Si (Prof.Cant_Solicitudes = 0) Entonces;
        Mostrar<<"No hay solicitudes registradas.";
    Sino
        Var i: Entero;
        Mostrar<<"=== Solicitudes ===";
        Para (i = 1 Hasta i = Prof.Cant_Solicitudes) Hacer;
            Mostrar << "ID: ", Prof.Solicitudes[i].ID_Solicitud, " | Tipo: ", Prof.Solicitudes[i].Tipo, " | Estado: ", Prof.Solicitudes[i].Estado;
        Fin_Para
        Mostrar << "Ingrese el ID de la solicitud a actualizar:";
        Var id: Entero, pos: Entero; pos = 0;
        Leer >> id;
        Para (i = 1 Hasta i = Prof.Cant_Solicitudes) Hacer;
            Si (Prof.Solicitudes[i].ID_Solicitud = id) Entonces;
                pos = i;
            Fin_Si
        Fin_Para
        Si (pos = 0) Entonces;
            Mostrar<<"ID no encontrado.";
        Sino
            Mostrar<<"Nuevo estado (Pendiente, Procesada, Rechazada):";
            Var nuevo: Cadena;
            Leer >> nuevo;
            Prof.Solicitudes[pos].Estado = nuevo;
            Mostrar << "Estado actualizado.";
        Fin_Si
    Fin_Si
Fin_Procedimiento