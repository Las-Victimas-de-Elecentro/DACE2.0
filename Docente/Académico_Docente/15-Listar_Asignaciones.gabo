Procedimiento Listar_Asignaciones(E: Prof:Docente);
Inicio
    Var i: Entero;
    Mostrar << "=== Mis Asignaciones ===";
    Si (As = 0) Entonces;
        Mostrar << "Aún no tiene asignaciones.";
    Sino
        Para (i = 1 Hasta i = As) Hacer;
            Si (Prof[pos].Nombre = Asig[i].Nombre_Profesor) Entonces;
                Mostrar << " | Título: ", Asig[i].Titulo, " | Materia: ", Asig[i].Codigo_Materia, " | Estado: ", Asig[i].Estado, " | Entrega: ", Asig[i].Fecha_Entrega;
            Fin_Si
        Fin_Para
    Fin_Si
    Mostrar << "=========================";
Fin_Procedimiento