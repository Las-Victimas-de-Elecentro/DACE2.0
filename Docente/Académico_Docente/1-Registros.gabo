//   SISTEMA DACE - SECCIÓN DOCENTE ACADÉMICA ==============================================================
// ==========================
//   REGISTROS
// ==========================
Registro: Materia;  //Materia;
    Codigo: Cadena;
    Nombre: Cadena;
    Creditos: Entero;
Fin_Registro

Registro: Bloque_Horario;   //Lista[8]/Horario[40];
    ID_Bloque: Entero;
    Dia: Cadena;           // Lunes, Martes, etc.;
    Hora_Inicio: Cadena;   // "08:00";
    Hora_Fin: Cadena;      // "10:00";
    Aula: Cadena;          // "A-101";
    Codigo_Materia: Cadena; // Vacío si no asignado;
    Estado: Cadena;        // "Libre" o "Ocupado";
Fin_Registro

Registro: Lista;
    Nombre: Cadena;
    Cedula: Entero;
Fin_Registro

Registro: Clase;            //Llave: Clase;
    Nombre_Profesor: Cadena;
    CI_Profesor: Entero;
    Codigo_Materia: Cadena;
    Nombre_Materia: Cadena;
    Periodo: Cadena;
    Dia: Cadena;
    Hora_Inicio: Cadena;
    Hora_Fin: Cadena;
    Aula: Entero;
    Seccion: Entero;            // 1, 2, 3;
    Lista;          //Lista[50] (Nombre y Cédula de cada estudiante);
    Cant_Estudiantes: Entero;
Fin_Registro

Registro: Asignacion;   //Llave: Asig;
    Nombre_Profesor: Cadena;
    Codigo_Materia: Cadena;
    Titulo: Cadena;
    Descripcion: Cadena;
    Fecha_Publicacion: Cadena;
    Fecha_Entrega: Cadena;
    Estado: Cadena;            // "Borrador", "Publicada", "Cerrada";
Fin_Registro

Registro: Docente;      //Docente: Prof;
    Nombre: Cadena;
    Cedula: Entero;
    Gmail: Cadena;
    Password: Cadena;
    Tarjeta: Entero;
    Materias: Cadena;
    Cant_Materias: Entero;
    Cant_Clases: Entero;
    Club: Cadena;
    Amigos: Entero;
Fin_Registro

Registro: Grupos;           //Llave: Gru;
    Nombre_Profesor: Cadena;
    CI_Profesor: Entero;
    Codigo_Materia: Cadena;
    Materia: Cadena;
    Miembros: Entero;
    Seccion: Entero;
Fin_Registro

Registro: Amigos;       //Llave: Amig;
    Nombre_Emisor: Cadena;
    CI_Emisor: Entero;
    Nombre_Receptor: Cadena;
    CI_Receptor: Entero;
    Avatar_Receptor: Cadena;
Fin_Registro

Registro: Bloques_Base;     //Base;
    Lista: Arreglo[1..48] de Bloque_Horario; // 6 días * 8 bloques;
    Cant: Entero;
Fin_Registro