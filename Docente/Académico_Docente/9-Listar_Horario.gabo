Procedimiento Listar_Horario(E: Prof:Docente);
Inicio
    Mostrar << "=== Mi Horario Académico ===";
    Var i: Entero;
    Si (Prof[i].Cant_Materias = 0) Entonces;
        Mostrar << "Aún no tiene bloques asignados.";
    Sino
        Para (i = 1 Hasta i = 1000) Hacer;
            Si (Prof[pos].Nombre = Clase[i].Nombre_Profesor) Entonces;
                Mostrar << "[", i, "] ", Clase[i].Dia, " ", Clase[i].Hora_Inicio, "-", Clase[i].Hora_Fin, " | Aula: ", Clase[i].Aula, " | Materia: ", Clase[i].Nombre_Materia, " | Código Materia: ", Clase[i].Codigo_Materia, " | Sección: ", Clases[i].Seccion, " | Inscritos: ", Clases[i].Cant_Estudiantes;;
            Fin_Si
        Fin_Para
    Fin_Si
    Mostrar << "============================";
Fin_Procedimiento