Procedimiento Validar_Choque_Bloque(E/S: Prof[pos].Nombre, Clase[i].Nombre_Profesor, Clase[i].Dia, Clase[i].Hora_Inicio, Clase[i].Hora_Fin, Base.Lista[i].Hora_Inicio, Base.Lista[i].Hora_Fin, Base.Lista[i].Dia: Cadena, es_valido: Booleano);
Inicio
    // Valida que el docente no tenga otro bloque en el mismo día y rango
    es_valido = 1;
    Var i: Entero;
    Var cant: Entero;
    Para (i = 1 Hasta i = 500) Hacer;
        Si (Clase[i].Nombre_Profesor = Prof[pos].Nombre) Entonces;
            Si (Clase[i].Dia = Base.Lista[i].Dia) Entonces;
                // Simplificación: si coincide hora de inicio o fin, consideramos choque
                Si (Clase[i].Hora_Inicio = Base.Lista[i].Hora_Inicio) Entonces;
                    cant = cant + 1;
                Fin_Si
                Si (Clase[i].Hora_Fin = Base.Lista[i].Hora_Fin) Entonces;
                    cant = cant + 1;
                Fin_Si
            Fin_Si
            Si (Cant > 1) Entonces;
                es_valido = 0;
            Fin_Si
        Fin_Si
    Fin_Para
Fin_Procedimiento