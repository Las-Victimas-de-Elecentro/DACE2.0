Procedimiento Mostrar_Novedades(E/S: Nov[I].Hecho, Nov[I].Fecha, Nov[I].Responsables, Nov[I].Contexto, Nov[I].Lugar: Cadena);
Inicio
    Var R: Booleano;
    Var I: Entero;
    Mostrar << "¡Bienvenido a la sección de Novedades!";
    Mostrar << "¿Desea ver las novedades actuales? 1: Sí, 0: No";
    Leer >> R;
    Si (R = 1) Entonces;
        Para (I = 1 Hasta I = 500) Hacer;
            Mostrar << Nov[I].Hecho;
            Mostrar << Nov[I].Fecha;
            Mostrar << Nov[I].Responsables;
            Mostrar << Nov[I].Contexto;
            Mostrar << Nov[I].Lugar;
        Fin_Para
    Sino
        Mostrar << "Vuelva pronto.";
    Fin_Si
Fin_Procedimiento