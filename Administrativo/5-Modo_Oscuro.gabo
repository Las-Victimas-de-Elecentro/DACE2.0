Procedimiento Modo_Oscuro (E/S: Tema: Booleano);
Inicio
    var Opc, R: Booleano; 
    Repetir
        Mostrar << "Gestión de modo oscuro";
        Mostrar << "Aquí puedes cambiar la apariencia visual";
        Si (Tema = 0) Entonces;
            Mostrar << "El Modo Claro está Activado. ¿Desea desactivarlo? Ingrese 1:Sí / 0:No";
            Leer >> Opc;
            Mientras (Opc < 0 Or Opc > 1) Hacer;
                Mostrar << "Ingrese solo opciones entre 0-1";
                Leer >> Opc;
            Fin_Mientras
            Si (Opc = 1) Entonces;
                Tema = 1;
                Mostrar << "Modo Oscuro activado.";
            Fin_Si
        Sino
            Mostrar << "El Modo Oscuro está Activado. ¿Desea activar el Modo Oscuro? Ingrese 1:Sí / 0:No)";
            Leer >> Opc;
            Mientras (Opc < 0 Or Opc > 1) Hacer;
                Mostrar << "Ingrese solo opciones entre 0-1";
                Leer >> Opc;
            Fin_Mientras
            Si (Opc = 0) Entonces;
                Tema = 0;
                Mostrar << "Modo Claro activado.";
            Fin_Si
        Fin_Si
        Mostrar << "¿Quiere cambiar de tema nuevamente? Ingrese 1:Sí / 0:No";
        Leer >> R;
        Hasta(R = 0);
    Fin_Repetir
    
Fin_Procedimiento