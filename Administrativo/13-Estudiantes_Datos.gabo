Procedimiento Estudiantes_Datos(E/S: I, C: Entero, Datos[I].Usuario: Cadena, Datos.ID[I]: cadena,  Datos.CI[I]: Entero,  Datos[I].Password: Cadena, Datos[I].Edad: Entero, Datos[I].Carrera: Cadena, Datos.Year.Semestre[I]:Entero);
Inicio
	Var C = 1, Es: Entero;
	Var Z: Booleano;
	Var opc2, Apr2: Booleano;
    Repetir
        Mostrar << "Ingrese el nombre del estudiante";
        Leer >> Datos[C].Usuario;
        Mostrar << "Ingrese la ID del estudiante";
        Leer >> Datos[C].ID;
        Mostrar << "Ingrese la cédula del estudiante";
        Leer >> Datos[C].CI;
        Mostrar << "Ingrese la contraseña";
        Leer >> Datos[C].Password;
        Mostrar << "Ingrese la edad";
        Leer >> Datos[C].Edad;
        Mientras (Datos[C].Edad < 17 or Datos[C].Edad > 100) Hacer;
            Mostrar << "Solo positivos";
            Leer >> Datos[C].Edad;
        Fin_Mientras
        Mostrar << "Ingrese la carrera del estudiante";
        Leer >> Datos[C].Carrera;
        Mostrar << "Ingrese el semestre del estudiante";
        Leer >> Datos[C].Yea.Semestre;
        Mostrar << "¿Desea verificar otra inscripción estudiantil? 1:Sí, 0: No";
        Leer >> Z;
        C= C + 1;
        Hasta(Z = 0 or C= 500);
    Fin_Repetir
    Mostrar << "¿Desea revisar las inscripciones estudiantiles en cuanto a los requisitos a cumplir? 1: Sí, 0: No";
    Leer >> opc2;
    Si (opc2 = 1) Entonces;
        Mostrar << "¿Cuántas desea revisar para verificar si deben ser inscritos o no?";
        Leer >> Es;
        Mientras (Es < 1 or Es > C) Hacer;
            Mostrar << "Solo positivos o es mayor a la base de datos";                                  		Leer>>Es;
        Fin_Mientras
        Para (I = 1 Hasta I = Es) Hacer;
            Mostrar << Datos[I].Usuario;
            Mostrar << Datos[I].ID;
            Mostrar << Datos[I].CI;
            Mostrar << Datos[I].Password;
            Mostrar << Datos[I].Edad;
            Mostrar << Datos[I].Carrera;
            Mostrar << Datos[I].Yea.Semestre;
            Mostrar << "¿Desea inscribir al estudiante? 1: Sï, 0: No";
            Leer >> Apr2;
            Datos[I].Estado = Apr2;
        Fin_Para
    Sino
        Mostrar<<"Continúe su camino entre el programa estudiantil";
    Fin_Si
    Para (I = 1 Hasta I = C) Hacer;
        Si (Datos.Estado[I] = 0) Entonces;
            Datos[I].Usuario = " ";
            Datos[I].ID = " ";
            Datos[I].CI = null;
            Datos[I].Password = " ";
            Datos[I].Edad = null;
            Datos[I].Carrera= " ";
            Datos[I].Yea.Semestre= " ";
        Fin_Si
    Fin_Para
Fin_Procedimiento