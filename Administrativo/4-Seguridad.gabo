Procedimiento Seguridad(E/S: Admin[I].Password, Admin[I].Usuario, Admin[I].Cargo, Admin[I].Gmail: Cadena);
Inicio
    Var opc, op: Entero;
    Var contra, contraNueva, cargo, user: Cadena;
    Var R, Re: Booleano;
    Repetir
        Mostrar << "¡Bienvenido al apartado de Seguridad!";
        Mostrar << "¿Qué desea hacer?";
        Mostrar << "1. Cambiar su contraseña";
        Mostrar << "2. Actualizar sus datos";
        Leer >> opc;
        Mientras (opc != 1 or opc != 2) Hacer;
            Mostrar << "Es invalido";
            Leer >> opc;
        Fin_Mientras
        Si (opc = 1) Entonces;
            Mostrar << "Ingrese su contraseña actual: ";
            Leer >> contra;
            Si (contra = Admin[pos_admin].Password) Entonces;
                Mostrar << "Perfecto, ahora ingrese su nueva contraseña: ";
                Leer >> contraNueva;
                Mostrar << "¿Está seguro de que quiere que esa sea su nueva contraseña? 1: Sí, 0: No";
                Leer >> Re;
                Si (Re = 1) Entonces;
                    Admin[pos_admin].Password = contraNueva;
                Sino
                    Mostrar << "Vuelva pronto.";
                Fin_Si
            Fin_Si
        Sino
            Mostrar << "Eligió actualizar sus datos. Perfecto.";
            Mostrar << "¿Qué desea actualizar?";
            Mostrar << "1. Usuario";
            Mostrar << "2. Cargo";
            Mostrar << "3. Gmail";
            Leer >> op;
            Mientras (op < 1 or op > 3) Hacer;
                Mostrar << "Es invalido, intente nuevamente";
                Leer >> op;
            Fin_Mientras
            En_Caso (op > 0) Sea;
                Caso(op = 1);
                    Mostrar << "Su usuario actual: ";
                    Mostrar << Admin[pos_admin].Usuario;
                    Mostrar << "Ingrese su nuevo usuario";
                    Leer >> user;
                    Mostrar << "¿Es correcto lo que escribió? 1: Sí, 0: No";
                    Leer >> Re;
                    Si (Re = 1) Entonces;
                        Admin[pos_admin].Usuario = user;
                    Sino
                        Mostrar << "Dato cargado correctamente";
                        Mostrar << "Vuelva pronto";
                    Fin_Si
                Caso(op = 2);
                    Mostrar << "Su cargo actual: ";
                    Mostrar << Admin[pos_admin].Cargo;
                    Mostrar << "Ingrese su nuevo cargo";
                    Leer >> cargo;
                    Mostrar << "¿Es correcto el cargo? 1: Sí, 0: No";
                    Leer >> Re;
                    Si (Re = 1) Entonces;
                        Admin[pos_admin].Cargo = cargo;
                        Mostrar << "Dato cargado correctamente.";
                    Sino
                        Mostrar << "Vuelva pronto";
                    Fin_Si
                Otro_Caso
                    Mostrar << "Dirección de correo electrónico actual: ";
                    Mostrar << Admin[pos_admin].Gmail;
                    Mostrar << "Ingrese su dirección de correo electrónico nuevo";
                    Leer >> gmail;
                    Mostrar << "¿Es correcto el correo electrónico? 1: Sí, 0: No";
                    Leer >> Re;
                    Si (Re = 1) Entonces;
                        Admin[pos_admin].Gmail = gmail;
                        Mostrar << "Dato cargado correctamente.";
                    Sino
                        Mostrar << "Vuelva pronto";
                    Fin_Si
            Fin_Caso
        Fin_Si
        Mostrar << "¿Desea salir de este menú? 1: Sí, 0: No";
        Leer >> R;
        Hasta(R = 1);
    Fin_Repetir
Fin_Procedimiento